{
  "name": "yai-translator",
  "private": true,
  "version": "0.9.2",
  "type": "module",
  "description": "YAi Translator — онлайн-переводчик, словарь и учебник немецкого",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788",
    "icons": "node scripts/render-icons.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.functions.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && wrangler pages dev dist --port 8788",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "i18next": "^26.5.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.156.0"
  }
}
