{"ягнёнка":[{"id":3503673,"text":"Волк убил ягнёнка.","tr":{"en":"The wolf killed the lamb.","de":"Der Wolf tötete das Lamm.","uk":"Вовк убив ягня."}},{"id":3503673,"text":"Волк убил ягнёнка.","tr":{"en":"The lamb was killed by the wolf.","de":"Das Lamm wurde von dem Wolf gerissen."}}],"ягоды":[{"id":5873469,"text":"Ягоды можно заморозить.","tr":{"en":"Berries can be frozen.","de":"Beeren kann man einfrieren.","uk":"Ягоди можна заморозити."}},{"id":6620282,"text":"Том и Мэри собирали в лесу ягоды.","tr":{"en":"Tom and Mary picked some berries in the forest.","de":"Tom und Maria pflückten Beeren im Wald."}},{"id":13403405,"text":"Эти ягоды съедобны?","tr":{"en":"Are these berries edible?"}},{"id":4421700,"text":"Ягоды богаты минералами, такими как калий.","tr":{"en":"Berries are rich in minerals such as potassium."}}],"ягод":[{"id":6579204,"text":"Я тебе ягод принёс.","tr":{"en":"I brought you some berries.","de":"Ich habe dir Beeren mitgebracht."}},{"id":5214580,"text":"Я люблю сок из ягод бузины.","tr":{"en":"I love elderberry juice.","de":"Ich trinke gern Holundersaft."}},{"id":8101770,"text":"Племя занималось поиском ягод.","tr":{"en":"The tribe foraged for berries.","de":"Der Stamm sammelte Beeren."}}],"ягоду":[{"id":13403545,"text":"Эту ягоду можно есть.","tr":{"en":"This berry is good to eat.","de":"Diese Beere kann man essen."}}],"ягнята":[{"id":4559487,"text":"Ягнята - это детёныши овец.","tr":{"en":"Lambs are baby sheep.","de":"Lämmer sind kleine Schafe."}},{"id":424331,"text":"Ягнята были забиты для продажи на рынке.","tr":{"en":"The lambs were slaughtered for market."}}],"ягуара":[{"id":4103021,"text":"Я убил ягуара.","tr":{"en":"I killed a jaguar."}}],"ягнят":[{"id":10762262,"text":"Ягнят загрыз волк.","tr":{"en":"The lambs were killed by a wolf."}}],"ягненок":[{"id":4128756,"text":"Ягненок был отлично приготовлен.","tr":{"en":"The lamb was cooked perfectly."}}]}