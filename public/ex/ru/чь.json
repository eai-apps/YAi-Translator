{"чьё":[{"id":1558007,"text":"Чьё это?","tr":{"en":"Whose is this?","de":"Wem gehört das?","uk":"Чиє це?"}},{"id":4021445,"text":"Чьё это пиво?","tr":{"en":"Whose beer is this?","de":"Wessen Bier ist das?","uk":"Чиє це пиво?"}},{"id":3510441,"text":"Чьё это вино?","tr":{"en":"Whose wine is this?","de":"Wessen Wein ist das?","uk":"Чиє це вино?"}},{"id":2838973,"text":"Ты знаешь, чьё это?","tr":{"en":"Do you know whose this is?","de":"Weißt du, wem das hier gehört?","uk":"Ти знаєш, кому це належить?"}},{"id":1558007,"text":"Чьё это?","tr":{"en":"Whose is it?","uk":"Чиє це?"}}],"чьи":[{"id":3683575,"text":"Чьи это часы?","tr":{"en":"Whose clock is it?","de":"Wem gehört die Uhr?","uk":"Чий це годинник?"}},{"id":1464508,"text":"Чьи это ручки?","tr":{"en":"Whose pens are these?","de":"Wem gehören diese Stifte?","uk":"Чиї це ручки?"}},{"id":890126,"text":"Чьи это книги?","tr":{"en":"Whose books are these?","de":"Wessen Bücher sind das?","uk":"Чиї це книжки?"}},{"id":890126,"text":"Чьи это книги?","tr":{"en":"Whose books are those?","de":"Wessen Bücher sind das?","uk":"Чиї то книжки?"}},{"id":3962014,"text":"Чьи это игрушки?","tr":{"en":"Whose toys are these?","de":"Wem gehören diese Spielzeuge hier?","uk":"Чиї це іграшки?"}}],"чья":[{"id":2531413,"text":"Чья это вина?","tr":{"en":"Whose fault is that?","de":"Wessen Schuld ist das?","uk":"Чия це провина?"}},{"id":592655,"text":"Чья это книга?","tr":{"en":"Whose book is it?","de":"Wessen Buch ist das?","uk":"Чия це книжка?"}},{"id":652743,"text":"Чья это сумка?","tr":{"en":"Whose bag is this?","de":"Wem gehört diese Tasche?","uk":"Чия це сумка?"}},{"id":592655,"text":"Чья это книга?","tr":{"en":"Whose book is that?","de":"Wessen Buch ist das?","uk":"Чия це книжка?"}},{"id":592655,"text":"Чья это книга?","tr":{"en":"Whose book is this?","de":"Wessen Buch ist das?","uk":"Чия це книжка?"}}],"чьей":[{"id":3456085,"text":"На чьей ты стороне?","tr":{"en":"Whose side are you on?","de":"Auf wessen Seite stehst du?","uk":"Ти на чиєму