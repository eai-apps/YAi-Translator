{"ржавеет":[{"id":2495107,"text":"Мой французский ржавеет.","tr":{"en":"My French is getting rusty.","de":"Mein Französisch rostet ein.","uk":"Я поволі забуваю французьку."}},{"id":4456776,"text":"Стекловолокно не ржавеет.","tr":{"en":"Fiberglass doesn't rust."}},{"id":7371432,"text":"Нержавеющая сталь не ржавеет.","tr":{"en":"Stainless steel doesn't rust."}}],"ржать":[{"id":8774006,"text":"Хватит ржать.","tr":{"en":"Quit laughing.","uk":"Годі вже сміятися."}},{"id":8774006,"text":"Хватит ржать.","tr":{"en":"Quit your laughing."}},{"id":4922681,"text":"Хватит ржать, не смешно!","tr":{"en":"Stop laughing. It's not funny."}}],"ржаная":[{"id":2649879,"text":"Почём ржаная мука?","tr":{"en":"How much is rye flour?","de":"Wie viel kostet Roggenmehl?"}},{"id":8318962,"text":"Сколько стоит ржаная мука?","tr":{"en":"How much does rye flour cost?","de":"Wie viel kostet Roggenmehl?"}}],"ржавчиной":[{"id":2985488,"text":"Эти ножи покрыты ржавчиной.","tr":{"en":"The knives are covered with rust.","de":"Die Messer sind ganz verrostet."}},{"id":1463834,"text":"Лестница была покрыта пылью и ржавчиной.","tr":{"en":"The ladder was covered with dust and rust."}}],"ржавым":[{"id":1574364,"text":"Том отрубил ногу Мэри ржавым мачете.","tr":{"en":"Tom hacked Mary's leg off with a rusty machete.","uk":"Том відрубав ногу Мері іржавим мачете."}}],"ржавый":[{"id":12607090,"text":"Болт ржавый.","tr":{"en":"The bolt is rusty."}},{"id":6771114,"text":"Я нашёл в той комнате старый ржавый ключ.","tr":{"en":"I found an old rusty key in that room."}}],"ржаной":[{"id":10256504,"text":"Том купил ржаной хлеб.","tr":{"en":"Tom bought rye bread."}}]}