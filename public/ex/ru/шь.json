{"шьёт":[{"id":2341977,"text":"Она шьёт платье.","tr":{"en":"She is sewing a dress.","de":"Sie näht ein Kleid.","uk":"Вона шиє плаття."}},{"id":1049322,"text":"Она очень хорошо шьёт.","tr":{"en":"She can sew very well.","de":"Sie kann sehr gut nähen.","uk":"Вона вміє добре шити."}},{"id":6289790,"text":"Мэри сама шьёт одежду.","tr":{"en":"Mary makes her own clothes.","de":"Maria macht ihre Kleider selbst."}},{"id":5424673,"text":"Мэри очень хорошо шьёт.","tr":{"en":"Mary can sew very well.","de":"Maria kann sehr gut nähen."}},{"id":1941621,"text":"Она шьёт иголкой и ниткой.","tr":{"en":"She sews with a needle and thread.","de":"Sie näht mit Nadel und Faden."}}],"шьёшь":[{"id":423757,"text":"Ты очень хорошо шьёшь.","tr":{"en":"You're very good at sewing.","de":"Du bist sehr gut im Nähen.","uk":"Ти дуже гарно шиєш."}},{"id":11920903,"text":"Ты что-то шьёшь?","tr":{"en":"Are you sewing?"}}]}