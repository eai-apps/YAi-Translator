{"яйца":[{"id":3289095,"text":"Я хочу яйца.","tr":{"en":"I want eggs.","de":"Ich will Eier.","uk":"Мені потрібні яйця."}},{"id":3461099,"text":"Мы ели яйца.","tr":{"en":"We ate eggs.","de":"Wir haben Eier gegessen.","uk":"Ми їли яйця."}},{"id":6718122,"text":"Ты ешь яйца?","tr":{"en":"Do you eat eggs?","de":"Isst du Eier?","uk":"Ти їси яйця?"}},{"id":3461099,"text":"Мы ели яйца.","tr":{"en":"We were eating eggs.","de":"Wir haben Eier gegessen.","uk":"Ми їли яйця."}},{"id":4557744,"text":"Взбейте яйца.","tr":{"en":"Beat the eggs.","de":"Schlag die Eier.","uk":"Взбий яйця."}}],"яйцо":[{"id":2073162,"text":"Похоже на яйцо.","tr":{"en":"It looks like an egg.","de":"Das sieht wie ein Ei aus.","uk":"Це схоже на яйце."}},{"id":2596154,"text":"Пожарь мне яйцо.","tr":{"en":"Fry an egg for me.","de":"Brat mir ein Ei.","uk":"Підсмаж мені яйце."}},{"id":1828073,"text":"Это яйцо свежее.","tr":{"en":"This egg is fresh.","de":"Dieses Ei ist frisch.","uk":"Це яйце свіже."}},{"id":2754522,"text":"Фома варит яйцо.","tr":{"en":"Tom is boiling an egg.","de":"Tom kocht ein Ei.","uk":"Том варить яйце."}},{"id":2734343,"text":"У меня есть яйцо.","tr":{"en":"I have an egg.","de":"Ich habe ein Ei.","uk":"У мене є яйце."}}],"яйцами":[{"id":3198319,"text":"Она убежала с яйцами.","tr":{"en":"She ran away with the eggs.","de":"Sie rannte mit den Eiern weg."}},{"id":8259857,"text":"Том поехал в супермаркет за молоком и яйцами.","tr":{"en":"Tom drove to the supermarket to buy some milk and eggs."}},{"id":11834920,"text":"Протестующие забросали полицию тухлыми яйцами.","tr":{"en":"The protesters threw rotten eggs at the police."}},{"id":5508947,"text":"Том хотел, чтобы я сходил в супермаркет за хлебом и яйцами.","tr":{"en":"Tom wanted me to go to the supermarket to buy some bread and eggs."}}],"яйцом":[{"id":4067834,"text":"Том бросил в Мэри тухлым яйцом.","tr":{"en":"Tom threw a rotten egg at Mary.","de":"Tom warf ein faules Ei nach Maria."}},{"id":6976932,"text":"Мария сделала несколько сэндвичей с яйцом.","tr":{"en":"Mary made some egg sandwiches."}}]}