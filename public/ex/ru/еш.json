{"ешь":[{"id":3572464,"text":"Ешь всё.","tr":{"en":"Eat everything.","de":"Iss alles.","uk":"Їж все."}},{"id":1445992,"text":"Ешь и пей.","tr":{"en":"Eat and drink.","de":"Esst und trinkt.","uk":"Їж та пий."}},{"id":6718122,"text":"Ты ешь яйца?","tr":{"en":"Do you eat eggs?","de":"Isst du Eier?","uk":"Ти їси яйця?"}},{"id":4143851,"text":"Ты ешь рыбу?","tr":{"en":"Do you eat fish?","de":"Esst ihr Fisch?","uk":"Ви їсте рибу?"}},{"id":5071654,"text":"Ты много ешь?","tr":{"en":"Do you eat a lot?","de":"Isst du viel?","uk":"Ти багато їж?"}}],"ешьте":[{"id":544837,"text":"Ешьте больше овощей.","tr":{"en":"Eat more vegetables.","de":"Esst mehr Gemüse.","uk":"Їж більше овочей."}},{"id":7911712,"text":"Ешьте овощи!","tr":{"en":"Eat your vegetables.","de":"Iss dein Gemüse!"}},{"id":10256492,"text":"Ешьте этот хлеб.","tr":{"en":"Eat this bread.","de":"Iss dieses Brot."}},{"id":2929408,"text":"Не ешьте устриц.","tr":{"en":"Don't eat the oysters.","de":"Essen Sie die Austern nicht."}},{"id":7814827,"text":"Ешьте где хотите.","tr":{"en":"Eat wherever you want to.","de":"Iss, wo du möchtest!"}}]}