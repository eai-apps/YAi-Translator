{"её":[{"id":650432,"text":"Я люблю её.","tr":{"en":"I love her.","de":"Ich liebe sie.","uk":"Я кохаю її."}},{"id":4551084,"text":"Её там нет.","tr":{"en":"It's not there.","de":"Es ist nicht da.","uk":"Її там немає."}},{"id":412482,"text":"Он её друг.","tr":{"en":"He is her friend.","de":"Er ist ihr Freund.","uk":"Він її друг."}},{"id":658867,"text":"Не буди её.","tr":{"en":"Don't wake her up.","de":"Weck sie nicht.","uk":"Не буди її."}},{"id":902286,"text":"Это её дом.","tr":{"en":"That is her house.","de":"Das ist ihr Haus.","uk":"Це її будинок."}}]}