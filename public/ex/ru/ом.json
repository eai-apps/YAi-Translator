{"омерзителен":[{"id":3308642,"text":"Том омерзителен.","tr":{"en":"Tom is hideous.","de":"Tom ist abscheulich.","uk":"Том огидний."}},{"id":3308642,"text":"Том омерзителен.","tr":{"en":"Tom's repulsive.","de":"Tom ist abstoßend.","uk":"Том огидний."}},{"id":3308642,"text":"Том омерзителен.","tr":{"en":"Tom is disgusting.","de":"Tom ist widerlich.","uk":"Том огидний."}},{"id":6191163,"text":"Ты омерзителен.","tr":{"en":"You're hideous."}},{"id":2596550,"text":"Не подходи ко мне. Ты омерзителен.","tr":{"en":"Don't come near me. You're filthy."}}],"омлет":[{"id":5332657,"text":"Том сделал омлет.","tr":{"en":"Tom made an omelet.","de":"Tom machte ein Omelette.","uk":"Том зробив омлет."}},{"id":5332657,"text":"Том сделал омлет.","tr":{"en":"Tom made an omelette.","de":"Tom machte ein Omelette.","uk":"Том зробив омлет."}},{"id":4094869,"text":"Ты можешь приготовить омлет?","tr":{"en":"Can you cook an omelet?","de":"Kannst du ein Omelett zubereiten?"}},{"id":4094869,"text":"Ты можешь приготовить омлет?","tr":{"en":"Can you make an omelet?","de":"Kannst du ein Omelett zubereiten?"}},{"id":4094869,"text":"Ты можешь приготовить омлет?","tr":{"en":"Can you cook an omelette?","de":"Kannst du ein Omelett zubereiten?"}}],"омуте":[{"id":635978,"text":"В тихом омуте черти водятся.","tr":{"en":"Still waters run deep.","de":"Stille Wasser sind tief.","uk":"Тиха вода греблю рве."}}],"омары":[{"id":7116505,"text":"Мне нравятся омары.","tr":{"en":"I like lobster.","uk":"Я люблю омари."}}],"омерзительно":[{"id":6191164,"text":"Выглядит омерзительно.","tr":{"en":"It looks hideous.","de":"Es sieht scheußlich aus."}}],"омерзительной":[{"id":1306769,"text":"Том счёл Мэри омерзительной.","tr":{"en":"Tom found Mary repulsive.","uk":"Мері здалася Тому огидною."}}],"омаров":[{"id":4165440,"text":"Я очень редко ем омаров.","tr":{"en":"I very seldom eat lobster."}}],"омелой":[{"id":4656394,"text":"Я поцеловала его под омелой.","tr":{"en":"I kissed him under the mistletoe."}},{"id":11371562,"text":"Том и Мэри целовались под омелой.","tr":{"en":"Tom and Mary kissed under the mistletoe."}},{"id":5732142,"text":"Я воспользовался омелой как предлогом, чтобы его поцеловать.","tr":{"en":"I used the mistletoe as an excuse to kiss him."}}],"омара":[{"id":11243236,"text":"Я не хочу есть живого омара.","tr":{"en":"I don't want to eat a live lobster."}},{"id":2039395,"text":"Вы знаете, как приготовить омара?","tr":{"en":"Do you know how to cook a lobster?"}}],"омар":[{"id":8445619,"text":"Как сказать «омар» по-французски?","tr":{"en":"How do you say lobster in French?"}}],"омарами":[{"id":1581819,"text":"Мы объедались омарами и прочими дарами моря.","tr":{"en":"We glutted ourselves with lobsters and other seafood."}}],"омрачает":[{"id":6792786,"text":"Мою радость омрачает мысль, что Том не с нами.","tr":{"en":"My happiness is overshadowed by the thought that Tom is not with us."}}]}