{"их":[{"id":6760276,"text":"Убей их.","tr":{"en":"Kill them.","de":"Töte sie!","uk":"Вбий їх."}},{"id":4934926,"text":"Храни их.","tr":{"en":"Keep them.","de":"Behalte sie.","uk":"Залиш їх собі."}},{"id":6983639,"text":"Изучи их.","tr":{"en":"Examine them.","de":"Untersuch sie.","uk":"Перевір їх."}},{"id":3927609,"text":"Спроси их.","tr":{"en":"Ask them.","de":"Frag sie.","uk":"Запитай їх."}},{"id":6764866,"text":"Я их хочу.","tr":{"en":"I want them.","de":"Ich will sie.","uk":"Я хочу їх."}}]}