{"сзади":[{"id":4478281,"text":"Враг напал сзади.","tr":{"en":"The enemy attacked from behind.","de":"Der Feind griff von hinten an.","uk":"Ворог напав ззаду."}},{"id":8923012,"text":"Я сидел сзади.","tr":{"en":"I sat in the back.","de":"Ich hab hinten gesessen."}},{"id":8595922,"text":"Мы сидели сзади.","tr":{"en":"We sat in the back.","de":"Wir saßen hinten."}},{"id":5966158,"text":"Давай сядем сзади.","tr":{"en":"Let's sit in the back.","de":"Setzen wir uns nach hinten."}},{"id":8596863,"text":"Можно я сяду сзади?","tr":{"en":"May I sit in the back?","de":"Darf ich hinten sitzen?"}}]}