{"лжец":[{"id":3668946,"text":"Он лжец.","tr":{"en":"He's a liar.","de":"Er ist ein Lügner.","uk":"Він брехун."}},{"id":2570607,"text":"Я не лжец.","tr":{"en":"I'm no liar.","de":"Ich bin kein Lügner.","uk":"Я не брехун."}},{"id":4283944,"text":"Том не лжец.","tr":{"en":"Tom is no liar.","de":"Tom ist kein Lügner.","uk":"Том не брехун."}},{"id":4283944,"text":"Том не лжец.","tr":{"en":"Tom is not a liar.","de":"Tom ist kein Lügner.","uk":"Том не брехун."}},{"id":4960263,"text":"Я думаю, что ты лжец.","tr":{"en":"I think you're a liar.","de":"Ich glaube, du bist ein Lügner.","uk":"Мені здається, ти брехун."}}],"лжет":[{"id":2698436,"text":"Том лжет.","tr":{"en":"Tom lies.","de":"Tom lügt.","uk":"Том бреше."}},{"id":2698436,"text":"Том лжет.","tr":{"en":"Tom's lying.","de":"Tom lügt.","uk":"Том бреше."}},{"id":2698436,"text":"Том лжет.","tr":{"en":"Tom is lying.","de":"Tom lügt.","uk":"Том бреше."}},{"id":2041199,"text":"Я думаю, Том лжет.","tr":{"en":"I think Tom is lying.","de":"Ich denke, dass Tom lügt.","uk":"Гадаю, Том бреше."}},{"id":5773453,"text":"Том считал, что Мэри лжет.","tr":{"en":"Tom thought Mary was lying."}}],"лжёте":[{"id":2005585,"text":"Вы лжёте!","tr":{"en":"You're lying!","de":"Du lügst!","uk":"Ти брешеш!"}},{"id":1927873,"text":"Вы лжёте мне.","tr":{"en":"You're lying to me.","de":"Du lügst mich an."}},{"id":8956619,"text":"Вы часто лжёте своему мужу?","tr":{"en":"Do you often lie to your husband?"}},{"id":5284046,"text":"У меня есть основания полагать, что вы лжёте.","tr":{"en":"I have reason to believe you're lying."}},{"id":5284046,"text":"У меня есть основания полагать, что вы лжёте.","tr":{"en":"I have reason to believe that you're lying."}}],"лжём":[{"id":5388684,"text":"Все мы лжём.","tr":{"en":"We all lie.","de":"Wir lügen alle.","uk":"Ми всі брешемо."}}],"лжёт":[{"id":2942081,"text":"Кто-то лжёт.","tr":{"en":"Someone is lying.","de":"Jemand lügt.","uk":"Хтось бреше."}},{"id":2681489,"text":"Фома не лжёт.","tr":{"en":"Tom doesn't lie.","de":"Tom lügt nicht.","uk":"Том не бреше."}},{"id":4324821,"text":"Одна из вас лжёт.","tr":{"en":"One of you is lying.","de":"Einer von euch lügt.","uk":"Один із вас бреше."}},{"id":3167661,"text":"Один из них лжёт.","tr":{"en":"One of them is lying.","de":"Einer von ihnen lügt.","uk":"Один із них бреше."}},{"id":1062924,"text":"Возможно, он лжёт.","tr":{"en":"It is possible that he is telling a lie.","de":"Es ist möglich, dass er lügt.","uk":"Можливо, він бреше."}}],"лжёшь":[{"id":3871775,"text":"Ты опять лжёшь.","tr":{"en":"You're telling lies again.","de":"Du erzählst schon wieder Lügen.","uk":"Ти знову брешеш."}},{"id":2995655,"text":"Не лжёшь ли ты мне?","tr":{"en":"Are you lying to me?","de":"Lügst du mich an?","uk":"Ти мені брешеш?"}},{"id":1927872,"text":"Ты лжёшь мне.","tr":{"en":"You are lying to me.","de":"Du lügst mich an."}},{"id":5214594,"text":"Почему ты мне лжёшь?","tr":{"en":"Why are you lying to me?","de":"Warum lügst du mich an?"}},{"id":2613574,"text":"Я знал, что ты лжёшь.","tr":{"en":"I knew you were lying.","de":"Ich wusste, dass du gelogen hast."}}],"лжецов":[{"id":4170631,"text":"Я ненавижу лжецов.","tr":{"en":"I hate liars.","de":"Ich kann Lügner nicht leiden.","uk":"Ненавиджу брехунів."}},{"id":6017950,"text":"Том ненавидит лжецов.","tr":{"en":"Tom hates liars.","de":"Tom hasst Lügner."}},{"id":5659561,"text":"Том презирает лжецов.","tr":{"en":"Tom despises people who lie.","de":"Tom verachtet Menschen, die lügen."}}],"лжете":[{"id":2831122,"text":"Я думаю, что вы лжете.","tr":{"en":"I think you're lying.","de":"Ich denke, du lügst.","uk":"Гадаю, ти брешеш."}}],"лжецом":[{"id":4938696,"text":"Она назвала его лжецом.","tr":{"en":"She called him a liar.","de":"Sie nannte ihn einen Lügner.","uk":"Вона назвала його брехуном."}},{"id":7419895,"text":"Все назовут меня лжецом.","tr":{"en":"Everyone is going to call me a liar.","de":"Jeder wird mich einen Lügner nennen."}},{"id":956203,"text":"Он дошёл до того, что назвал меня лжецом.","tr":{"en":"He went so far as to call me a liar.","de":"Er ging so weit, mich einen Lügner zu nennen."}},{"id":2999081,"text":"В последнюю нашу встречу Том назвал меня лжецом.","tr":{"en":"The last time we met, Tom called me a liar."}}],"лжи":[{"id":610892,"text":"Она обвинила меня во лжи.","tr":{"en":"She accused me of telling a lie.","de":"Sie bezichtigte mich der Lüge.","uk":"Вона мене звинуватила у брехні."}},{"id":2753927,"text":"Её обвинили во лжи.","tr":{"en":"She was accused of telling a lie.","de":"Ihr wurde vorgeworfen, eine Lüge erzählt zu haben."}},{"id":3869349,"text":"Все поверили его лжи.","tr":{"en":"Everyone believed his lie.","de":"Alle glaubten ihm seine Lüge."}},{"id":4082004,"text":"Том обвинил Мэри во лжи.","tr":{"en":"Tom accused Mary of lying.","de":"Tom bezichtigte Maria der Lüge."}},{"id":3004551,"text":"Ты когда-нибудь проходил тест на детекторе лжи?","tr":{"en":"Have you ever taken a lie detector test?","de":"Hast du dich schon einmal einem Lügendetektortest unterzogen?"}}],"лживая":[{"id":5241483,"text":"Ты лживая свинья.","tr":{"en":"You're a lying pig.","uk":"Ти брехлива свиня."}}],"лжеца":[{"id":9323852,"text":"Они презирали лжеца.","tr":{"en":"They scorned the liar.","de":"Sie verachteten den Lügner."}}],"лжецы":[{"id":1927802,"text":"Все адвокаты - лжецы.","tr":{"en":"All lawyers are liars.","de":"Alle Anwälte sind Lügner."}},{"id":1927802,"text":"Все адвокаты - лжецы.","tr":{"en":"Lawyers are all liars.","de":"Alle Anwälte sind Lügner."}},{"id":3671727,"text":"Лжецы должны иметь хорошую память.","tr":{"en":"Liars must have a good memory.","de":"Lügner müssen ein gutes Gedächtnis haben."}},{"id":2525334,"text":"Вы оба лжецы.","tr":{"en":"You're both liars."}},{"id":3406645,"text":"Они все лжецы.","tr":{"en":"They're all liars."}}],"лженаука":[{"id":11891015,"text":"Астрология — лженаука.","tr":{"en":"Astrology is a pseudoscience.","de":"Astrologie ist eine Pseudowissenschaft."}}],"лжесвидетельствуют":[{"id":4249769,"text":"В суде женщины лжесвидетельствуют чаще мужчин.","tr":{"en":"More women than men commit perjury.","de":"Vor Gericht leisten Frauen öfter einen Meineid als Männer."}}],"лжешь":[{"id":5931567,"text":"Почему ты лжешь Тому?","tr":{"en":"Why are you lying to Tom?"}}],"лжив":[{"id":4167370,"text":"Я думаю, что Том лжив.","tr":{"en":"I think Tom is deceitful."}}],"лжесвидетельстве":[{"id":7956294,"text":"Том был обвинён в лжесвидетельстве.","tr":{"en":"Tom was charged with perjury."}}]}