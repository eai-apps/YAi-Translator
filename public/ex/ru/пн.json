{"пнул":[{"id":4483163,"text":"Он пнул его.","tr":{"en":"He kicked it.","de":"Er hat es getreten.","uk":"Він його копнув."}},{"id":3607742,"text":"Он пнул мяч.","tr":{"en":"He kicked the ball.","de":"Er trat gegen den Ball.","uk":"Він ударив по м'ячу."}},{"id":5895001,"text":"Я пнул мяч.","tr":{"en":"I kicked the ball.","uk":"Я копнув м'яча."}},{"id":6171236,"text":"Том пнул Мэри в живот.","tr":{"en":"Tom kicked Mary in the stomach.","de":"Tom trat Maria in den Bauch."}},{"id":4940026,"text":"Том пнул футбольный мяч.","tr":{"en":"Tom kicked the soccer ball.","de":"Tom trat gegen den Fußball."}}],"пнула":[{"id":1621730,"text":"Она пнула его.","tr":{"en":"She kicked him.","de":"Sie hat ihn getreten.","uk":"Вона вдарила його ногою."}},{"id":444415,"text":"Она пнула дверь.","tr":{"en":"She kicked the door.","de":"Sie trat gegen die Tür.","uk":"Вона вдарила двері ногою."}},{"id":3139142,"text":"Она с силой пнула его.","tr":{"en":"She kicked him hard.","de":"Sie hat ihn arg getreten."}}],"пневмония":[{"id":2553877,"text":"Пневмония вызывает затруднение дыхания.","tr":{"en":"Pneumonia causes difficulty in breathing.","de":"Eine Lungenentzündung verursacht Atembeschwerden.","uk":"Пневмонія викликає ускладнення дихання."}},{"id":4627104,"text":"У меня пневмония.","tr":{"en":"I have pneumonia.","de":"Ich habe eine Lungenentzündung."}}],"пни":[{"id":4840613,"text":"Пни его.","tr":{"en":"Give it a kick.","de":"Tritt mal dagegen!"}},{"id":11464285,"text":"Пни мяч.","tr":{"en":"Kick the ball."}}],"пневмонию":[{"id":4073517,"text":"Ты подхватишь пневмонию.","tr":{"en":"You'll catch pneumonia."}},{"id":7807611,"text":"Мой отец в прошлом месяце подхватил пневмонию.","tr":{"en":"My father contracted pneumonia last month."}}],"пне":[{"id":6555656,"text":"Том сидел на пне, читая книгу.","tr":{"en":"Tom sat on the tree stump, reading a book."}}],"пневмонии":[{"id":12168302,"text":"Том умер три года назад от пневмонии.","tr":{"en":"Tom died three years ago of pneumonia."}}]}