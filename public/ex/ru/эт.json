{"это":[{"id":469796,"text":"Это я.","tr":{"en":"It's me.","de":"Ich bin’s.","uk":"Це я."}},{"id":469796,"text":"Это я.","tr":{"en":"That's me.","de":"Das bin ich!","uk":"Це я."}},{"id":469796,"text":"Это я.","tr":{"en":"This is me.","de":"Das bin ich.","uk":"Це я."}},{"id":1997822,"text":"Это ты?","tr":{"en":"Is that you?","de":"Wär's das?","uk":"Це ви?"}},{"id":2484208,"text":"Это его.","tr":{"en":"It's his.","de":"Es ist seins.","uk":"Він його."}}],"эти":[{"id":5771979,"text":"Эти мои.","tr":{"en":"These are mine.","de":"Die gehören mir.","uk":"Ці належать мені."}},{"id":3013632,"text":"Эти наши.","tr":{"en":"These are ours.","de":"Das sind unsere.","uk":"Ці наші."}},{"id":5566086,"text":"Эти твои.","tr":{"en":"These are yours.","de":"Das sind deine.","uk":"Ось ці твої."}},{"id":5697828,"text":"Эти Тому.","tr":{"en":"These are for Tom.","de":"Diese sind für Tom.","uk":"Ці для Тома."}},{"id":3013628,"text":"Эти новые.","tr":{"en":"These are new.","de":"Diese sind neu.","uk":"Ці нові."}}],"этому":[{"id":4964074,"text":"Я этому рад.","tr":{"en":"I'm glad of that.","de":"Ich bin froh darüber.","uk":"Я цьому радий."}},{"id":2225658,"text":"Я к этому привык.","tr":{"en":"I've gotten used to this.","de":"Ich habe mich daran gewöhnt.","uk":"Я до цього призвичаївся."}},{"id":3585422,"text":"Мы к этому готовы?","tr":{"en":"Are we ready for it?","de":"Sind wir bereit dafür?","uk":"Ми до цього готові?"}},{"id":660042,"text":"Я к этому привыкла.","tr":{"en":"I'm used to that.","de":"Das bin ich gewohnt.","uk":"Я звик до цього."}},{"id":5162597,"text":"Том этому не верит.","tr":{"en":"Tom doesn't believe that.","de":"Tom glaubt das nicht.","uk":"Том цьому не вірить."}}],"этого":[{"id":3257553,"text":"Я этого хочу.","tr":{"en":"I want it.","de":"Ich möchte es.","uk":"Я хочу це."}},{"id":3257553,"text":"Я этого хочу.","tr":{"en":"I want that.","de":"Ich will das.","uk":"Я хочу це."}},{"id":5402570,"text":"Я выше этого.","tr":{"en":"I'm over it.","de":"Ich bin darüber hinweg.","uk":"У вже це \"проїхав\"."}},{"id":5178075,"text":"Я этого хотел.","tr":{"en":"I wanted that.","de":"Ich wollte das.","uk":"Я то хотів."}},{"id":3879897,"text":"Я хотел этого.","tr":{"en":"I wanted this.","de":"Ich wollte das.","uk":"Я хотів цього."}}],"эта":[{"id":1408956,"text":"Кто эта дама?","tr":{"en":"Who is this lady?","de":"Wer ist diese Frau?","uk":"Хто ця жінка?"}},{"id":2261807,"text":"Вот эта книга.","tr":{"en":"It's this book.","de":"Es ist dieses Buch.","uk":"Ось ця книжка."}},{"id":433062,"text":"Эта сумка моя.","tr":{"en":"This bag is mine.","de":"Diese Tasche gehört mir.","uk":"Ця сумка моя."}},{"id":797360,"text":"Эта книга моя.","tr":{"en":"This book is mine.","de":"Das Buch gehört mir.","uk":"Ця книжка моя."}},{"id":4771366,"text":"Эта книга мне?","tr":{"en":"Is that book for me?","de":"Ist das Buch für mich?","uk":"Ця книжка мені?"}}],"этот":[{"id":2381287,"text":"Я возьму этот.","tr":{"en":"I'm taking this one.","de":"Ich nehme das hier.","uk":"Я беру цей."}},{"id":6372030,"text":"Этот зонт мой.","tr":{"en":"This umbrella is mine.","de":"Dieser Schirm ist meiner.","uk":"Ця парасолька моя."}},{"id":4812750,"text":"Этот нож тупой.","tr":{"en":"This knife is dull.","de":"Dieses Messer ist stumpf.","uk":"Цей ніж тупий."}},{"id":13470856,"text":"Этот мир болен.","tr":{"en":"This world is sick.","de":"Diese Welt ist krank.","uk":"Цей світ хворий."}},{"id":5693177,"text":"Том хочет этот.","tr":{"en":"Tom wants this one.","de":"Tom will das hier.","uk":"Тому потрібний ось цей."}}],"этом":[{"id":3831132,"text":"Забудь об этом.","tr":{"en":"Forget about it.","de":"Vergiss es.","uk":"Забудьте про це."}},{"id":6481054,"text":"Я в этом силён.","tr":{"en":"I'm good at this.","de":"Ich bin gut darin.","uk":"У мене це добре виходить."}},{"id":5406404,"text":"Цель не в этом.","tr":{"en":"That isn't the goal.","de":"Das ist nicht das Ziel.","uk":"Це не є метою."}},{"id":5406404,"text":"Цель не в этом.","tr":{"en":"That's not the goal.","de":"Das ist nicht das Ziel.","uk":"Це не є метою."}},{"id":4068096,"text":"Хватит об этом.","tr":{"en":"Stop talking about that.","de":"Sprich nicht mehr davon!","uk":"Досить про це розмовляти."}}],"эту":[{"id":2035987,"text":"Читай эту книгу.","tr":{"en":"Read this book.","de":"Lies dieses Buch.","uk":"Прочитай цю книжку."}},{"id":3235990,"text":"Я люблю эту игру.","tr":{"en":"I love this game.","de":"Ich liebe dieses Spiel.","uk":"Обожнюю цю гру."}},{"id":6452456,"text":"Я хочу эту работу.","tr":{"en":"I want that job.","de":"Ich will diese Stelle.","uk":"Я хочу цю роботу."}},{"id":3876647,"text":"Я хочу эту собаку.","tr":{"en":"I want this dog.","de":"Ich will diesen Hund haben.","uk":"Я хочу цього собаку."}},{"id":1998571,"text":"Я люблю эту песню.","tr":{"en":"I love this song.","de":"Ich liebe dieses Lied.","uk":"Обожнюю цю пісню."}}],"этим":[{"id":4405540,"text":"Ты этим доволен?","tr":{"en":"Are you happy with that?","de":"Bist du damit zufrieden?","uk":"Тебе це влаштовує?"}},{"id":3643758,"text":"С этим покончено.","tr":{"en":"That's over.","de":"Das ist vorbei.","uk":"Це вже закінчилося."}},{"id":2060648,"text":"Воспользуйся этим.","tr":{"en":"Use this.","de":"Nimm das hier!","uk":"Скористайся цим."}},{"id":2709407,"text":"Я этим не горжусь.","tr":{"en":"I'm not proud of that.","de":"Ich bin nicht stolz darauf.","uk":"Я цим не пишаюся."}},{"id":2709407,"text":"Я этим не горжусь.","tr":{"en":"I'm not proud of this.","de":"Ich bin hierauf nicht stolz.","uk":"Я цим не пишаюся."}}],"этаже":[{"id":5546504,"text":"На каком я этаже?","tr":{"en":"What floor am I on?","de":"In welchem Stockwerk befinde ich mich?","uk":"На якому я поверсі?"}},{"id":5123938,"text":"На каком мы этаже?","tr":{"en":"What floor are we on?","de":"In welcher Etage sind wir?","uk":"На якому ми поверсі?"}},{"id":4310738,"text":"Это на восьмом этаже.","tr":{"en":"It's on the eighth floor.","de":"Es ist in der achten Etage.","uk":"Це на восьмому поверсі."}},{"id":2034648,"text":"Я живу на первом этаже.","tr":{"en":"I live on the first floor.","de":"Ich wohne im Erdgeschoss.","uk":"Я живу на першому поверсі."}},{"id":2341546,"text":"На каком этаже ты живёшь?","tr":{"en":"What floor do you live on?","de":"In welchem Stockwerk wohnst du?","uk":"На якому ти живеш поверсі?"}}],"этой":[{"id":1974405,"text":"Что в этой сумке?","tr":{"en":"What's in this bag?","de":"Was ist in dieser Tasche?","uk":"Що в цій сумці?"}},{"id":1709349,"text":"Что в этой коробке?","tr":{"en":"What's in this box?","de":"Was ist in dieser Kiste?","uk":"Що у цій коробці?"}},{"id":1709349,"text":"Что в этой коробке?","tr":{"en":"What is in this box?","de":"Was befindet sich in dieser Kiste?","uk":"Що у цьому ящику?"}},{"id":3267348,"text":"Я уезжаю этой ночью.","tr":{"en":"I'm leaving tonight.","de":"Ich breche heute Abend auf.","uk":"Я від'їжджаю сьогодні ввечері."}},{"id":1055808,"text":"Вы автор этой книги?","tr":{"en":"Are you the author of this book?","de":"Bist du der Autor dieses Buches?","uk":"Ви автор цієї книжки?"}}],"этих":[{"id":3526360,"text":"Возьми один из этих.","tr":{"en":"Take one of these.","de":"Nimm eins hiervon!","uk":"Візміть одну з цих."}},{"id":4939864,"text":"Я знаю этих девочек.","tr":{"en":"I know those girls.","de":"Ich kenne diese Mädchen.","uk":"Я знаю цих дівчат."}},{"id":466816,"text":"Выбери из этих двух.","tr":{"en":"Choose between these two.","de":"Wähle zwischen diesen beiden.","uk":"Обери з цих двох."}},{"id":3695912,"text":"Половина этих яблок гнилые.","tr":{"en":"Half of these apples are rotten.","de":"Die Hälfte der Äpfel sind verdorben.","uk":"Половина цих яблук - гнилі."}},{"id":407513,"text":"Дайте, пожалуйста, три этих.","tr":{"en":"I'd like three of these.","de":"Ich möchte drei von diesen.","uk":"Дайте три, будьте ласкаві."}}],"этими":[{"id":7833021,"text":"Что с этими людьми не так?","tr":{"en":"What's wrong with these people?","de":"Was haben diese Leute denn?","uk":"Що з цими людьми не так?"}},{"id":2749506,"text":"Я не знаком с этими людьми.","tr":{"en":"I don't know those people.","de":"Ich kenne die Leute nicht.","uk":"Я не знаю цих людей."}},{"id":7787070,"text":"С этими часами что-то случилось.","tr":{"en":"Something has happened to this clock.","de":"Mit der Uhr ist etwas passiert.","uk":"З цим годинником щось трапилось."}},{"id":5665995,"text":"Я очень горжусь этими детьми.","tr":{"en":"I'm really proud of these kids.","de":"Ich bin echt stolz auf diese Kinder."}},{"id":5094256,"text":"С этими часами что-то не так.","tr":{"en":"There seems to be something wrong with this clock.","de":"Mit dieser Uhr scheint etwas nicht zu stimmen."}}],"этаж":[{"id":5153933,"text":"Я поднялся в лифте на пятый этаж.","tr":{"en":"I went up to the 5th floor in an elevator.","de":"Ich fuhr mit dem Fahrstuhl in die 5. Etage.","uk":"Я поїхав на п'ятий поверх на ліфті."}},{"id":13729469,"text":"Это второй этаж.","tr":{"en":"This is the second floor.","de":"Dies ist das erste Obergeschoß."}},{"id":4478295,"text":"Первый этаж был затоплен.","tr":{"en":"The ground floor was flooded.","de":"Das Erdgeschoss stand unter Wasser."}},{"id":2348440,"text":"Поднимитесь на лифте на пятый этаж.","tr":{"en":"Take the elevator to the fifth floor.","de":"Nehmen Sie den Aufzug zur fünften Etage."}},{"id":10870236,"text":"Том поднялся на третий этаж на лифте.","tr":{"en":"Tom went up to the third floor by elevator.","de":"Tom fuhr mit dem Aufzug in den dritten Stock."}}],"этично":[{"id":4977869,"text":"Это этично?","tr":{"en":"Is this ethical?","de":"Ist das ethisch?"}},{"id":2319752,"text":"Это не этично.","tr":{"en":"It isn't ethical."}},{"id":2319752,"text":"Это не этично.","tr":{"en":"It's not ethical."}},{"id":2319752,"text":"Это не этично.","tr":{"en":"That's unethical."}},{"id":13710408,"text":"Я не уверен, что это этично.","tr":{"en":"I'm not sure that's ethical."}}],"этикетку":[{"id":4175563,"text":"Я прочитал этикетку.","tr":{"en":"I read the label.","de":"Ich lese das Etikett."}},{"id":7189155,"text":"Том прочитал этикетку на бутылке.","tr":{"en":"Tom read the label on the bottle.","de":"Tom las das Etikett auf der Flasche."}},{"id":9973680,"text":"Том прочитал этикетку.","tr":{"en":"Tom read the tag."}},{"id":4796986,"text":"Внимательно прочтите этикетку.","tr":{"en":"Read the label carefully."}}],"этикета":[{"id":598387,"text":"Это касается этикета.","tr":{"en":"It's a matter of etiquette.","de":"Das ist eine Frage der Etikette."}}],"этап":[{"id":5310096,"text":"Первый этап завершён.","tr":{"en":"The first stage is complete.","de":"Die erste Etappe ist geschafft."}},{"id":8771090,"text":"Первый этап близится к завершению.","tr":{"en":"The first stage is nearing completion."}}],"этажом":[{"id":6802436,"text":"Том живёт этажом ниже.","tr":{"en":"Tom lives one floor below me.","de":"Tom wohnt eine Etage unter mir."}},{"id":6802436,"text":"Том живёт этажом ниже.","tr":{"en":"Tom lives downstairs.","uk":"Том живе поверхом нижче."}},{"id":4567317,"text":"Они живут этажом ниже.","tr":{"en":"They live on the floor below.","uk":"Вони живуть поверхом нижче."}},{"id":4567317,"text":"Они живут этажом ниже.","tr":{"en":"They live on the floor beneath.","uk":"Вони живуть поверхом нижче."}},{"id":408368,"text":"Он живёт этажом выше меня.","tr":{"en":"He lives on the floor above me.","de":"Er wohnt einen Stock über mir."}}],"этажа":[{"id":2731599,"text":"В этом здании три этажа.","tr":{"en":"This building has three floors.","de":"Dieses Gebäude ist dreistöckig."}},{"id":650409,"text":"У этого кинотеатра два этажа.","tr":{"en":"This movie theater has two floors.","de":"Dieses Kino hat zwei Stockwerke."}},{"id":2277631,"text":"Этот лифт не поднимается выше шестого этажа.","tr":{"en":"This elevator does not go above the sixth floor.","de":"Dieser Fahrstuhl geht nur bis zum 6. Stock."}},{"id":2860697,"text":"Том зашёл в лифт и нажал кнопку третьего этажа.","tr":{"en":"Tom got on the elevator and pressed the button for the third floor.","de":"Tom betrat den Fahrstuhl und drückte den Knopf für den zweiten Stock."}},{"id":2731599,"text":"В этом здании три этажа.","tr":{"en":"That building is three stories high."}}],"этажами":[{"id":9443705,"text":"Лифт застрял между этажами.","tr":{"en":"The elevator is stuck between floors.","de":"Der Aufzug ist zwischen den Stockwerken stecken geblieben."}}],"этажей":[{"id":6203109,"text":"Сколько этажей в том здании?","tr":{"en":"How many floors does that building have?","de":"Wie viele Stockwerke hat dieses Gebäude?"}},{"id":5500992,"text":"Сколько этажей в этом здании?","tr":{"en":"How many floors does this building have?","de":"Wie viele Stockwerke hat dieses Gebäude?"}},{"id":4810163,"text":"В этом здании пять этажей и двадцать квартир.","tr":{"en":"This building has 5 floors and 20 apartments.","de":"Dieses Gebäude hat 5 Etagen und 20 Wohnungen."}},{"id":2051248,"text":"В здании двадцать этажей.","tr":{"en":"The building has twenty floors."}},{"id":2051248,"text":"В здании двадцать этажей.","tr":{"en":"The building is twenty stories high."}}],"этажах":[{"id":8178063,"text":"На нижних этажах очень темно.","tr":{"en":"The lower floors are very dark.","de":"In den unteren Stockwerken ist es sehr dunkel."}},{"id":7083523,"text":"Мы с Томом живём на разных этажах.","tr":{"en":"Tom and I live on different floors."}}],"этикетке":[{"id":5499065,"text":"Прочитай, что написано на этикетке.","tr":{"en":"Read what's on the label.","de":"Lies, was auf dem Etikett steht!"}},{"id":6455095,"text":"Что написано на этикетке?","tr":{"en":"What does the label say?"}},{"id":8655559,"text":"Это написано на этикетке.","tr":{"en":"It's written on the label."}},{"id":1938659,"text":"Содержимое коробки указано на этикетке.","tr":{"en":"The contents of the box are listed on the label."}}],"этикетки":[{"id":3876826,"text":"Я обычно внимательно читаю этикетки.","tr":{"en":"I usually read labels carefully.","uk":"Я зазвичай уважно читаю етикетки."}},{"id":2820954,"text":"Наклейте эти этикетки на банки.","tr":{"en":"Paste these labels on the jars."}},{"id":7044475,"text":"Я сказал Тому наклеить этикетки на все коробки.","tr":{"en":"I told Tom to label all the boxes."}}],"этикетка":[{"id":10345013,"text":"На бутылке, которую держал Том, была фиолетовая этикетка.","tr":{"en":"The bottle Tom was holding had a purple label.","de":"Die Flasche, die Tom in Händen hielt, hatte ein violettes Etikett."}}],"этические":[{"id":2175967,"text":"Клонирование людей вызывает серьезные этические проблемы.","tr":{"en":"Cloning people raises serious ethical problems.","uk":"Клонування людей створює серйозні етичні проблеми."}}],"этнические":[{"id":2703052,"text":"Этнические меньшинства борются против предубеждения, бедности и угнетения.","tr":{"en":"Ethnic minorities struggle against prejudice, poverty, and oppression.","de":"Ethnische Minderheiten kämpfen mit Vorurteilen, Armut und Unterdrückung."}}],"этики":[{"id":3501889,"text":"Это был вопрос этики.","tr":{"en":"It was a question of ethics."}}],"этимология":[{"id":10966908,"text":"Этимология этого слова неясна.","tr":{"en":"The etymology of that word is uncertain."}},{"id":10966908,"text":"Этимология этого слова неясна.","tr":{"en":"The etymology of this word is uncertain."}}],"этапе":[{"id":3971224,"text":"На данном этапе они ничего не могут сделать.","tr":{"en":"They can't do anything at this time."}}]}