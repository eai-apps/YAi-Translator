{"енота":[{"id":2708650,"text":"Видишь енота?","tr":{"en":"Do you see the raccoon?","de":"Siehst du den Waschbären?","uk":"Бачиш єнота?"}},{"id":8827029,"text":"Том видел енота?","tr":{"en":"Did Tom see the raccoon?","de":"Hat Tom den Waschbären gesehen?"}},{"id":6737727,"text":"Я хочу енота.","tr":{"en":"I want a raccoon."}},{"id":8581132,"text":"Том видел енота.","tr":{"en":"Tom saw a raccoon."}},{"id":11834673,"text":"Я впервые вижу енота.","tr":{"en":"This is the first time that I've ever seen a raccoon."}}],"еноты":[{"id":10973576,"text":"Еноты тоже млекопитающие.","tr":{"en":"Raccoons are mammals as well.","uk":"Єноти теж ссавці."}},{"id":5666152,"text":"Интересно, что едят еноты.","tr":{"en":"I wonder what raccoons eat."}}],"енот":[{"id":4575158,"text":"Что этот енот делает на кухне?","tr":{"en":"What is the racoon doing in the kitchen?","uk":"Що робить єнот на кухні?"}}],"енотов":[{"id":12182837,"text":"Том видел много енотов.","tr":{"en":"Tom saw many raccoons."}},{"id":8903093,"text":"Я никогда раньше не видел енотов.","tr":{"en":"I'd never seen a raccoon before."}}]}