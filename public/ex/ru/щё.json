{"щётка":[{"id":2517391,"text":"Это моя щётка.","tr":{"en":"That's my toothbrush.","de":"Das ist meine Zahnbürste.","uk":"Це моя зубна щітка."}},{"id":4428752,"text":"Это моя зубная щётка?","tr":{"en":"Is that my toothbrush?","de":"Ist das meine Zahnbürste?","uk":"Це моя зубна щітка?"}},{"id":5208220,"text":"Мне нужна новая зубная щётка.","tr":{"en":"I need a new toothbrush.","de":"Ich brauche eine neue Zahnbürste.","uk":"Мені потрібна нова зубна щітка."}},{"id":6482437,"text":"Какая зубная щётка моя?","tr":{"en":"Which toothbrush is mine?","uk":"Яка зубна щітка моя?"}},{"id":13199961,"text":"Эта зубная щётка слишком мягкая.","tr":{"en":"This toothbrush is too soft.","de":"Diese Zahnbürste ist zu weich."}}],"щёку":[{"id":2082225,"text":"Она поцеловала его в щёку.","tr":{"en":"She kissed him on the cheek.","de":"Sie hat ihn auf die Wange geküsst.","uk":"Вона поцілувала його в щоку."}},{"id":5640370,"text":"Том поцеловал меня в щёку.","tr":{"en":"Tom kissed me on the cheek.","de":"Tom küsste mich auf die Wange."}},{"id":3953706,"text":"Том поцеловал Мэри в щёку.","tr":{"en":"Tom kissed Mary's cheek.","uk":"Том поцілував Мері у щічку."}},{"id":2453838,"text":"Она поцеловала меня в щёку.","tr":{"en":"She kissed my cheek.","de":"Sie küsste mich auf die Wange."}},{"id":6390878,"text":"Мэри поцеловала мужа в щёку.","tr":{"en":"Mary kissed her husband's cheek.","de":"Maria küsste ihren Mann auf die Wange."}}],"щёчку":[{"id":2765410,"text":"Том поцеловал Мэри в щёчку.","tr":{"en":"Tom kissed Mary on the cheek.","de":"Tom küsste Maria auf die Wange.","uk":"Том поцілував Мері у щічку."}},{"id":2765410,"text":"Том поцеловал Мэри в щёчку.","tr":{"en":"Tom gave Mary a kiss on the cheek."}}],"щётку":[{"id":3673409,"text":"Не забудь свою зубную щётку!","tr":{"en":"Don't forget your toothbrush.","de":"Vergiss deine Zahnbürste nicht!","uk":"Не забудь свою зубну щітку."}},{"id":6146601,"text":"Как часто ты покупаешь зубную щётку?","tr":{"en":"How often do you buy a toothbrush?","de":"