{"сядь":[{"id":1670341,"text":"Сядь!","tr":{"en":"Sit down!","de":"Setz dich!","uk":"Сідай!"}},{"id":3060335,"text":"Сядь там.","tr":{"en":"Sit there.","de":"Setz dich dorthin.","uk":"Сідай он там."}},{"id":2516973,"text":"Заткнись и сядь.","tr":{"en":"Shut up and sit down.","de":"Sei still und setz dich hin!","uk":"Замовкни і сідай."}},{"id":4556870,"text":"Сядь рядом со мной.","tr":{"en":"Sit beside me.","de":"Setze dich neben mich.","uk":"Сядь біля мене."}},{"id":4556870,"text":"Сядь рядом со мной.","tr":{"en":"Sit next to me.","de":"Setz dich neben mich.","uk":"Сядь поруч зі мною."}}],"сядьте":[{"id":2177905,"text":"Сядьте прямо.","tr":{"en":"Sit up straight.","de":"Sitz aufrecht.","uk":"Сядьте прямо."}},{"id":2013111,"text":"Пожалуйста, сядьте.","tr":{"en":"Please sit down.","de":"Bitte setzen Sie sich.","uk":"Сідайте, будь ласка."}},{"id":3360717,"text":"Сядьте на скамейку.","tr":{"en":"Sit down on the bench.","de":"Setz dich auf die Bank."}},{"id":6573349,"text":"Сядьте на диван, пожалуйста.","tr":{"en":"Please sit down on the sofa.","de":"Bitte nehmen Sie auf dem Sofa Platz."}},{"id":3286461,"text":"Сядьте и подождите, пожалуйста.","tr":{"en":"Please take a seat and wait.","de":"Setzen Sie sich bitte und warten Sie!"}}],"сяду":[{"id":5607726,"text":"Я сяду на автобус.","tr":{"en":"I'll take the bus.","de":"Ich nehme den Bus.","uk":"Я поїду автобусом."}},{"id":2893861,"text":"Можно я здесь сяду?","tr":{"en":"Can I sit here?","de":"Kann ich hier sitzen?","uk":"Можна мені сісти тут?"}},{"id":1105286,"text":"Можно я сяду здесь?","tr":{"en":"May I sit here?","de":"Kann ich mich hier hinsetzen?","uk":"Можна мені сісти тут?"}},{"id":2636628,"text":"Я сяду на следующий автобус.","tr":{"en":"I'll take the next bus.","de":"Ich werde den nächsten Bus nehmen.","uk":"Я поїду наступним автобусом."}},{"id":2636628,"text":"Я сяду на следующий автобус.","tr":{"en":"I'll catch the next bus.","de":"Ich nehme den nächsten Bus.","uk":"Я сяду на наступний автобус."}}],"сядешь":[{"id":1678337,"text":"Почему ты не сядешь на диету?","tr":{"en":"Why don't you go on a diet?","de":"Warum machst du keine Diät?","uk":"Чому б вам не сісти на дієту?"}},{"id":4460237,"text":"Может, сядешь и расслабишься?","tr":{"en":"Will you sit down and relax?"}},{"id":6880489,"text":"Раньше сядешь, раньше выйдешь.","tr":{"en":"The sooner you start, the sooner you'll finish."}}],"сядем":[{"id":2024880,"text":"Давайте сядем здесь на траву.","tr":{"en":"Let's sit here on the grass.","de":"Setzen wir uns hier aufs Gras!","uk":"Сядьмо тут на траві."}},{"id":5601927,"text":"Сядем здесь?","tr":{"en":"Shall we sit here?","de":"Sollen wir uns hier hinsetzen?"}},{"id":3642575,"text":"Давай сядем здесь.","tr":{"en":"Let's sit down here.","de":"Setzen wir uns doch hierhin!"}},{"id":5966158,"text":"Давай сядем сзади.","tr":{"en":"Let's sit in the back.","de":"Setzen wir uns nach hinten."}},{"id":13554481,"text":"Давай сядем у окна.","tr":{"en":"Let's sit by the window.","de":"Setzen wir uns zum Fenster."}}],"сядет":[{"id":7847450,"text":"Том сядет здесь.","tr":{"en":"Tom is going to sit here.","de":"Tom sitzt hier."}},{"id":3671941,"text":"Солнце скоро сядет.","tr":{"en":"The sun will soon set.","de":"Die Sonne wird bald untergehen."}},{"id":4928043,"text":"Том сядет на автобус.","tr":{"en":"Tom will take the bus.","de":"Tom fährt mit dem Bus."}},{"id":2889623,"text":"Этот материал сядет при стирке.","tr":{"en":"That material's going to shrink if it's washed.","de":"Der Stoff wird beim Waschen eingehen."}},{"id":8594884,"text":"Пусть Том сядет на заднее сиденье.","tr":{"en":"Let Tom sit in the back.","de":"Lass Tom hinten sitzen."}}],"сядут":[{"id":2963885,"text":"Том подождал, пока все сядут.","tr":{"en":"Tom waited for everyone to sit down.","de":"Tom wartete, bis sich alle gesetzt hatten."}}],"сянган":[{"id":3511448,"text":"Его самолёт вылетает в Сянган в два часа дня.","tr":{"en":"His plane leaves for Hong Kong at 2:00 p.m."}}]}