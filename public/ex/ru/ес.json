{"ест":[{"id":3056832,"text":"Том ест?","tr":{"en":"Is Tom eating?","de":"Ist Tom gerade beim Essen?","uk":"Том їсть?"}},{"id":3627245,"text":"Что Том ест?","tr":{"en":"What's Tom eating?","de":"Was isst Tom gerade?","uk":"Що їсть Том?"}},{"id":3627245,"text":"Что Том ест?","tr":{"en":"What is Tom eating?","de":"Was isst Tom gerade?","uk":"Що їсть Том?"}},{"id":797245,"text":"Он много ест.","tr":{"en":"He eats a lot.","de":"Er isst viel.","uk":"Він багато їсть."}},{"id":8458871,"text":"Том ест хлеб.","tr":{"en":"Tom eats bread.","de":"Tom isst Brot.","uk":"Том їсть хліб."}}],"есть":[{"id":572324,"text":"Бог есть.","tr":{"en":"God exists.","de":"Gott existiert.","uk":"Бог є."}},{"id":623334,"text":"Всё есть.","tr":{"en":"Nothing is missing.","de":"Es fehlt nichts.","uk":"Нічого не бракує."}},{"id":5518876,"text":"Есть стол.","tr":{"en":"There's a table.","de":"Da ist ein Tisch.","uk":"Є стіл."}},{"id":3163376,"text":"Давай есть.","tr":{"en":"Let's eat.","de":"Essen wir etwas!","uk":"Давай їсти."}},{"id":3767881,"text":"Сахар есть?","tr":{"en":"Is there any sugar?","de":"Ist Zucker da?","uk":"Там є цукор?"}}],"если":[{"id":2611475,"text":"Если бы я знал!","tr":{"en":"I wish I had known.","de":"Ich wünschte, ich hätte das gewusst!","uk":"Я хотів би знати."}},{"id":11568770,"text":"Иди, если хочешь.","tr":{"en":"Go if you want to.","de":"Geh doch, wenn du gehen willst!","uk":"Йди, як хочеш."}},{"id":4967889,"text":"Что, если я прав?","tr":{"en":"What if I'm right?","de":"Was, wenn ich recht habe?","uk":"А що, якщо я маю рацію?"}},{"id":3673431,"text":"А если я откажусь?","tr":{"en":"What if I refuse?","de":"Was passiert, wenn ich ablehne?","uk":"Що, як я скажу \"ні\"?"}},{"id":13496676,"text":"А если оно протечёт?","tr":{"en":"What if it leaks?","de":"Was, wenn es undicht ist?","uk":"А що, як це протече?"}}],"естественные":[{"id":1591398,"text":"Птицы - естественные враги насекомых.","tr":{"en":"Birds are natural enemies of insects.","de":"Die Vögel sind die natürlichen Feinde der Insekten.","uk":"Птахи - природні вороги комах."}},{"id":10675303,"text":"Мне нравятся и естественные науки, и математика.","tr":{"en":"I like both science and mathematics.","de":"Ich mag sowohl Wissenschaft als auch Mathematik.","uk":"Я люблю як природознавчі науки, так і математику."}},{"id":2124079,"text":"Она должна изучать естественные науки.","tr":{"en":"She has to study science.","de":"Sie muss Naturwissenschaften studieren."}},{"id":2819967,"text":"Я преподавал естественные науки.","tr":{"en":"I was a science teacher."}},{"id":4856779,"text":"Я преподаю естественные науки в восьмом классе в Бостоне.","tr":{"en":"I'm an eighth-grade science teacher in Boston."}}],"естественно":[{"id":13199387,"text":"Это естественно.","tr":{"en":"This is natural.","uk":"Це природньо."}},{"id":3628579,"text":"Это совершенно естественно.","tr":{"en":"It's completely natural.","de":"Das ist vollkommen natürlich."}},{"id":3628579,"text":"Это совершенно естественно.","tr":{"en":"That's perfectly natural.","de":"Das ist völlig natürlich."}},{"id":5264834,"text":"Постарайся вести себя естественно.","tr":{"en":"Try to act natural.","de":"Versuch, dich natürlich zu benehmen!"}},{"id":13669590,"text":"По-твоему, это звучит естественно?","tr":{"en":"Does this sound natural to you?","de":"Klingt das für dich natürlich?"}}],"естественной":[{"id":3268174,"text":"Том умер естественной смертью.","tr":{"en":"Tom died of natural causes.","de":"Tom starb eines natürlichen Todes."}},{"id":3673844,"text":"Является ли агрессия естественной или же благоприобретенной?","tr":{"en":"Is aggression natural, or is it learned?","de":"Ist Aggressivität angeboren oder gelernt?"}},{"id":3268174,"text":"Том умер естественной смертью.","tr":{"en":"Tom died a natural death."}}],"естественный":[{"id":1537574,"text":"Луна - естественный спутник Земли.","tr":{"en":"The earth's moon is a natural satellite.","de":"Der Mond der Erde ist ein natürlicher Satellit."}}],"естественным":[{"id":3840815,"text":"Его смерть наступила по естественным причинам.","tr":{"en":"He died of natural causes.","de":"Er starb eines natürlichen Todes."}},{"id":2711602,"text":"Том пишет дипломную работу по естественным наукам.","tr":{"en":"Tom is doing graduate work in science."}},{"id":7917824,"text":"Для Тома является естественным приходить в бешенство.","tr":{"en":"It's natural for Tom to get mad."}}],"естественными":[{"id":447416,"text":"Японцы — счастливчики, которые живут в стране с естественными горячими источниками.","tr":{"en":"Japanese people are fortunate to live in a land with natural hot springs.","de":"Die Japaner können sich glücklich schätzen, in einem Land mit natürlichen heißen Quellen zu leben."}}],"ес":[{"id":12625564,"text":"В ЕС 24 официальных языка.","tr":{"en":"The EU has 24 official languages."}}],"естественная":[{"id":8231372,"text":"Это вполне естественная реакция.","tr":{"en":"It's a very natural reaction."}}],"естественных":[{"id":7215458,"text":"Том умер в 2013 году от естественных причин.","tr":{"en":"Tom died in 2013 of natural causes."}}]}