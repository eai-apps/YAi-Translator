{"или":[{"id":812604,"text":"Ты идёшь или нет?","tr":{"en":"Are you coming or not?","de":"Kommst du oder nicht?","uk":"Ти йдеш чи ні?"}},{"id":2776797,"text":"Здесь или с собой?","tr":{"en":"Here or to go?","de":"Zum Mitnehmen oder zum Hieressen?","uk":"Тут або з собою?"}},{"id":3064644,"text":"Теперь или никогда.","tr":{"en":"It's now or never.","de":"Jetzt oder nie!","uk":"Зараз або ніколи."}},{"id":812601,"text":"Ты пойдёшь или нет?","tr":{"en":"Are you going or not?","de":"Gehst du oder nicht?","uk":"Ти йдеш чи ні?"}},{"id":3932821,"text":"Ты женат или холост?","tr":{"en":"Are you married or are you single?","de":"Bist du verheiratet oder Single?","uk":"Ти одружений чи холостий?"}}],"иллюстраций":[{"id":7761632,"text":"В этой книге много иллюстраций.","tr":{"en":"This book has a lot of pictures.","de":"Dieses Buch hat viele Bilder.","uk":"Ця книжка має багато малюнків."}}],"иллюзия":[{"id":4418200,"text":"Это иллюзия.","tr":{"en":"It's an illusion.","de":"Das ist eine Illusion."}},{"id":3938586,"text":"Это оптическая иллюзия.","tr":{"en":"It's an optical illusion.","de":"Das ist eine optische Täuschung."}},{"id":3938586,"text":"Это оптическая иллюзия.","tr":{"en":"This is an optical illusion.","de":"Das ist eine optische Täuschung."}},{"id":8730788,"text":"Говорят, мираж - это иллюзия.","tr":{"en":"A mirage is said to be an illusion.","de":"Die Fata Morgana soll eine Sinnestäuschung sein."}},{"id":4940598,"text":"Это иллюзия?","tr":{"en":"Is it an illusion?"}}],"иллюстрации":[{"id":4471933,"text":"Иллюстрации в книге очень хорошие.","tr":{"en":"The book's illustrations are very good.","de":"Die Illustrationen in dem Buch sind sehr gut."}},{"id":10164621,"text":"Некоторые иллюстрации в этой книге очень интересные.","tr":{"en":"The book has some interesting illustrations."}}],"иллюстрация":[{"id":444300,"text":"Иллюстрация может прояснить эту мысль.","tr":{"en":"An illustration may make the point clear.","de":"Eine Illustration kann es auf den Punkt bringen."}}],"иллюзии":[{"id":6390400,"text":"Иллюзии не живут долго.","tr":{"en":"Illusions are short lived."}}],"иллюстрировал":[{"id":10164609,"text":"Кто иллюстрировал эту книгу?","tr":{"en":"Who illustrated this book?"}}],"иллинойс":[{"id":3882847,"text":"Рональд Рейган родился в 1911 году в небольшом городишке Тампико, штат Иллинойс.","tr":{"en":"Ronald Reagan was born in 1911, in the little town of Tampico, Illinois."}}]}