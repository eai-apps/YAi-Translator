{"уязвимы":[{"id":3516485,"text":"Мы слишком уязвимы.","tr":{"en":"We're too vulnerable.","de":"Wir sind zu verletzlich.","uk":"Ми занадто вразливі."}},{"id":5253258,"text":"Они были уязвимы.","tr":{"en":"They were vulnerable."}}],"уязвимым":[{"id":5253257,"text":"Я чувствую себя уязвимым.","tr":{"en":"I feel vulnerable.","uk":"Я почуваюся вразливим."}},{"id":12571703,"text":"Я чувствую себя слабым и уязвимым.","tr":{"en":"I feel weak and vulnerable."}}],"уязвимые":[{"id":4343400,"text":"Дети такие уязвимые.","tr":{"en":"Children are so vulnerable."}}],"уязвим":[{"id":3836309,"text":"В данный момент ты уязвим.","tr":{"en":"You're vulnerable right now."}}]}