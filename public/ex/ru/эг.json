{"эгоист":[{"id":4679034,"text":"Я эгоист.","tr":{"en":"I'm selfish.","de":"Ich bin selbstsüchtig.","uk":"Я егоїст."}},{"id":4860129,"text":"Ты эгоист.","tr":{"en":"You're selfish.","de":"Du bist selbstsüchtig.","uk":"Ти егоїст."}},{"id":1679979,"text":"Том - эгоист.","tr":{"en":"Tom is selfish.","de":"Tom ist egoistisch.","uk":"Том егоїстичний."}},{"id":5697685,"text":"Том не эгоист.","tr":{"en":"Tom isn't selfish.","de":"Tom ist nicht egoistisch.","uk":"Том не егоїст."}},{"id":4484071,"text":"Ты такой эгоист.","tr":{"en":"You're so selfish.","de":"Du bist so egoistisch!","uk":"Ти такий егоїст."}}],"эго":[{"id":3835324,"text":"Какое эго!","tr":{"en":"What an ego!","de":"Was für ein Ego!","uk":"Яке его!"}},{"id":4655373,"text":"У него огромное эго.","tr":{"en":"He has a huge ego.","de":"Er ist ein aufgeblasener Gockel."}}],"эгоистом":[{"id":4959175,"text":"Я был эгоистом.","tr":{"en":"I was selfish.","de":"Ich war egoistisch.","uk":"Я був егоїстом."}},{"id":5608985,"text":"Не будь таким эгоистом.","tr":{"en":"Don't be so selfish.","de":"Sei nicht so egoistisch!","uk":"Не будь таким егоїстом."}},{"id":5288935,"text":"Ты всегда был таким эгоистом?","tr":{"en":"Have you always been so selfish?","de":"Bist du schon immer so egoistisch gewesen?","uk":"Ти завжди був таким егоїстом?"}},{"id":5798940,"text":"Том был эгоистом.","tr":{"en":"Tom was selfish.","de":"Tom war egoistisch."}},{"id":4959175,"text":"Я был эгоистом.","tr":{"en":"I was being selfish."}}],"эгоистична":[{"id":1751578,"text":"Она эгоистична.","tr":{"en":"She is a selfish person.","de":"Sie ist ein egoistischer Mensch.","uk":"Вона — егоїстична особа."}}],"эгоистичный":[{"id":1792909,"text":"Он эгоистичный и жадный.","tr":{"en":"He is selfish and greedy.","de":"Er ist egoistisch und gierig.","uk":"Він егоїстичний і жадібний."}},{"id":13709424,"text":"Том эгоистичный, не так ли?","tr":{"en":"Tom is selfish, isn't he?","de":"Tom ist egoistisch, nicht wahr?","uk":"Том егоїст, так?"}},{"id":5467850,"text":"Том - эгоистичный человек.","tr":{"en":"Tom is a selfish person.","de":"Tom ist ein egoistischer Mensch."}},{"id":13709424,"text":"Том эгоистичный, не так ли?","tr":{"en":"Tom is self-centered, isn't he?","de":"Tom ist ein Egozentriker, nicht wahr?"}},{"id":6634035,"text":"Он очень эгоистичный человек.","tr":{"en":"He's a very selfish person.","uk":"Він страшний егоїст."}}],"эгоистичен":[{"id":2915762,"text":"Я не думаю, что Том эгоистичен.","tr":{"en":"I don't think Tom is selfish.","de":"Ich halte Tom nicht für selbstsüchtig.","uk":"Я не думаю, що Том егоїст."}},{"id":8305194,"text":"Ты очень эгоистичен.","tr":{"en":"You're very selfish.","de":"Du bist sehr egoistisch."}},{"id":5618430,"text":"Том очень эгоистичен.","tr":{"en":"Tom is very selfish.","de":"Tom ist sehr egoistisch."}},{"id":4816734,"text":"Том груб и эгоистичен.","tr":{"en":"Tom is rude and selfish.","de":"Tom ist unverschämt und egoistisch."}},{"id":5982323,"text":"Том довольно эгоистичен.","tr":{"en":"Tom is quite selfish.","de":"Tom ist ziemlich egoistisch."}}],"эгоцентрист":[{"id":2067346,"text":"Том - эгоцентрист.","tr":{"en":"Tom is self-centered.","de":"Tom ist ein Egozentriker."}}],"эгоистичным":[{"id":3938787,"text":"Я был очень эгоистичным.","tr":{"en":"I was very selfish.","de":"Ich war sehr egoistisch."}}],"эгоистичная":[{"id":1927887,"text":"Какая эгоистичная женщина!","tr":{"en":"What a selfish woman!","de":"Was für eine selbstsüchtige Frau!"}}],"эгоизме":[{"id":6900655,"text":"Том обвинил меня в эгоизме.","tr":{"en":"Tom accused me of being selfish.","uk":"Том звинуватив мене в егоїзмі."}}],"эгоистично":[{"id":3022419,"text":"Это было очень эгоистично со стороны Тома не дать вам воспользоваться машиной.","tr":{"en":"That was pretty selfish of Tom not to let you use the car.","de":"Es war ziemlich egoistisch von Tom, dich nicht das Auto nehmen zu lassen."}},{"id":5924184,"text":"Том ведёт себя очень эгоистично.","tr":{"en":"Tom is being very selfish."}}],"эгоисты":[{"id":4605558,"text":"Мы эгоисты.","tr":{"en":"We're selfish."}},{"id":1914142,"text":"Эгоисты живут только для себя.","tr":{"en":"The selfish live for themselves alone."}}],"эгоистка":[{"id":1751580,"text":"Она эгоистка.","tr":{"en":"She is a selfish woman."}},{"id":9043987,"text":"Она, конечно, красивая, но эгоистка.","tr":{"en":"It is true that she is pretty, but she is selfish."}}],"эгг":[{"id":5084158,"text":"Она сделала мне эгг-ног.","tr":{"en":"She made me some eggnog."}}],"эгоцентричным":[{"id":6168394,"text":"Я считаю Тома эгоцентричным.","tr":{"en":"I think Tom is self-centered."}}],"эгоцентричен":[{"id":5287808,"text":"Том импульсивен и эгоцентричен.","tr":{"en":"Tom is impulsive and self-centered."}},{"id":4990796,"text":"Том молод, богат, испорчен и эгоцентричен.","tr":{"en":"Tom is young, rich, spoiled and egocentric."}}],"эгоизм":[{"id":4653684,"text":"Меня часто раздражает её эгоизм.","tr":{"en":"I am often irritated by her selfishness."}}],"эгоистами":[{"id":3567553,"text":"Прежде всего мы не должны быть эгоистами.","tr":{"en":"Above all things, we must not be selfish."}}]}