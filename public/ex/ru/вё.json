{"вёл":[{"id":2795097,"text":"Я вёл машину.","tr":{"en":"I drove.","de":"Ich fuhr!","uk":"Я вів машину."}},{"id":3572425,"text":"Машину вёл Том.","tr":{"en":"Tom drove the car.","de":"Tom saß am Steuer.","uk":"Машину вів Том."}},{"id":441983,"text":"Он плохо вёл себя.","tr":{"en":"He behaved badly.","de":"Er hat sich schlecht verhalten.","uk":"Він погано поводився."}},{"id":5430847,"text":"Том вёл себя хорошо.","tr":{"en":"Tom behaved well.","de":"Tom hat sich gut benommen.","uk":"Том поводився добре."}},{"id":5614624,"text":"Том вёл себя прилично.","tr":{"en":"Tom behaved himself.","de":"Tom hat sich benommen.","uk":"Том добре поводився."}}],"вёсел":[{"id":2493362,"text":"У этой лодки шесть вёсел.","tr":{"en":"This boat has six oars.","de":"Dieses Boot hat sechs Riemen."}}],"вёслах":[{"id":2807977,"text":"Мы шли на вёслах против течения.","tr":{"en":"We were rowing against the current.","de":"Wir ruderten gegen die Strömung an."}},{"id":13413500,"text":"Они поплыли на вёслах вверх по реке.","tr":{"en":"They rowed up the river."}}],"вёсла":[{"id":6880767,"text":"Где вёсла?","tr":{"en":"Where are the oars?"}}],"вёдрах":[{"id":8377731,"text":"Они несли воду в вёдрах.","tr":{"en":"They carried water in buckets."}}],"вёсельную":[{"id":9981998,"text":"Почему бы нам не арендовать вёсельную лодку?","tr":{"en":"Why don't we rent a rowboat?"}}]}