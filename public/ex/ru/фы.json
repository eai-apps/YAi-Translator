{"фыркает":[{"id":4539243,"text":"Лошадь фыркает.","tr":{"en":"The horse is snorting."}}],"фыркнул":[{"id":4006085,"text":"Старик с насмешкой фыркнул.","tr":{"en":"The old man snorted contemptuously."}},{"id":6393507,"text":"Ёжик фыркнул и свернулся в клубок.","tr":{"en":"The little hedgehog snorted and curled up into a ball."}}],"фыркнула":[{"id":6548699,"text":"Лошадь нетерпеливо фыркнула.","tr":{"en":"The horse snorted impatiently."}}]}