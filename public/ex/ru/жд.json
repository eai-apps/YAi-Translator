{"ждите":[{"id":3048599,"text":"Ждите.","tr":{"en":"Wait.","de":"Warte.","uk":"Зачекайте."}},{"id":2834641,"text":"Не ждите меня.","tr":{"en":"Don't wait for me.","de":"Warten Sie nicht auf mich.","uk":"Не чекай на мене."}},{"id":2096127,"text":"Ждите своей очереди.","tr":{"en":"Wait until your turn comes.","de":"Warte, bis du an der Reihe bist.","uk":"Чекай на свою чергу."}},{"id":10839324,"text":"Ждите нас там.","tr":{"en":"Wait for us there.","de":"Warte dort auf uns!"}},{"id":10839324,"text":"Ждите нас там.","tr":{"en":"Wait there for us.","de":"Warte dort auf uns!"}}],"ждал":[{"id":2831034,"text":"Том ждал.","tr":{"en":"Tom waited.","de":"Tom wartete.","uk":"Том чекав."}},{"id":2831034,"text":"Том ждал.","tr":{"en":"Tom was waiting.","de":"Tom wartete.","uk":"Том чекав."}},{"id":6388572,"text":"Я не ждал.","tr":{"en":"I didn't wait.","de":"Ich habe nicht gewartet.","uk":"Я не чекав."}},{"id":1077041,"text":"Долго ждал?","tr":{"en":"How long have you waited?","de":"Wie lange hast du gewartet?","uk":"Скільки ти чекав?"}},{"id":2608542,"text":"Я ждал Тома.","tr":{"en":"I waited for Tom.","de":"Ich wartete auf Tom.","uk":"Я чекав на Тома."}}],"ждёт":[{"id":4316539,"text":"Такси ждёт.","tr":{"en":"A cab is waiting.","de":"Ein Taxi wartet.","uk":"Таксі чекає."}},{"id":5064167,"text":"Том уже ждёт.","tr":{"en":"Tom is already waiting.","de":"Tom wartet schon.","uk":"Том уже чекає."}},{"id":2746855,"text":"Том ждёт тебя.","tr":{"en":"Tom is waiting for you.","de":"Tom wartet auf dich.","uk":"Том чекає на тебе."}},{"id":3780393,"text":"Том ждёт Мэри.","tr":{"en":"Tom is waiting for Mary.","de":"Tom wartet auf Maria.","uk":"Том чекає на Мері."}},{"id":5512853,"text":"Том ждёт снаружи.","tr":{"en":"Tom is waiting outside.","de":"Tom wartet draußen.","uk":"Том чекає ззовні."}}],"жду":[{"id":2620428,"text":"Я жду тебя.","tr":{"en":"I'm waiting for you.","de":"Ich warte auf dich.","uk":"Я на тебе чекаю."}},{"id":1728997,"text":"Я жду поезд.","tr":{"en":"I'm waiting for a train.","de":"Ich warte auf einen Zug.","uk":"Я чекаю на потяг."}},{"id":2620423,"text":"Я жду ответа.","tr":{"en":"I'm waiting for an answer.","de":"Ich warte auf eine Antwort.","uk":"Я чекаю на відповідь."}},{"id":2620423,"text":"Я жду ответа.","tr":{"en":"I'm waiting for a response.","de":"Ich warte auf eine Antwort.","uk":"Я чекаю на відповідь."}},{"id":2620331,"text":"Я жду автобус.","tr":{"en":"I'm waiting for the bus.","de":"Ich warte gerade auf den Bus.","uk":"Я чекаю на автобус."}}],"ждёшь":[{"id":3946590,"text":"Давно ждёшь?","tr":{"en":"Have you been waiting a long time?","de":"Wartest du schon lange?","uk":"Ви вже давно чекаєте?"}},{"id":1936053,"text":"Чего ты ждёшь?","tr":{"en":"What're you waiting for?","de":"Worauf wartest du?","uk":"На що ти чекаєш?"}},{"id":1936053,"text":"Чего ты ждёшь?","tr":{"en":"What are you waiting for?","de":"Worauf wartest du?","uk":"На що ти чекаєш?"}},{"id":2436533,"text":"Ждёшь кого-то?","tr":{"en":"Are you waiting for someone?","de":"Wartest du auf jemanden?","uk":"Ти на когось чекаєш?"}},{"id":8005724,"text":"Ты не Тома ждёшь?","tr":{"en":"Aren't you waiting for Tom?","de":"Wartest du nicht auf Tom?","uk":"Хіба ти не на Тома чекаєш?"}}],"жди":[{"id":3522170,"text":"Жди в машине.","tr":{"en":"Wait in the car.","de":"Warte im Wagen!","uk":"Зачекай в машині."}},{"id":668900,"text":"Не жди слишком многого.","tr":{"en":"Don't expect too much.","de":"Erwarte nicht zu viel.","uk":"Не очікуй забагато."}},{"id":1863726,"text":"Жди здесь, пока я не вернусь.","tr":{"en":"Wait here till I return.","de":"Bleib hier, bis ich zurückkomme!","uk":"Почекай тут, поки я не повернусь."}},{"id":1863726,"text":"Жди здесь, пока я не вернусь.","tr":{"en":"Wait here till I get back.","de":"Warte hier, bis ich wieder da bin!","uk":"Зачекай тут, допоки я не повернуся."}},{"id":1863726,"text":"Жди здесь, пока я не вернусь.","tr":{"en":"Wait here till I come back.","de":"Warte hier, bis ich zurückkomme.","uk":"Дочекайся мене."}}],"ждём":[{"id":3622447