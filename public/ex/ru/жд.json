е?","tr":{"en":"Who are you waiting for?","de":"Auf wen wartest du?","uk":"Кого ти чекаєш?"}},{"id":3493550,"text":"Каких результатов вы ждёте?","tr":{"en":"What results do you anticipate?","de":"Welche Ergebnisse erwartest du?","uk":"Яких результатів ви очікуєте?"}},{"id":2723889,"text":"Чего вы ждёте?","tr":{"en":"What are you guys waiting for?","de":"Worauf wartet ihr?"}},{"id":3874692,"text":"Вы ждёте гостей?","tr":{"en":"Are you expecting any visitors?","de":"Erwarten Sie Gäste?"}},{"id":5638594,"text":"Вы давно меня ждёте?","tr":{"en":"Have you been waiting for me for long?","de":"Warten Sie schon lange auf mich?"}}],"ждала":[{"id":3010381,"text":"Она ждала часами.","tr":{"en":"She waited for hours and hours.","de":"Sie wartete stundenlang.","uk":"Вона чекали годинами."}},{"id":8255493,"text":"Она часами его ждала.","tr":{"en":"She waited for him for hours.","de":"Sie hat stundenlang auf ihn gewartet.","uk":"Вона годинами чекала на нього."}},{"id":12588838,"text":"Я ждала именно этой новости.","tr":{"en":"This is the news I've been waiting for.","de":"Das sind die Neuigkeiten, auf die ich gewartet habe.","uk":"Я чекав саме на цю новину."}},{"id":12588838,"text":"Я ждала именно этой новости.","tr":{"en":"This is the news that I've been waiting for.","de":"Das sind die Neuigkeiten, auf die ich gewartet habe.","uk":"Я чекав саме на цю новину."}},{"id":1549608,"text":"Я ждала тебя.","tr":{"en":"I was waiting for you.","de":"Ich habe auf dich gewartet."}}],"ждет":[{"id":5736799,"text":"Том видел, что Мэри ждет.","tr":{"en":"Tom saw Mary waiting.","de":"Tom sah Maria warten.","uk":"Том бачив, що Мері чекає."}},{"id":3648710,"text":"Он ждет здесь уже довольно долго.","tr":{"en":"He's been waiting here for quite a while.","de":"Er wartete hier eine ganze Weile.","uk":"Він вже досить довго тут чекає."}},{"id":5969091,"text":"Том ждет внизу.","tr":{"en":"Tom is waiting downstairs.","de":"Tom wartet unten."}},{"id":5742274,"text":"Том ждет с Мэри.","tr":{"en":"Tom is waiting with Mary.","uk":"Точ чекає з Мері."}},{"id":3505293,"text":"Том ждет автобуса.","tr":{"en":"Tom is waiting for the bus.","de":"Tom wartet auf den Bus."}}],"ждем":[{"id":4007281,"text":"Скажи Тому, что мы его ждем.","tr":{"en":"Tell Tom we're waiting for him.","de":"Sag Tom, dass wir auf ihn warten!","uk":"Скажи Тому, що ми на нього чекаємо."}},{"id":5936069,"text":"Почему мы ждем Тома?","tr":{"en":"Why are we waiting for Tom?","uk":"Чому ми чекаємо на Тома?"}},{"id":4167428,"text":"Мы ждем обслуживания.","tr":{"en":"We're waiting to be served.","de":"Wir warten darauf, bedient zu werden."}},{"id":5969288,"text":"Мы ждем, пока Том не уйдет.","tr":{"en":"We're waiting for Tom to leave.","de":"Wir warten darauf, dass Tom geht."}},{"id":3698744,"text":"Мы ждем твоего появления уже несколько часов.","tr":{"en":"We've been waiting for hours for you to show up.","de":"Wir haben stundenlang darauf gewartet, dass du auftauchst."}}],"ждало":[{"id":4852153,"text":"В очереди ждало много людей.","tr":{"en":"Many people were waiting in line.","de":"Viele Leute standen Schlange.","uk":"У черзі чекало багато людей."}}],"ждали":[{"id":10159046,"text":"Они ждали, когда откроются ворота.","tr":{"en":"They were waiting for the gate to open.","de":"Sie warteten darauf, dass das Tor aufging.","uk":"Вони чекали, поки відкриють ворота."}},{"id":2831037,"text":"Мы ждали.","tr":{"en":"We were waiting.","de":"Wir warteten."}},{"id":2831039,"text":"Они ждали.","tr":{"en":"They waited.","de":"Sie warteten."}},{"id":2492606,"text":"Все ждали.","tr":{"en":"Everyone waited.","de":"Alle warteten."}},{"id":2492606,"text":"Все ждали.","tr":{"en":"Everybody waited.","de":"Alle warteten."}}],"ждешь":[{"id":3578752,"text":"Ты чего-то ждешь?","tr":{"en":"Are you waiting for something?","uk":"Ти на когось чекаєш?"}}],"ждете":[{"id":4520275,"text":"Что вы ждете от меня?","tr":{"en":"What do you expect me to do?","de":"Was erwartest du, dass ich tue?"}}],"жды":[{"id":1398858,"text":"В настоя́щее вре́мя бо́льшая часть оде́жды импорти́руется из Кита́я.","tr":{"en":"These days, most clothing is imported from China.","de":"Heutzutage wird fast sämtliche Kleidung aus China importiert."}}]}