{"хмурое":[{"id":6557350,"text":"Небо сегодня хмурое.","tr":{"en":"The sky is overcast today.","de":"Heute ist es bedeckt.","uk":"Сьогодні хмарно."}}],"хмель":[{"id":4241557,"text":"В пиве содержится хмель.","tr":{"en":"Beer contains hops.","de":"Bier enthält Hopfen.","uk":"Пиво містить хміль."}}],"хм":[{"id":5100397,"text":"Хм, это не совсем правда.","tr":{"en":"Well, that's not quite true.","de":"Das ist nun nicht so ganz richtig.","uk":"Хм, це не зовсім так."}},{"id":4109264,"text":"Хм, что это?","tr":{"en":"Hmm, what's this?","uk":"Гм, що це?"}}],"хмуриться":[{"id":6534978,"text":"Хватит хмуриться.","tr":{"en":"Stop frowning.","uk":"Припини хмуритись!"}},{"id":6534978,"text":"Хватит хмуриться.","tr":{"en":"Stop scowling."}}],"хмурься":[{"id":11106815,"text":"Не хмурься.","tr":{"en":"Don't frown."}}],"хмуришься":[{"id":12060374,"text":"Почему ты хмуришься?","tr":{"en":"Why are you frowning?"}}],"хмурится":[{"id":7913302,"text":"Том постоянно хмурится.","tr":{"en":"Tom is always scowling."}},{"id":4342031,"text":"Том не мог понять, почему Мэри на него хмурится.","tr":{"en":"Tom couldn't understand why Mary frowned at him."}}]}