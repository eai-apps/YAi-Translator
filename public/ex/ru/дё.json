{"дёшево":[{"id":1003214,"text":"Ого! Как дёшево!","tr":{"en":"Wow! That's cheap!","de":"Oh! Das ist billig!","uk":"Ого! Це дешево!"}},{"id":4795230,"text":"Это очень дёшево.","tr":{"en":"It's very cheap.","de":"Es ist sehr billig.","uk":"Це дуже дешево."}},{"id":3621281,"text":"Это было очень дёшево.","tr":{"en":"It was really cheap.","de":"Es war sehr günstig.","uk":"Це було дуже дешево."}},{"id":6566391,"text":"Я живу здесь только потому, что тут дёшево.","tr":{"en":"I only live here because it's cheap.","de":"Ich wohne nur deswegen hier, weil es billig ist.","uk":"Я живу тут лише через те, що тут дешево."}},{"id":1272654,"text":"Дёшево.","tr":{"en":"It's cheap.","uk":"Він дешевий."}}],"дёрнул":[{"id":6323862,"text":"Я дёрнул за рычаг.","tr":{"en":"I pulled the lever.","de":"Ich legte den Hebel um.","uk":"Я потягнув важіль."}},{"id":4636589,"text":"Он дёрнул за верёвку.","tr":{"en":"He pulled the rope.","de":"Er zog am Seil.","uk":"Він потягнув мотузку."}},{"id":1506047,"text":"Том дёрнул рубильник.","tr":{"en":"Tom pulled the trigger.","de":"Tom drückte ab."}},{"id":3344704,"text":"Том дёрнул Мэри за руку.","tr":{"en":"Tom tugged on Mary's arm.","uk":"Том смикнув Мері за руку."}},{"id":4991372,"text":"Том дёрнул Мэри за волосы.","tr":{"en":"Tom pulled Mary's hair.","uk":"Том потягнув Мері за волосся."}}],"дёсны":[{"id":2978654,"text":"У тебя кровоточат дёсны?","tr":{"en":"Do your gums bleed?","de":"Haben Sie Zahnfleischbluten?","uk":"У вас ясна кровоточать?"}},{"id":3234316,"text":"Ваши дёсны в плохом состоянии.","tr":{"en":"Your gums are in bad shape.","de":"Dein Zahnfleisch ist in schlechtem Zustand.","uk":"Ваші ясна в поганому стані."}},{"id":11280346,"text":"У тебя кровоточат дёсны, когда ты чистишь зубы?","tr":{"en":"Do your gums bleed when you brush your teeth?","de":"Haben Sie Zahnfleischbluten beim Zähneputzen?"}},{"id":4684114,"text":"У меня дёсны кровоточат.","tr":{"en":"I have bleeding gums."}},{"id":4684114,"text":"У меня дёсны кровоточат.","tr":{"en":"My gums are bleeding."}}],"дёсен":[{"id":423077,"text":"У вас инфекция дёсен.","tr":{"en":"You have a gum infection.","de":"Sie haben entzündetes Zahnfleisch."}}],"дёргается":[{"id":5510097,"text":"У меня дёргается лицо.","tr":{"en":"My face twitches.","de":"Mein Gesicht zuckt."}},{"id":5664177,"text":"У меня дёргается левое веко.","tr":{"en":"My left eyelid is twitching.","de":"Mein linkes Augenlid zuckt."}},{"id":4966064,"text":"У меня правый глаз дёргается.","tr":{"en":"I have a twitch in my right eye.","de":"Mein rechtes Auge zuckt."}},{"id":4090126,"text":"У Тома опять правый глаз дёргается.","tr":{"en":"Tom's right eye is twitching again.","de":"Toms rechtes Auge begann wieder zu zucken."}}],"дёргает":[{"id":4750060,"text":"Том в саду дёргает сорняки.","tr":{"en":"Tom is in the garden, pulling weeds.","de":"Tom jätet im Garten Unkraut."}}],"дёргать":[{"id":5425597,"text":"Хватит дёргать сестру за волосы.","tr":{"en":"Stop pulling your sister's hair.","de":"Hör auf, deine Schwester an den Haaren zu ziehen!"}}],"дёргал":[{"id":10164685,"text":"Кто-то дёргал меня за рукав.","tr":{"en":"Someone was tugging on my sleeve."}}],"дёрни":[{"id":1730509,"text":"Дёрни за веревочку, дверь и откроется!","tr":{"en":"Pull the string and the door will open."}}],"дёшевы":[{"id":1860981,"text":"Некоторые дорогие, другие - очень дёшевы.","tr":{"en":"Some are expensive, and others are very cheap."}}],"дёшев":[{"id":441172,"text":"Этот автомобиль был достаточно дёшев, чтобы он мог его купить.","tr":{"en":"This car was cheap enough for him to buy."}}]}