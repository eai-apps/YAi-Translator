{"Egal":[{"id":4943038,"text":"Egal wer.","tr":{"en":"Anybody will do.","ru":"Любой подойдёт.","uk":"Підійде будь-хто."}},{"id":4948766,"text":"Egal, was du sagst, ich werde nicht aufgeben.","tr":{"en":"No matter what you say, I won't give up.","ru":"Что бы ты ни говорил, я не уступлю.","uk":"Що б ти не казав, я не здамся."}},{"id":365553,"text":"Egal was passiert, ich werde nicht überrascht sein.","tr":{"en":"No matter what happens, I won't be surprised.","ru":"Что бы ни случилось, я не удивлюсь.","uk":"Хай там що буде, мене це не здивує."}},{"id":4943006,"text":"Egal was.","tr":{"en":"Anything will do.","ru":"Всё равно что."}},{"id":718471,"text":"Egal wie viel es kostet.","tr":{"en":"It doesn't matter how much it costs.","ru":"Неважно, сколько это стоит."}}],"Ego":[{"id":7466820,"text":"Was für ein Ego!","tr":{"en":"What an ego!","ru":"Какое эго!","uk":"Яке его!"}},{"id":3797496,"text":"Toms Ego wurde angeschlagen.","tr":{"en":"Tom's ego has been bruised."}}],"egal":[{"id":518341,"text":"Es ist mir egal.","tr":{"en":"I don't care.","ru":"Мне все равно.","uk":"Мені байдуже."}},{"id":518341,"text":"Es ist mir egal.","tr":{"en":"I don't mind.","ru":"Я не против.","uk":"Я не заперечую."}},{"id":6614947,"text":"Tom war es egal.","tr":{"en":"Tom didn't care.","ru":"Тому было всё равно.","uk":"Тому було байдуже."}},{"id":6619276,"text":"Tom ist es egal.","tr":{"en":"It doesn't matter to Tom.","ru":"Это не имеет значения для Тома.","uk":"Тому це байдуже."}},{"id":5300048,"text":"Ist dir das egal?","tr":{"en":"Do you even care?","ru":"Тебя это вообще волнует?","uk":"А тобі не все одно?"}}],"egoistisch":[{"id":10083949,"text":"Ich war egoistisch.","tr":{"en":"I was selfish.","ru":"Я был эгоистом.","uk":"Я був егоїстом."}},{"id":6615319,"text":"Tom ist egoistisch.","tr":{"en":"Tom is selfish.","ru":"Том - эгоист.","uk":"Том егоїстичний."}},{"id":2705327,"text":"Du bist so egoistisch!","tr":{"en":"You're so selfish.","ru":"Ты такой эгоист.","uk":"Ти такий егоїст."}},{"id":1343536,"text":"Er ist sehr egoistisch.","tr":{"en":"He's really selfish.","ru":"Он настоящий эгоист.","uk":"Він дуже егоїстичний."}},{"id":5609019,"text":"Sei nicht so egoistisch!","tr":{"en":"Don't be so selfish.","ru":"Не будь таким эгоистом.","uk":"Не будь таким егоїстом."}}],"egoistischer":[{"id":523450,"text":"Sie ist ein egoistischer Mensch.","tr":{"en":"She is a selfish person.","ru":"Она эгоистична.","uk":"Вона — егоїстична особа."}},{"id":10097568,"text":"Tom ist ein egoistischer Mensch.","tr":{"en":"Tom is a selfish person.","ru":"Том - эгоистичный человек."}},{"id":10102147,"text":"Tom ist ein ziemlich egoistischer Mensch.","tr":{"en":"Tom is a very selfish person.","uk":"Том дуже егоїстична людина."}},{"id":523444,"text":"Ein egoistischer Mensch denkt nur an seine eigenen Gefühle.","tr":{"en":"A selfish man thinks of nothing but his own feelings.","ru":"Себялюбивый человек думает лишь о собственных чувствах."}}],"Egoist":[{"id":1525962,"text":"Tom ist ein Egoist.","tr":{"en":"Tom is a selfish man.","ru":"Том - эгоист."}}],"Egozentriker":[{"id":1721532,"text":"Tom ist ein Egozentriker.","tr":{"en":"Tom is self-centered.","ru":"Том - эгоцентрист."}},{"id":10034371,"text":"Tom ist ein Egozentriker, nicht wahr?","tr":{"en":"Tom is self-centered, isn't he?","ru":"Том эгоистичный, не так ли?"}}],"egoistisches":[{"id":8034298,"text":"Tom ist ein egoistisches Arschloch.","tr":{"en":"Tom is such a selfish jerk."}}],"Egoismus":[{"id":911684,"text":"Sie tolerierte seinen Egoismus nicht.","tr":{"en":"She didn't tolerate his selfishness."}},{"id":3530406,"text":"Dein Egoismus wird dich deine Freunde kosten.","tr":{"en":"Your selfishness will lose you your friends."}}]}