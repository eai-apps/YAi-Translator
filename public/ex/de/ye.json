{"Yen":[{"id":1056483,"text":"Reichen tausend Yen?","tr":{"en":"Is a thousand yen enough?","ru":"Тысячи иен хватит?","uk":"Тисячі єн достатньо?"}},{"id":1056483,"text":"Reichen tausend Yen?","tr":{"en":"Is one thousand yen enough?","ru":"Тысячи иен хватит?","uk":"Тисячі єн достатньо?"}},{"id":1313779,"text":"Das sind fünfzig Yen.","tr":{"en":"It's 50 yen.","ru":"50 иен.","uk":"Це п'ятдесят ієн."}},{"id":923149,"text":"Ich schulde ihm 100 Yen.","tr":{"en":"I owe him 100 yen.","ru":"Я должен ему сто иен.","uk":"Я винен йому 100 єн."}},{"id":357811,"text":"Er gab mir zehntausend Yen.","tr":{"en":"He gave me 10,000 yen.","ru":"Он дал мне 10 000 иен.","uk":"Він дав мені десять тисяч єн."}}],"Yellowstone":[{"id":5584155,"text":"Der Yellowstone-Nationalpark liegt in Wyoming.","tr":{"en":"Yellowstone National Park is located in Wyoming.","ru":"Йеллоустоунский национальный парк находится в Вайоминге."}}],"Yesterday":[{"id":13500184,"text":"Mein Lieblingslied von den Beatles ist „Yesterday“.","tr":{"en":"My favorite Beatles' song is \"Yesterday.\""}}]}