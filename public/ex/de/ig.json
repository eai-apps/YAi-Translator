{"Ignoriere":[{"id":7369968,"text":"Ignoriere sie.","tr":{"en":"Ignore them.","ru":"Не обращай на них внимания.","uk":"Проігноруй їх."}}],"Igel":[{"id":9456702,"text":"Igel sind süß.","tr":{"en":"Hedgehogs are cute.","ru":"Ёжики милые.","uk":"Їжаки милі."}},{"id":9288746,"text":"Ich liebe Igel.","tr":{"en":"I love hedgehogs.","uk":"Я обожнюю їжаків."}},{"id":12472481,"text":"Igel haben Stacheln.","tr":{"en":"Hedgehogs have quills.","ru":"У ежей есть иголки."}},{"id":6698215,"text":"Das hier ist ein Igel.","tr":{"en":"This is a hedgehog.","ru":"Это ёж."}},{"id":8182357,"text":"Igel sind Allesfresser.","tr":{"en":"Hedgehogs are omnivores.","uk":"Їжаки всеядні."}}],"ignorierte":[{"id":7712547,"text":"Er ignorierte mich.","tr":{"en":"He ignored me.","ru":"Он не обратил на меня внимания.","uk":"Він проігнорував мене."}},{"id":4943174,"text":"Tom ignorierte Mary.","tr":{"en":"Tom ignored Mary.","ru":"Том игнорировал Мэри.","uk":"Том проігнорував Мері."}},{"id":766628,"text":"Er ignorierte ihren Rat.","tr":{"en":"He ignored her advice.","ru":"Он проигнорировал её совет.","uk":"Він проігнорував її пораду."}},{"id":1513585,"text":"Tom ignorierte Marys Rat.","tr":{"en":"Tom ignored Mary's advice.","ru":"Том не обратил внимания на совет Мэри.","uk":"Том проігнорував пораду Мері."}},{"id":396406,"text":"Er ignorierte meinen Ratschlag.","tr":{"en":"He disregarded my advice.","ru":"Он пренебрёг моим советом.","uk":"Він знехтував моєю порадою."}}],"ignorieren":[{"id":3063734,"text":"Wir ignorieren Tom.","tr":{"en":"We're ignoring Tom.","ru":"Мы игнорируем Тома.","uk":"Ми ігноруємо Тома."}},{"id":5821173,"text":"Sie ignorieren uns.","tr":{"en":"They're ignoring us.","ru":"Они игнорируют нас.","uk":"Вони нас ігнорують."}},{"id":1952608,"text":"Du kannst Tom nicht ignorieren.","tr":{"en":"You can't ignore Tom.","ru":"Вы не можете игнорировать Тома.","uk":"Ти не можеш ігнорувати Тома."}},{"id":4177294,"text":"Wir können Tom nicht ignorieren.","tr":{"en":"We can't ignore Tom.","ru":"Мы не можем игнорировать Тома.","uk":"Ми не можемо ігнорувати Тома."}},{"id":5892506,"text":"Tom versucht, Maria zu ignorieren.","tr":{"en":"Tom is trying to ignore Mary.","ru":"Том пытается игнорировать Мэри.","uk":"Том намагається ігнорувати Мері."}}],"Ignorierst":[{"id":8791945,"text":"Ignorierst du mich?","tr":{"en":"Are you ignoring me?","ru":"Ты меня игнорируешь?","uk":"Ти мене ігноруєш?"}}],"ignorierten":[{"id":7413752,"text":"Sie ignorierten mich.","tr":{"en":"They ignored me.","ru":"Они игнорировали меня.","uk":"Вони мене проігнорували."}},{"id":7369923,"text":"Alle ignorierten Tom.","tr":{"en":"Everyone ignored Tom.","ru":"Никто не обращал внимания на Тома.","uk":"Усі проігнорували Тома."}},{"id":6619518,"text":"Sie ignorierten Tom.","tr":{"en":"They ignored Tom.","ru":"Они не обращали на Тома внимания."}},{"id":441761,"text":"Sie ignorierten ihre Einwände.","tr":{"en":"They set aside her objections.","ru":"Они отклонили её возражения."}},{"id":6033018,"text":"Manchmal kommt es mir so vor, als ignorierten mich alle.","tr":{"en":"Sometimes, I feel like everyone is ignoring me.","ru":"Иногда мне кажется, что меня все игнорируют."}}],"ignoriere":[{"id":7466880,"text":"Ich ignoriere dich nicht.","tr":{"en":"I'm not ignoring you.","ru":"Я тебя не игнорирую.","uk":"Я тебе не ігнорую."}},{"id":3263665,"text":"Ich ignoriere Tom einfach.","tr":{"en":"I just ignore Tom.","ru":"Я просто игнорирую Тома.","uk":"Я просто ігнорую Тома."}}],"ignoriert":[{"id":398882,"text":"Sie hat alle meine Warnungen ignoriert.","tr":{"en":"She ignored all my warnings.","ru":"Она игнорировала все мои предупреждения.","uk":"Вона проігнорувала всі мої попередження."}},{"id":1556986,"text":"Ich bin es gewohnt, von meinen Eltern ignoriert zu werden.","tr":{"en":"I'm used to being ignored by my parents.","ru":"Я привык к невниманию моих родителей.","uk":"Я звик до того, що батьки мене ігнорують."}},{"id":1184233,"text":"Tatsachen hören nicht auf zu existieren, wenn man sie ignoriert.","tr":{"en":"Facts do not cease to exist because they are ignored.","ru":"Факты не перестают существовать от того, что ими пренебрегают.","uk":"Факти не зникають через те, що їх ігнорують."}},{"id":6614814,"text":"Wir haben Tom ignoriert.","tr":{"en":"We ignored Tom.","ru":"Мы не обратили на Тома внимания."}},{"id":2768737,"text":"Tom ignoriert dich nicht.","tr":{"en":"Tom isn't ignoring you.","ru":"Том тебя не игнорирует."}}],"Ignoranz":[{"id":723950,"text":"Du solltest dich deiner Ignoranz schämen.","tr":{"en":"You should be ashamed of your ignorance.","ru":"Ты должна стыдиться собственного невежества.","uk":"Тобі має бути соромно за твоє невігластво."}},{"id":573962,"text":"Er sollte sich seiner Ignoranz schämen.","tr":{"en":"He ought to be ashamed of his ignorance."}}],"Ignorier":[{"id":4659732,"text":"Ignorier Tom.","tr":{"en":"Ignore Tom.","ru":"Не обращай на Тома внимания."}},{"id":8597848,"text":"Ignorier das.","tr":{"en":"Ignore that.","ru":"Не обращай внимания."}},{"id":2230600,"text":"Ignorier es einfach!","tr":{"en":"Just ignore it.","ru":"Просто не обращай внимания!"}},{"id":6615588,"text":"Ignorier Tom einfach.","tr":{"en":"Just ignore Tom.","ru":"Просто не обращай на Тома внимания."}}],"ig":[{"id":12406888,"text":"Da hast du 100%ig recht.","tr":{"en":"You're 100% correct about that.","ru":"В этом ты на сто процентов прав."}}],"ignorierst":[{"id":9134193,"text":"Warum ignorierst du mich?","tr":{"en":"Why do you ignore me?","ru":"Почему вы меня игнорируете?"}},{"id":9134193,"text":"Warum ignorierst du mich?","tr":{"en":"Why are you ignoring me?","ru":"Почему вы меня игнорируете?"}},{"id":8627380,"text":"Ich schlage vor, dass du Tom ignorierst.","tr":{"en":"I suggest that you ignore Tom.","ru":"Предлагаю тебе не обращать на Тома внимания."}},{"id":9134193,"text":"Warum ignorierst du mich?","tr":{"en":"Why have you been ignoring me?"}},{"id":2342191,"text":"Wenn du weiterhin die Clubregeln ignorierst, wird man dich rausschmeißen.","tr":{"en":"If you keep breaking the club rules, you'll get thrown out."}}],"Iglu":[{"id":8622104,"text":"Tom baute im Garten ein Iglu.","tr":{"en":"Tom built an igloo in his backyard.","ru":"Том соорудил у себя на заднем дворе иглу."}}],"Igitt":[{"id":8879325,"text":"Igitt! In der Suppe schwimmt ein Haar!","tr":{"en":"Yuck, there's a hair floating in the soup.","ru":"Фу, в супе волос плавает."}}],"ige":[{"id":7824599,"text":"Tom bekam eine 30%ige Gehaltserhöhung.","tr":{"en":"Tom got a 30% pay raise."}},{"id":7824599,"text":"Tom bekam eine 30%ige Gehaltserhöhung.","tr":{"en":"Tom got a thirty percent pay raise."}}]}