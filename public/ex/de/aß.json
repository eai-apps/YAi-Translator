{"aß":[{"id":1496800,"text":"Tom aß allein.","tr":{"en":"Tom ate alone.","ru":"Том ел один.","uk":"Том їв сам."}},{"id":631487,"text":"Ich aß den Käse.","tr":{"en":"I ate the cheese.","ru":"Я съел сыр.","uk":"Я з'їв сир."}},{"id":7592128,"text":"Tom aß den Apfel.","tr":{"en":"Tom ate the apple.","ru":"Том съел яблоко.","uk":"Том яблуко з'їв."}},{"id":7369714,"text":"Niemand aß etwas.","tr":{"en":"No one ate anything.","ru":"Никто ничего не ел.","uk":"Ніхто нічого не їв."}},{"id":640937,"text":"Sie aß kaum etwas.","tr":{"en":"She hardly ate anything.","ru":"Она почти ничего не съела.","uk":"Вона майже нічого не з'їла."}}],"aßen":[{"id":7413696,"text":"Wir aßen zu Mittag.","tr":{"en":"We had lunch.","ru":"Мы пообедали.","uk":"Ми пообідали."}},{"id":7413692,"text":"Wir aßen Frühstück.","tr":{"en":"We had breakfast.","ru":"Мы позавтракали.","uk":"Ми поснідали."}},{"id":1935283,"text":"Wir aßen Schildkrötensuppe.","tr":{"en":"We ate some turtle soup.","ru":"Мы поели черепахового супа.","uk":"Ми поїли черепахового супу."}},{"id":2794064,"text":"Sie aßen zusammen zu Mittag.","tr":{"en":"They ate lunch together.","ru":"Они обедали вместе.","uk":"Вони пообідали разом."}},{"id":9842700,"text":"Wir aßen Räucherlachs.","tr":{"en":"We ate smoked salmon.","ru":"Мы ели копчёного лосося."}}]}