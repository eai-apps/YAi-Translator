{"ghosts":[{"id":5420071,"text":"Are ghosts real?","tr":{"de":"Sind Geister real?","ru":"Привидения существуют?","uk":"Привиди існують?"}},{"id":324444,"text":"Do ghosts really exist?","tr":{"de":"Gibt es wirklich Geister?","ru":"Привидения правда существуют?","uk":"Привиди насправді існують?"}},{"id":1164501,"text":"Tom is scared of ghosts.","tr":{"de":"Tom fürchtet sich vor Gespenstern.","ru":"Том боится привидений.","uk":"Том боїться привидів."}},{"id":63212,"text":"Do you believe in ghosts?","tr":{"de":"Glaubst du an Gespenster?","ru":"Верите ли Вы в привидения?","uk":"Ти віриш у привидів?"}},{"id":2545359,"text":"I'm not afraid of ghosts.","tr":{"de":"Ich habe keine Angst vor Geistern.","ru":"Я не боюсь привидений.","uk":"Я не боюся привидів."}}],"ghost":[{"id":1841748,"text":"Are you a ghost?","tr":{"de":"Bist du ein Geist?","ru":"Ты привидение?","uk":"Ти привид?"}},{"id":1488471,"text":"Tom saw a ghost.","tr":{"de":"Tom sah einen Geist.","ru":"Том увидел привидение.","uk":"Том побачив привида."}},{"id":280727,"text":"The ghost vanished suddenly.","tr":{"de":"Der Geist verschwand plötzlich.","ru":"Привидение внезапно исчезло.","uk":"Привид раптово зник."}},{"id":1177611,"text":"Tom says he has actually seen a ghost.","tr":{"de":"Tom sagt, dass er wirklich einen Geist gesehen hat.","ru":"Том говорит, что он действительно видел привидение.","uk":"Том каже, що він насправді бачив привида."}},{"id":11040564,"text":"I'm not a ghost.","tr":{"de":"Ich bin kein Gespenst.","ru":"Я не призрак."}}],"ghetto":[{"id":5276569,"text":"Tom grew up in the ghetto.","tr":{"de":"Tom ist im Ghetto aufgewachsen.","ru":"Том вырос в гетто.","uk":"Том виріс у гето."}}],"ghostwriter":[{"id":845900,"text":"He's a ghostwriter.","tr":{"de":"Er ist Phantomschreiber.","ru":"Он литературный негр."}},{"id":5420285,"text":"Tom is a ghostwriter.","tr":{"ru":"Том — литературный негр."}}]}