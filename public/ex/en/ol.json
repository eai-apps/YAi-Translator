{"old":[{"id":1924560,"text":"I'm old.","tr":{"de":"Ich bin alt.","ru":"Я старый.","uk":"Я стара."}},{"id":9079981,"text":"We're old.","tr":{"de":"Wir sind alt.","ru":"Мы старые.","uk":"Ми старі."}},{"id":1430734,"text":"I feel old.","tr":{"de":"Ich fühle mich alt.","ru":"Я чувствую себя старым.","uk":"Я почуваюся старим."}},{"id":1335485,"text":"She is old.","tr":{"de":"Sie ist alt.","ru":"Она стара.","uk":"Вона стара."}},{"id":2203138,"text":"Tom is old.","tr":{"de":"Tom ist alt.","ru":"Том старый.","uk":"Том старий."}}],"older":[{"id":2111149,"text":"Tom's older.","tr":{"de":"Tom ist älter.","ru":"Том старше.","uk":"Том старший."}},{"id":311827,"text":"She's older than Tom.","tr":{"de":"Sie ist älter als Tom.","ru":"Она старше Тома.","uk":"Вона старша від Тома."}},{"id":887619,"text":"She's older than him.","tr":{"de":"Sie ist älter als er.","ru":"Она старше него.","uk":"Вона старша, ніж він."}},{"id":482368,"text":"Mom is older than Dad.","tr":{"de":"Mama ist älter als Papa.","ru":"Мама старше папы.","uk":"Мама старша за тата."}},{"id":469125,"text":"She's my older sister.","tr":{"de":"Sie ist meine ältere Schwester.","ru":"Это моя старшая сестра.","uk":"Вона моя старша сестра."}}],"olives":[{"id":8173671,"text":"Tom likes olives.","tr":{"de":"Tom mag Oliven.","ru":"Том любит маслины.","uk":"Том полюбляє оливки."}},{"id":2244679,"text":"Tom hates olives.","tr":{"de":"Tom hasst Oliven."}},{"id":8928896,"text":"Do you like olives?","tr":{"de":"Magst du Oliven?"}},{"id":2649864,"text":"I'm very fond of olives.","tr":{"ru":"Я очень люблю маслины."}},{"id":9524364,"text":"Tom doesn't like olives.","tr":{"ru":"Том не любит маслины."}}],"oldest":[{"id":2273551,"text":"Tom is the oldest.","tr":{"de":"Tom ist der Älteste.","ru":"Том самый старший.","uk":"Том найстарший."}},{"id":593283,"text":"He's the oldest son.","tr":{"de":"Er ist der älteste Sohn.","ru":"Он старший сын.","uk":"Він найстарший син."}},{"id":3921461,"text":"Tom is our oldest son.","tr":{"de":"Tom ist unser ältester Sohn.","ru":"Том — наш старший сын.","uk":"Том — наш старший син."}},{"id":5054921,"text":"Tom is Mary's oldest son.","tr":{"de":"Tom ist Marias Jüngster.","ru":"Том — старший сын Мэри.","uk":"Том — старший син Мері."}},{"id":467969,"text":"How old is your oldest son?","tr":{"de":"Wie alt ist dein ältester Sohn?","ru":"Сколько лет вашему старшему сыну?","uk":"Скільки років твоєму найстаршому сину?"}}],"olympics":[{"id":1756816,"text":"He's watching the Olympics.","tr":{"de":"Er sieht sich die Olympischen Spiele an.","ru":"Он смотрит Олимпиаду.","uk":"Він дивиться Олімпійські ігри"}},{"id":1669532,"text":"Will you watch the Olympics?","tr":{"de":"Siehst du dir die Olympischen Spiele an?","ru":"Ты будешь смотреть Олимпийские игры?"}},{"id":7117836,"text":"Tom is watching the Olympics.","tr":{"ru":"Том смотрит Олимпийские игры.","uk":"Том дивиться Олімпіаду."}},{"id":7790183,"text":"I missed the opening ceremony of the Olympics.","tr":{"de":"Ich habe die Eröffnung der Olympischen Spiele verpasst.","ru":"Я пропустил церемонию открытия Олимпийских игр."}},{"id":51811,"text":"Spain is the host country for the Olympics in 1992.","tr":{"de":"Spanien ist 1992 Veranstalter der olympischen Spiele.","ru":"Испания принимала Олимпийские игры 1992 года."}}],"olive":[{"id":8962729,"text":"This is olive oil.","tr":{"de":"Das ist Olivenöl.","ru":"Это оливковое масло."}},{"id":8966648,"text":"It's an olive tree.","tr":{"de":"Das ist ein Olivenbaum.","ru":"Это олива."}},{"id":9145529,"text":"My cat ate an olive.","tr":{"de":"Meine Katze fraß eine Olive.","ru":"Моя кошка съела маслину."}},{"id":8173453,"text":"Tom likes olive oil.","tr":{"de":"Tom mag Olivenöl.","ru":"Том любит оливковое масло."}},{"id":8966647,"text":"That's an olive tree.","tr":{"de":"Das ist ein Olivenbaum.","ru":"Это олива."}}],"olympic":[{"id":3921516,"text":"Tom was an Olympic swimmer.","tr":{"de":"Tom war Schwimmer bei den Olympischen Spielen","ru":"Том был олимпийским пловцом."}},{"id":289443,"text":"He took part in the Olympic Games.","tr":{"de":"Er hat an den Olympischen Spielen teilgenommen.","ru":"Он принял участие в Олимпийских играх."}},{"id":305546,"text":"They want to take part in the Olympic Games.","tr":{"de":"Sie wollen an den Olympischen Spielen teilnehmen.","ru":"Они хотят участвовать в Олимпийских играх."}},{"id":2394076,"text":"The Olympic Games take place every four years.","tr":{"de":"Die Olympischen Spiele finden alle vier Jahre einmal statt.","ru":"Олимпийские игры проводятся один раз в четыре года."}},{"id":305547,"text":"They want to participate in the Olympic Games.","tr":{"de":"Sie wollen an den Olympischen Spielen teilnehmen.","ru":"Они хотят принять участие в Олимпийских играх."}}],"oldies":[{"id":906833,"text":"What's your favorite oldies song?","tr":{"de":"Was ist Dein Lieblings-Oldie?"}}]}