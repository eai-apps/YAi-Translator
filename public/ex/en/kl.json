{"klutz":[{"id":2549302,"text":"I'm such a klutz.","tr":{"de":"Ich bin so ein Tollpatsch.","ru":"Я такой неуклюжий.","uk":"Я такий недотепа."}},{"id":2722458,"text":"I'm a klutz.","tr":{"de":"Ich bin ein Tollpatsch.","ru":"Я недотёпа."}},{"id":2549677,"text":"Tom's a klutz.","tr":{"ru":"Том — недотёпа."}},{"id":3326663,"text":"Tom is a klutz.","tr":{"uk":"Том — тюхтій."}}],"kleptomaniac":[{"id":3439754,"text":"Tom is a kleptomaniac.","tr":{"de":"Tom ist ein Kleptomane.","ru":"Том - клептоман."}},{"id":3333526,"text":"My neighbor is a kleptomaniac.","tr":{"de":"Mein Nachbar ist Kleptomane.","ru":"Мой сосед клептоман."}}],"klingon":[{"id":509723,"text":"Esperanto, Ido, Interlingua, Klingon, Lojban, Na'vi and Volapük are constructed languages.","tr":{"de":"Esperanto, Ido, Interlingua, Klingonisch, Lojban, Na'vi und Volapük sind konstruierte Sprachen.","ru":"Эсперанто, идо, интерлингва, клингонский язык, ложбан, на'ви и волапюк - сконструированные языки."}}],"klan":[{"id":807156,"text":"The Klan often terrorized blacks.","tr":{"ru":"Клан часто терроризировал чёрных."}}]}