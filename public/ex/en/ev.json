{"even":[{"id":1013826,"text":"We're even.","tr":{"de":"Wir sind quitt.","ru":"Мы квиты.","uk":"Ми квити."}},{"id":6440630,"text":"Even Tom lied.","tr":{"de":"Sogar Tom hat gelogen.","ru":"Даже Том лгал.","uk":"Брехав навіть Том."}},{"id":6358370,"text":"Even I can sing.","tr":{"de":"Selbst ich kann singen.","ru":"Даже я умею петь.","uk":"Навіть я вмію співати."}},{"id":478583,"text":"Do you even care?","tr":{"de":"Ist dir das egal?","ru":"Тебя это вообще волнует?","uk":"А тобі не все одно?"}},{"id":1702671,"text":"Even my mom knows.","tr":{"de":"Sogar meine Mutti weiß davon.","ru":"Даже моя мама знает.","uk":"Навіть моя мама знає."}}],"evil":[{"id":1520737,"text":"Tom is evil.","tr":{"de":"Tom ist böse.","ru":"Том злой.","uk":"Том злий."}},{"id":7067354,"text":"Tom is an evil genius.","tr":{"de":"Tom ist ein Genie des Bösen.","ru":"Том - злой гений.","uk":"Том - злий геній."}},{"id":6076676,"text":"Work is a necessary evil.","tr":{"de":"Arbeit ist ein notwendiges Übel.","ru":"Работа - необходимое зло.","uk":"Робота — це необхідне зло."}},{"id":18505,"text":"Money is the root of all evil.","tr":{"de":"Geld ist der Ursprung allen Übels.","ru":"Деньги - корень всех зол.","uk":"Гроші — корінь зла."}},{"id":4908425,"text":"Tom doesn't know the difference between good and evil.","tr":{"de":"Tom kennt den Unterschied zwischen Gut und Böse nicht.","ru":"Том не знает разницы между добром и злом.","uk":"Том не знає різниці між добром і злом."}}],"evening":[{"id":333156,"text":"Good evening.","tr":{"de":"Guten Abend!","ru":"Добрый вечер!","uk":"Доброго вечора!"}},{"id":7118028,"text":"Good evening, Tom.","tr":{"de":"Guten Abend, Tom.","ru":"Добрый вечер, Том.","uk":"Доброго вечора, Томе."}},{"id":243271,"text":"Call me this evening.","tr":{"de":"Ruft mich heute Abend an.","ru":"Позвоните мне сегодня вечером.","uk":"Зателефонуйте мені сьогодні ввечері."}},{"id":4368253,"text":"I'm free this evening.","tr":{"de":"Ich habe heute Abend Zeit.","ru":"Сегодня вечером я свободен.","uk":"Сьогодні ввечері я вільний."}},{"id":1871028,"text":"Call them this evening.","tr":{"de":"Ruf sie heute Abend an.","ru":"Позвоните им сегодня вечером.","uk":"Зателефонуй їм сьогодні ввечері."}}],"everyone":[{"id":1520383,"text":"Everyone wins.","tr":{"de":"Alle gewinnen.","ru":"Все выигрывают.","uk":"Виграють усі."}},{"id":5521184,"text":"Everyone knows.","tr":{"de":"Alle wissen es.","ru":"Все знают.","uk":"Усі знають."}},{"id":4401090,"text":"Everyone agreed.","tr":{"de":"Alle waren sich einig.","ru":"Все согласились.","uk":"Усі погодилися."}},{"id":2111871,"text":"Everyone looked.","tr":{"de":"Alle schauten.","ru":"Все посмотрели.","uk":"Усі подивилися."}},{"id":2111870,"text":"Everyone prayed.","tr":{"de":"Alle beteten.","ru":"Все молились.","uk":"Всі молилися."}}],"everybody":[{"id":3924471,"text":"Hi, everybody.","tr":{"de":"Hallo an alle.","ru":"Всем привет.","uk":"Всім привіт!"}},{"id":4011391,"text":"Everybody dies.","tr":{"de":"Jeder muss sterben.","ru":"Все умирают.","uk":"Всі помирають."}},{"id":2111884,"text":"Everybody left.","tr":{"de":"Alle gingen.","ru":"Все ушли.","uk":"Усі пішли."}},{"id":2111883,"text":"Everybody paid.","tr":{"de":"Alle bezahlten.","ru":"Все заплатили.","uk":"Всі заплатили."}},{"id":2111476,"text":"Tell everybody.","tr":{"de":"Sag es allen.","ru":"Скажи всем.","uk":"Розкажи всім."}}],"everything":[{"id":273828,"text":"Eat everything.","tr":{"de":"Iss alles.","ru":"Ешь всё.","uk":"Їж все."}},{"id":2111845,"text":"Everything's OK.","tr":{"de":"Es ist alles in Ordnung.","ru":"Всё хорошо.","uk":"Все гаразд."}},{"id":51793,"text":"Everything is OK.","tr":{"de":"Alles ist gut.","ru":"Всё в порядке.","uk":"Все гаразд."}},{"id":2100009,"text":"I eat everything.","tr":{"de":"Ich esse alles.","ru":"Я ем всё.","uk":"Я їм все."}},{"id":2111627,"text":"Leave everything.","tr":{"de":"Lassen Sie alles zurück.","ru":"Оставь всё.","uk":"Залиши все."}}],"every":[{"id":2768921,"text":"I cry every day.","tr":{"de":"Ich weine jeden Tag.","ru":"Я каждый день плачу.","uk":"Я плачу кожного дня."}},{"id":322472,"text":"I go every year.","tr":{"de":"Ich gehe jedes Jahr.","ru":"Я хожу каждый год.","uk":"Я кожного року ходжу."}},{"id":261849,"text":"I run every day.","tr":{"de":"Ich laufe jeden Tag.","ru":"Я бегаю каждый день.","uk":"Я роблю пробіжки щоденно."}},{"id":261832,"text":"I swim every day.","tr":{"de":"Ich schwimme jeden Tag.","ru":"Я плаваю каждый день.","uk":"Я плаваю щодня."}},{"id":261858,"text":"I walk every day.","tr":{"de":"Ich gehe jeden Tag zu Fuß.","ru":"Я хожу пешком каждый день.","uk":"Я ходжу пішки кожного дня."}}],"evidence":[{"id":2246003,"text":"I need evidence.","tr":{"de":"Ich brauche Beweise.","ru":"Мне нужны доказательства.","uk":"Мені потрібні докази."}},{"id":1893763,"text":"We need evidence.","tr":{"de":"Wir brauchen Beweise.","ru":"Нам нужны доказательства.","uk":"Нам потрібні докази."}},{"id":2248379,"text":"I've got evidence.","tr":{"de":"Ich habe Beweise.","ru":"У меня есть доказательство.","uk":"Я маю докази."}},{"id":2236291,"text":"Tom found evidence.","tr":{"de":"Tom hat Beweise gefunden.","ru":"Том нашёл улики.","uk":"Том знайшов докази."}},{"id":268221,"text":"There's no evidence.","tr":{"de":"Es gibt keinen Beweis.","ru":"Этому нет доказательств.","uk":"Доказів немає."}}],"ever":[{"id":2755313,"text":"Did you ever try?","tr":{"de":"Hast du es jemals versucht?","ru":"Ты когда-нибудь пробовал?","uk":"Ви коли-небудь намагались?"}},{"id":4498109,"text":"Do you ever rest?","tr":{"de":"Ruhst du dich jemals aus?","ru":"Ты вообще отдыхаешь?","uk":"Ти коли-небудь відпочиваєш?"}},{"id":2119428,"text":"Don't ever give up.","tr":{"de":"Gib nie auf!","ru":"Никогда не сдавайся.","uk":"Ніколи не здавайся."}},{"id":3409223,"text":"Does Tom ever smile?","tr":{"de":"Lächelt Tom jemals?","ru":"Том когда-нибудь улыбается?","uk":"Том коли-небудь посміхається?"}},{"id":2270366,"text":"Don't ever come back.","tr":{"de":"Kommt nie mehr zurück!","ru":"Никогда не возвращайся.","uk":"Ніколи не повертайся."}}],"evicted":[{"id":2978831,"text":"I've been evicted.","tr":{"de":"Ich bin vertrieben worden.","ru":"Меня выгнали.","uk":"Мене виселили."}},{"id":2150410,"text":"He's in danger of being evicted.","tr":{"de":"Ihm droht eine Zwangsräumung.","ru":"Он находится под угрозой выселения."}},{"id":10289773,"text":"Tom got evicted.","tr":{"ru":"Тома выселили."}},{"id":7538383,"text":"Tom was evicted.","tr":{"ru":"Тома выселили."}},{"id":8936637,"text":"Tom wasn't evicted.","tr":{"ru":"Том не был выселен."}}],"everywhere":[{"id":2245953,"text":"I looked everywhere.","tr":{"de":"Ich habe überall nachgesehen.","ru":"Я везде смотрел.","uk":"Я скрізь дивився."}},{"id":2245653,"text":"I checked everywhere.","tr":{"de":"Ich habe überall nachgesehen.","ru":"Я везде проверил.","uk":"Я скрізь перевірив."}},{"id":2241147,"text":"We looked everywhere.","tr":{"de":"Wir haben überall gesucht.","ru":"Мы искали везде.","uk":"Ми шукали скрізь."}},{"id":4494516,"text":"Garbage was everywhere.","tr":{"de":"Überall war Müll.","ru":"Повсюду был мусор.","uk":"Сміття було всюди."}},{"id":2241442,"text":"We searched everywhere.","tr":{"de":"Wir haben überall gesucht.","ru":"Мы искали всюду.","uk":"Ми скрізь шукали."}}],"event":[{"id":816875,"text":"I postponed the event.","tr":{"de":"Ich verschob die Veranstaltung.","ru":"Я отложил мероприятие.","uk":"Я відклав цю подію."}},{"id":65922,"text":"We postponed the event.","tr":{"de":"Wir verschoben die Veranstaltung.","ru":"Мы отложили это событие.","uk":"Ми відклали вечірку."}},{"id":55578,"text":"This is an important event.","tr":{"de":"Dies ist ein wichtiges Ereignis.","ru":"Это важное событие.","uk":"Це важлива подія."}},{"id":7590561,"text":"It's a religious event.","tr":{"de":"Es ist ein religiöses Ereignis.","ru":"Это религиозное событие."}},{"id":5509219,"text":"The event is on Monday.","tr":{"ru":"Мероприятие состоится в понедельник.","uk":"Захід відбудеться в понеділок."}}],"eve":[{"id":2718489,"text":"December 24th is Christmas Eve.","tr":{"de":"Am 24. Dezember ist Heiligabend.","ru":"24 декабря - сочельник.","uk":"24 грудня — канун Різдва."}},{"id":809841,"text":"The serpent tempted Eve.","tr":{"de":"Die Schlange versuchte Eva.","ru":"Змей искушал Еву."}},{"id":1347073,"text":"They got married on Christmas Eve.","tr":{"de":"Sie heirateten am Heiligen Abend.","ru":"Они поженились в рождественский сочельник."}},{"id":5679200,"text":"Tom and Mary got married on Christmas Eve.","tr":{"de":"Tom und Maria heirateten am Heiligen Abend.","ru":"Том и Мэри поженились в Сочельник."}},{"id":6584877,"text":"Tom and Mary celebrated New Year's Eve together.","tr":{"de":"Tom und Maria feierten zusammen Silvester.","ru":"Том и Мария провели новогоднюю ночь вместе."}}],"eventually":[{"id":1476039,"text":"Eventually, he changed his mind.","tr":{"de":"Schließlich hat er es sich anders überlegt.","ru":"В итоге он передумал.","uk":"Він, врешті-решт, передумав."}},{"id":2958724,"text":"Tom will forgive you eventually.","tr":{"de":"Letztlich wird Tom dir vergeben.","ru":"Том со временем тебя простит.","uk":"Том із часом тебе пробачить."}},{"id":4663968,"text":"Tom eventually became Mary's husband.","tr":{"de":"Tom wurde schließlich Marias Ehegatte.","ru":"В конце концов, Том стал мужем Мэри.","uk":"Врешті-решт, Том став чоловіком Мері."}},{"id":5958373,"text":"I eventually agreed.","tr":{"de":"Ich willigte schließlich ein.","ru":"В конце концов я согласился."}},{"id":4495541,"text":"Tom eventually agreed.","tr":{"ru":"Том в конце концов согласился.","uk":"Том врешті-решт погодився."}}],"evolution":[{"id":1876171,"text":"He does not believe in evolution.","tr":{"de":"Er glaubt nicht an Evolution.","ru":"Он не верит в эволюцию.","uk":"Він не вірить в еволюцію."}},{"id":3513584,"text":"Do you believe in evolution?","tr":{"ru":"Ты веришь в эволюцию?","uk":"Ти віриш у еволюцію?"}},{"id":2481724,"text":"Tom doesn't believe in evolution.","tr":{"ru":"Том не верит в эволюцию.","uk":"Том не вірить у еволюцію."}},{"id":862971,"text":"We associate Darwin's name with the theory of evolution.","tr":{"de":"Wir verbinden den Namen Darwin mit der Evolutionstheorie.","ru":"Мы связываем имя Дарвина с теорией эволюции."}},{"id":262804,"text":"We associate the name of Darwin with the theory of evolution.","tr":{"de":"Wir verbinden den Namen Darwin mit der Evolutionstheorie.","ru":"Мы связываем имя Дарвина с теорией эволюции."}}],"evident":[{"id":17928,"text":"It's evident that you told a lie.","tr":{"de":"Es ist offensichtlich, dass du gelogen hast.","ru":"Ты явно соврал.","uk":"Очевидно, що ти збрехав."}},{"id":5486517,"text":"That's self-evident.","tr":{"de":"Das ist eine Binsenwahrheit.","ru":"Это само собой разумеется."}},{"id":284336,"text":"It's evident to everybody that he's in love.","tr":{"de":"Es ist für jeden offensichtlich, dass er verliebt ist.","uk":"Всім очевидно, що він закоханий."}},{"id":284207,"text":"It was evident to all of us that he was innocent.","tr":{"de":"Für uns alle war es offensichtlich, dass er unschuldig war.","ru":"Нам всем было очевидно, что он невиновен."}},{"id":2187256,"text":"That's evident.","tr":{"de":"Das ist offensichtlich."}}],"evacuated":[{"id":275765,"text":"The people were evacuated because of the flood.","tr":{"de":"Die Menschen wurden wegen des Hochwassers evakuiert.","ru":"Людей эвакуировали из-за потопа.","uk":"Людей евакуювали із-за потопу."}},{"id":4494346,"text":"The hotel was evacuated.","tr":{"de":"Das Hotel wurde evakuiert.","ru":"Отель был эвакуирован."}},{"id":5364147,"text":"The building has been evacuated.","tr":{"de":"Das Gebäude ist evakuiert worden.","ru":"Здание было эвакуировано."}},{"id":4494864,"text":"They were evacuated.","tr":{"ru":"Они были эвакуированы."}},{"id":2252739,"text":"They're being evacuated.","tr":{"ru":"Их эвакуируют."}}],"evenly":[{"id":50589,"text":"The money will probably be split evenly between those two.","tr":{"de":"Das Geld wird wohl gleichmäßig zwischen den beiden aufgeteilt werden.","ru":"Видимо, деньги будут поделены поровну между ними двумя.","uk":"Гроші мабуть буде розділено порівну між тими двома."}},{"id":2267747,"text":"Spread the sand evenly.","tr":{"de":"Verteile den Sand gleichmäßig!","ru":"Распределите песок равномерно."}},{"id":6570587,"text":"Inhale and exhale evenly through your nose.","tr":{"de":"Gleichmäßig durch die Nase ein- und wieder ausatmen!","ru":"Равномерно вдыхайте и выдыхайте через нос."}},{"id":11455817,"text":"Tom and I split the rent evenly.","tr":{"ru":"Мы с Томом платим за квартиру пополам."}},{"id":4488244,"text":"We shared the money evenly among the three of us.","tr":{"de":"Wir haben das Geld zu gleichen Teilen unter uns dreien aufgeteilt."}}],"evasive":[{"id":1524766,"text":"Tom was evasive.","tr":{"de":"Tom war ausweichend.","ru":"Том был уклончив."}},{"id":2218099,"text":"You're being evasive.","tr":{"de":"Du weichst mir aus.","ru":"Ты меня избегаешь."}},{"id":4627132,"text":"Tom's reply was evasive.","tr":{"de":"Toms Antwort war ausweichend.","ru":"Ответ Тома был уклончив."}},{"id":4529659,"text":"Tom's answer was very evasive.","tr":{"de":"Toms Antwort war äußerst vage.","ru":"Ответ Тома был очень уклончивым."}},{"id":5851131,"text":"I tried to be evasive.","tr":{"uk":"Я намагався уникати прямої відповіді."}}],"evacuate":[{"id":2249825,"text":"Prepare to evacuate.","tr":{"ru":"Приготовьтесь к эвакуации.","uk":"Приготуйтеся до евакуації."}},{"id":3310202,"text":"We've got to evacuate.","tr":{"ru":"Нам надо эвакуироваться."}},{"id":4016049,"text":"There's still time to evacuate.","tr":{"de":"Noch ist Zeit für eine Evakuierung."}},{"id":3312372,"text":"We have to evacuate immediately.","tr":{"ru":"Мы должны немедленно эвакуироваться."}},{"id":5553956,"text":"We have to evacuate the building.","tr":{"ru":"Нам надо эвакуировать здание."}}],"evidently":[{"id":5589580,"text":"Tom is evidently sick.","tr":{"de":"Tom ist offensichtlich krank.","ru":"Том явно болен."}},{"id":11129763,"text":"She's evidently sick.","tr":{"ru":"Она явно больна."}},{"id":6033291,"text":"Evidently, that's a crime.","tr":{"uk":"Очевидно, це злочин."}},{"id":7132412,"text":"Evidently, Tom wasn't interested.","tr":{"ru":"Очевидно, Тому было не интересно."}},{"id":6530123,"text":"Evidently, Tom didn't have to go.","tr":{"uk":"Очевидно, Том не повинен був іти."}}],"events":[{"id":680853,"text":"Tom loves sports events.","tr":{"de":"Tom liebt Sportveranstaltungen.","ru":"Том любит спортивные мероприятия."}},{"id":9096852,"text":"Are these events connected?","tr":{"de":"Stehen diese Ereignisse in Zusammenhang?","ru":"Эти события как-то связаны?"}},{"id":1351011,"text":"Tell me your version of the events.","tr":{"de":"Erzählen Sie mir Ihre Version der Ereignisse.","ru":"Расскажи мне свою версию событий."}},{"id":57257,"text":"This story is based on actual events.","tr":{"de":"Diese Geschichte basiert auf wahren Begebenheiten.","ru":"Эта история основана на реальных событиях."}},{"id":5559561,"text":"This story was inspired by true events.","tr":{"de":"Diese Geschichte beruht auf wahren Begebenheiten.","ru":"Эта история была основана на реальных событиях."}}],"evade":[{"id":2270358,"text":"Don't evade the question.","tr":{"de":"Weiche der Frage nicht aus!","ru":"Не уходи от вопроса."}},{"id":12331394,"text":"The fog helped me evade my pursuers.","tr":{"ru":"Туман помог мне скрыться от преследователей."}}],"evenings":[{"id":6855529,"text":"The evenings can be chilly.","tr":{"ru":"По вечерам бывает прохладно.","uk":"Вечори можуть бути прохолодні."}},{"id":6796397,"text":"What do you do in the evenings?","tr":{"de":"Was tust du des Abends?","ru":"Что ты делаешь по вечерам?"}},{"id":2641571,"text":"Where do you go on Monday evenings?","tr":{"de":"Wo gehst du montags abends hin?","ru":"Куда вы ходите в понедельник вечером?"}},{"id":1756913,"text":"He spends his evenings in front of his laptop.","tr":{"de":"Er verbringt seine Abende vor seinem Klapprechner.","ru":"Он проводит вечера перед ноутбуком."}},{"id":7112104,"text":"I look forward to Monday evenings.","tr":{"de":"Ich freue mich auf die Montagabende."}}],"evolved":[{"id":3494835,"text":"Birds evolved from dinosaurs.","tr":{"de":"Vögel stammen von Dinosauriern ab.","ru":"Птицы развились из динозавров."}},{"id":55150,"text":"These creatures evolved from simpler organisms like jellyfish.","tr":{"de":"Diese Lebewesen stammen von niederen Organismen wie Quallen ab.","ru":"Эти существа произошли от более простых организмов, таких как медузы."}},{"id":36323,"text":"Why have the apes evolved more than other animals?","tr":{"uk":"Чому людиноподібні мавпи еволюціонували більше, ніж інші тварини?"}}],"evils":[{"id":2145467,"text":"Choose the lesser of two evils.","tr":{"de":"Wähle von zwei Übeln das geringere!","ru":"Из двух зол выбери наименьшее."}},{"id":631008,"text":"We chose the lesser of the two evils.","tr":{"de":"Wir wählten das kleinere Übel."}}],"eviction":[{"id":328753,"text":"We received an eviction notice.","tr":{"de":"Wir haben einen Räumungsbescheid erhalten.","ru":"Мы получили уведомление о выселении."}}],"evolutionary":[{"id":820566,"text":"Darwin developed the evolutionary theory.","tr":{"de":"Darwin entwickelte die Evolutionstheorie.","ru":"Дарвин развил теорию эволюции."}}],"everest":[{"id":10193698,"text":"Mount Everest is located in the Himalayas.","tr":{"de":"Der Everest befindet sich im Himalaya.","ru":"Гора Эверест находится в Гималаях."}},{"id":40430,"text":"Do you know who conquered Mt. Everest first?","tr":{"de":"Weißt du, wer als Erster den Mount Everest bezwungen hat?","ru":"Ты знаешь, кто первым покорил Эверест?"}},{"id":289386,"text":"He was the first man that climbed Mount Everest.","tr":{"de":"Er war der erste Mann, der den Mount Everest bestieg.","ru":"Он был первым, кто поднялся на Эверест."}},{"id":65301,"text":"Mt. Everest is the highest mountain in the world.","tr":{"de":"Der Mt. Everest ist der höchste Berg der Welt.","ru":"Гора Эверест — высочайшая в мире."}},{"id":10099902,"text":"Mt. Everest is the tallest mountain in the world.","tr":{"de":"Der Mt. Everest ist der höchste Berg der Welt.","ru":"Эверест - самая высокая гора в мире."}}],"everyday":[{"id":316072,"text":"She wanted to get away from everyday life.","tr":{"de":"Sie wollte dem Alltag entfliehen.","ru":"Она хотела сбежать от повседневности."}},{"id":4422242,"text":"Everyday life can get a bit monotonous at times.","tr":{"de":"Der Alltag kann mitunter etwas eintönig werden.","ru":"Повседневность порою бывает малость однообразной."}},{"id":10803074,"text":"This is an everyday occurrence.","tr":{"ru":"Это повседневное явление."}},{"id":10803072,"text":"This is designed for everyday use.","tr":{"ru":"Предназначено для повседневного использования."}},{"id":10803087,"text":"This isn't an everyday occurrence.","tr":{"ru":"Это нечасто бывает."}}],"evolve":[{"id":1632239,"text":"We did not evolve from monkeys. We share a common ancestor.","tr":{"de":"Wir haben uns nicht aus Affen entwickelt. Wir haben nur einen gemeinsamen Vorfahren mit ihnen.","ru":"Мы не произошли от обезьян, у нас общий предок."}}],"evaluated":[{"id":2236322,"text":"Tom got evaluated.","tr":{"de":"Tom wurde bewertet."}}],"evaporated":[{"id":9960780,"text":"The water evaporated.","tr":{"ru":"Вода испарилась."}},{"id":326328,"text":"The dew evaporated when the sun rose.","tr":{"ru":"Когда солнце поднялось, роса испарилась."}}],"evasively":[{"id":8130939,"text":"Tom answered evasively.","tr":{"ru":"Том ответил уклончиво."}}],"evaded":[{"id":7298739,"text":"Tom evaded the question.","tr":{"de":"Tom wich der Frage aus."}}],"evergreen":[{"id":9505431,"text":"This tree is an evergreen.","tr":{"ru":"Это дерево вечнозелёное."}}],"eventual":[{"id":11149751,"text":"Tom was the eventual winner.","tr":{"de":"Letzten Endes gewann Tom."}}],"evacuation":[{"id":2877927,"text":"Evacuation will be difficult.","tr":{"uk":"Евакуація буде складною."}}],"evolving":[{"id":6774794,"text":"Software is constantly evolving.","tr":{"de":"Software entwickelt sich ständig weiter."}}],"evaporates":[{"id":270934,"text":"Water evaporates when it is heated.","tr":{"ru":"Вода испаряется при нагревании."}}],"evaluate":[{"id":285213,"text":"It's difficult to evaluate his ability.","tr":{"ru":"Его компетентность сложно оценить."}},{"id":18510,"text":"There are many things which we cannot evaluate in terms of money.","tr":{"de":"Es gibt viele Dinge, deren Wert wir nicht in Geld bemessen können."}}],"evasion":[{"id":301372,"text":"He was arrested on charges of tax evasion.","tr":{"ru":"Он был арестован по обвинению в уклонении от уплаты налогов."}}],"evaluation":[{"id":3722505,"text":"I want a full evaluation as soon as possible.","tr":{"ru":"Я хочу полную оценку как можно скорее."}},{"id":9015626,"text":"I'll refer you to a cardiologist for further evaluation.","tr":{"de":"Ich schreibe Ihnen eine Überweisung zum Kardiologen, dass der Sie weiter untersucht."}}]}