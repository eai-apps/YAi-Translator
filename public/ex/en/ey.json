{"eyes":[{"id":417801,"text":"My eyes hurt.","tr":{"de":"Meine Augen schmerzen.","ru":"У меня глаза болят.","uk":"У мене болять очі."}},{"id":323768,"text":"Open your eyes.","tr":{"de":"Öffnen Sie Ihre Augen.","ru":"Откройте глаза.","uk":"Відкрийте очі."}},{"id":1883049,"text":"Shut your eyes.","tr":{"de":"Schließe die Augen!","ru":"Закрой глаза.","uk":"Заплющ очі."}},{"id":323737,"text":"Their eyes met.","tr":{"de":"Ihre Blicke trafen sich.","ru":"Их глаза встретились.","uk":"Їхні погляди зустрілися."}},{"id":3735829,"text":"Wipe your eyes.","tr":{"de":"Wischen Sie sich die Augen.","ru":"Вытри глаза.","uk":"Витри очі."}}],"eye":[{"id":2439688,"text":"I opened one eye.","tr":{"de":"Ich öffnete ein Auge.","ru":"Я открыл один глаз.","uk":"Я розплющив одне око."}},{"id":2692270,"text":"I have a black eye.","tr":{"de":"Ich habe ein blaues Auge.","ru":"У меня синяк под глазом.","uk":"У мене синець під оком."}},{"id":1482706,"text":"Tom has a black eye.","tr":{"de":"Tom hat ein blaues Auge.","ru":"Том ходит с фингалом.","uk":"У Тома синець під оком."}},{"id":303564,"text":"He is blind in one eye.","tr":{"de":"Er ist auf einem Auge blind.","ru":"У него один глаз не видит.","uk":"Він сліпий на одне око."}},{"id":298006,"text":"He looked me in the eye.","tr":{"de":"Er schaute mir in die Augen.","ru":"Он посмотрел мне в глаза.","uk":"Він подивився мені в очі."}}],"eyed":[{"id":5488308,"text":"Tom is cross-eyed.","tr":{"de":"Tom schielt.","ru":"У Тома косоглазие.","uk":"У Тома косоокість."}},{"id":10719009,"text":"Among the blind, the one-eyed man is king.","tr":{"de":"Unter den Blinden ist der Einäugige König.","ru":"В царстве слепых и одноглазый — король."}},{"id":1285644,"text":"In the land of the blind, the one-eyed man is king.","tr":{"de":"Unter Blinden ist der Einäugige König.","ru":"В царстве слепых и одноглазый — король."}},{"id":3730062,"text":"Tom eyed Mary.","tr":{"ru":"Том пристально смотрел на Мэри."}},{"id":8294646,"text":"Tom eyed Mary's plate.","tr":{"de":"Tom beäugte Marias Teller."}}],"eyesight":[{"id":298211,"text":"He has good eyesight.","tr":{"de":"Er hat gute Augen.","ru":"У него хорошее зрение.","uk":"Він має добрий зір."}},{"id":476189,"text":"He lost his eyesight.","tr":{"de":"Er hat das Augenlicht verloren.","ru":"Он потерял зрение.","uk":"Він втратив зір."}},{"id":263381,"text":"I have good eyesight.","tr":{"de":"Ich kann gut sehen.","ru":"У меня хорошее зрение.","uk":"У мене добрий зір."}},{"id":263379,"text":"I have poor eyesight.","tr":{"de":"Ich sehe schlecht.","ru":"У меня плохое зрение.","uk":"У мене поганий зір."}},{"id":3049853,"text":"Tom has bad eyesight.","tr":{"de":"Tom hat schlechte Augen.","ru":"У Тома плохое зрение.","uk":"У Тома поганий зір."}}],"eyebrows":[{"id":2334102,"text":"I hate my eyebrows.","tr":{"de":"Ich hasse meine Augenbrauen.","ru":"Ненавижу свои брови."}},{"id":2821584,"text":"Tom has bushy eyebrows.","tr":{"de":"Tom hat buschige Augenbrauen.","ru":"У Тома кустистые брови."}},{"id":2821541,"text":"Tom raised his eyebrows.","tr":{"de":"Tom hob seine Augenbrauen.","ru":"Том поднял брови."}},{"id":3223238,"text":"Do you pluck your eyebrows?","tr":{"de":"Zupfst du dir die Augenbrauen?","ru":"Ты выщипываешь брови?"}},{"id":295383,"text":"He arched his eyebrows in surprise.","tr":{"de":"Überrascht hob er die Augenbrauen.","uk":"Здивувашись, він підняв брови."}}],"eyepatch":[{"id":1655382,"text":"He wears an eyepatch.","tr":{"de":"Er trägt eine Augenklappe.","ru":"У него повязка на глазу."}},{"id":1388351,"text":"Tom wears an eyepatch.","tr":{"de":"Tom trägt eine Augenklappe.","ru":"У Тома на глазу повязка."}},{"id":2642249,"text":"Why are you wearing an eyepatch?","tr":{"de":"Warum trägst du eine Augenklappe?"}}],"eyewitness":[{"id":2891474,"text":"Is Tom an eyewitness?","tr":{"de":"Ist Tom ein Augenzeuge?","ru":"Том очевидец?"}},{"id":6049128,"text":"Tom was the only eyewitness.","tr":{"ru":"Том был единственным очевидцем.","uk":"Том був єдиним свідком."}},{"id":2547584,"text":"Tom is an eyewitness.","tr":{"ru":"Том — свидетель."}},{"id":5747961,"text":"We have an eyewitness.","tr":{"ru":"У нас есть очевидец."}},{"id":6350130,"text":"Tom wasn't the only eyewitness.","tr":{"ru":"Том был не единственным свидетелем."}}],"eyelashes":[{"id":5337466,"text":"Mary has long eyelashes.","tr":{"de":"Maria hat lange Wimpern.","ru":"У Марии длинные ресницы."}},{"id":4121181,"text":"Mary wore false eyelashes.","tr":{"de":"Maria trug falsche Wimpern.","ru":"Мэри носила накладные ресницы."}},{"id":5746048,"text":"Mary batted her eyelashes.","tr":{"ru":"Мэри хлопала ресницами."}},{"id":3010258,"text":"Mary batted her eyelashes at Tom.","tr":{"de":"Maria zwinkerte Tom zu."}},{"id":5983668,"text":"Mary batted her eyelashes innocently.","tr":{"de":"Maria schlug unschuldig mit den Wimpern."}}],"eyelid":[{"id":4218124,"text":"She didn't bat an eyelid.","tr":{"de":"Sie hat nicht mit der Wimper gezuckt.","ru":"Она и бровью не повела."}},{"id":8018060,"text":"My left eyelid is twitching.","tr":{"de":"Mein linkes Augenlid zuckt.","ru":"У меня дёргается левое веко."}},{"id":9474568,"text":"Tom's right eyelid twitches.","tr":{"de":"Tom hat Zuckungen am rechten Augenlid."}}],"eyewitnesses":[{"id":4502911,"text":"There were no eyewitnesses.","tr":{"ru":"Свидетелей не было.","uk":"Свідків не було."}},{"id":3028944,"text":"The eyewitnesses gave conflicting accounts of what they had seen.","tr":{"ru":"Очевидцы дали противоречивые показания об увиденном."}}],"eyebrow":[{"id":2783114,"text":"He raised an eyebrow quizzically.","tr":{"de":"Er hob spöttisch eine Augenbraue.","ru":"Он недоумённо поднял бровь."}},{"id":6099204,"text":"Tom arched one eyebrow.","tr":{"de":"Tom zog eine Augenbraue hoch."}}],"eyesore":[{"id":239280,"text":"It's an eyesore.","tr":{"ru":"Это бельмо на глазу."}}],"eyelids":[{"id":2947372,"text":"Camels have three eyelids.","tr":{"de":"Kamele haben drei Augenlider."}},{"id":2643132,"text":"Tom's eyelids were half open.","tr":{"ru":"Веки Тома были полуоткрыты."}},{"id":9851484,"text":"Were your eyelids stuck together when you woke up this morning?","tr":{"de":"Waren Ihre Augen heute Morgen verklebt, als Sie aufgewacht sind?"}}],"eyeliner":[{"id":2275757,"text":"Could I borrow your eyeliner?","tr":{"de":"Darf ich mir Ihren Eyeliner ausborgen?"}}],"eyecatching":[{"id":6214623,"text":"Mary wore an eyecatching dress.","tr":{"de":"Maria trug ein auffallendes Kleid."}}],"eyedrops":[{"id":680750,"text":"Mary uses eyedrops for her dry eyes.","tr":{"de":"Maria benutzt für ihre trockenen Augen Augentropfen."}}],"eyewear":[{"id":7567952,"text":"Company regulations mandate that workers use protective eyewear.","tr":{"de":"Die Betriebsordnung schreibt den Arbeitern das Tragen von Sicherheitsbrillen vor."}}]}