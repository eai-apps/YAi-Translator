{"oh":[{"id":1299275,"text":"Oh no!","tr":{"de":"Oh, Nein!","ru":"О нет!","uk":"О ні!"}},{"id":2529840,"text":"Oh, I got it.","tr":{"de":"Oh, ich hab's.","ru":"А, понятно.","uk":"А, зрозуміло."}},{"id":1579,"text":"Oh, I'm sorry.","tr":{"de":"Oh, tut mir leid.","ru":"О, мне очень жаль.","uk":"О, мені дуже шкода."}},{"id":8859155,"text":"Oh, that's even better.","tr":{"de":"Ah, das ist noch besser.","ru":"О, так ещё лучше.","uk":"О, так навіть краще."}},{"id":72127,"text":"Oh, don't worry about it.","tr":{"de":"Ach, mach dir darum keine Sorgen!","ru":"О, об этом не беспокойся.","uk":"О, не переймайся цим."}}],"ohio":[{"id":289429,"text":"He was born in Ohio.","tr":{"de":"Er wurde in Ohio geboren.","ru":"Он родился в Огайо.","uk":"Він народився в Огайо."}}]}