{"giggled":[{"id":5828665,"text":"I giggled.","tr":{"de":"Ich kicherte.","ru":"Я хихикнул.","uk":"Я захихотів."}},{"id":2111172,"text":"Tom giggled.","tr":{"de":"Tom kicherte.","ru":"Том хихикнул.","uk":"Том хихикнув."}},{"id":1396137,"text":"Mary giggled.","tr":{"de":"Maria kicherte.","ru":"Мэри хихикнула.","uk":"Мері захихотіла."}},{"id":3732348,"text":"Everyone giggled.","tr":{"de":"Alle kicherten.","ru":"Все захихикали."}},{"id":2243020,"text":"They all giggled.","tr":{"de":"Alle kicherten.","ru":"Они все хихикали."}}],"give":[{"id":454503,"text":"I give in.","tr":{"de":"Ich gebe auf.","ru":"Сдаюсь.","uk":"Я здаюся."}},{"id":241200,"text":"I give up.","tr":{"de":"Ich gebe auf.","ru":"Я сдаюсь.","uk":"Я здаюся."}},{"id":278605,"text":"Give it up.","tr":{"de":"Gib es auf!","ru":"Попустись.","uk":"Кинь це."}},{"id":2043700,"text":"Give me half.","tr":{"de":"Gib mir die Hälfte.","ru":"Дай мне половину.","uk":"Дай мені половину."}},{"id":2245526,"text":"Give me that.","tr":{"de":"Gib mir das.","ru":"Дай мне это.","uk":"Дайте мені це."}}],"gives":[{"id":1414995,"text":"What gives?","tr":{"de":"Was ist los?","ru":"К чему ты это?","uk":"Що відбувається?"}},{"id":296782,"text":"He seldom gives his wife presents.","tr":{"de":"Er schenkt seiner Frau selten etwas.","ru":"Он редко дарит своей жене подарки.","uk":"Він рідко дарує своїй дружині подарунки."}},{"id":251264,"text":"My best friend always gives me good advice.","tr":{"de":"Mein bester Freund gibt mir immer gute Ratschläge.","ru":"Мой лучший друг всегда даёт мне хорошие советы.","uk":"Мій найкращий друг завжди дає мені добру пораду."}},{"id":682065,"text":"The Constitution gives certain rights to the states.","tr":{"de":"Die Verfassung verleiht den Staaten gewisse Rechte.","ru":"Конституция даёт штатам определённые права.","uk":"Конституція надає штатам певні права."}},{"id":1817019,"text":"He gives us money.","tr":{"de":"Er gibt uns Geld.","ru":"Он даёт нам деньги."}}],"girls":[{"id":2245935,"text":"I like girls.","tr":{"de":"Ich mag Mädchen.","ru":"Я люблю девушек.","uk":"Мені подобаються дівчата."}},{"id":1690727,"text":"The girls won.","tr":{"de":"Die Mädchen haben gewonnen.","ru":"Девочки выиграли.","uk":"Дівчата виграли."}},{"id":2221130,"text":"Girls are crazy.","tr":{"de":"Mädchen sind verrückt.","ru":"Девушки сумасшедшие.","uk":"Дівчата божевільні."}},{"id":5190911,"text":"Tom likes girls.","tr":{"de":"Tom mag Mädchen.","ru":"Тому нравятся девушки.","uk":"Тому подобаються дівчата."}},{"id":1898422,"text":"Both girls laughed.","tr":{"de":"Die beiden Mädchen lachten.","ru":"Обе девочки засмеялись.","uk":"Обидві дівчини засміялися."}}],"gift":[{"id":1897724,"text":"It was a gift.","tr":{"de":"Es war ein Geschenk.","ru":"Это был подарок.","uk":"Це був подарунок."}},{"id":2649000,"text":"It's not a gift.","tr":{"de":"Es ist kein Geschenk.","ru":"Это не подарок.","uk":"Це не подарунок."}},{"id":3951692,"text":"It's my gift to you.","tr":{"de":"Das ist mein Geschenk an dich.","ru":"Это мой подарок тебе.","uk":"Це мій тобі подарунок."}},{"id":3824437,"text":"I brought you a gift.","tr":{"de":"Ich habe dir ein Geschenk mitgebracht.","ru":"Я принёс тебе подарок.","uk":"Я приніс тобі подарунок."}},{"id":508336,"text":"This gift is for you.","tr":{"de":"Das ist ein Geschenk für dich.","ru":"Это подарок для тебя.","uk":"Цей подарунок для тебе."}}],"girl":[{"id":1649020,"text":"Be a good girl.","tr":{"de":"Sei artig.","ru":"Будь хорошей девочкой.","uk":"Будь доброю дівчинкою."}},{"id":6402280,"text":"Mary is a girl.","tr":{"de":"Maria ist ein Mädchen.","ru":"Мэри — девочка.","uk":"Мері — дівчинка."}},{"id":254495,"text":"I know the girl.","tr":{"de":"Ich kenne das Mädchen.","ru":"Я знаю эту девушку.","uk":"Я знаю цю дівчину."}},{"id":68220,"text":"Who's that girl?","tr":{"de":"Wer ist dieses Mädchen?","ru":"Кто та девушка?","uk":"Хто та дівчина?"}},{"id":67222,"text":"A girl phoned me.","tr":{"de":"Ein Mädchen rief mich an.","ru":"Мне позвонила девушка.","uk":"Мені зателефонувала дівчина."}}],"gifts":[{"id":1728320,"text":"I accept gifts.","tr":{"de":"Ich nehme Geschenke entgegen.","ru":"Я принимаю подарки.","uk":"Я приймаю подарунки."}},{"id":274356,"text":"I have some gifts.","tr":{"de":"Ich habe Geschenke.","ru":"У меня есть несколько подарков.","uk":"У мене є подарунки."}},{"id":1762369,"text":"I like to give gifts.","tr":{"de":"Ich gebe gern Geschenke.","ru":"Я люблю дарить подарки.","uk":"Я люблю дарувати подарунки."}},{"id":3738541,"text":"Did Tom get any gifts?","tr":{"de":"Hat Tom irgendwelche Geschenke bekommen?","ru":"Том получил какие-нибудь подарки?","uk":"Том отримав якісь подарунки?"}},{"id":324349,"text":"I have two gifts for friends.","tr":{"de":"Ich habe zwei Geschenke für Freunde.","ru":"У меня есть два подарка для друзей.","uk":"У мене є два подарунки для друзів."}}],"giggling":[{"id":2236701,"text":"Tom is giggling.","tr":{"de":"Tom kichert.","ru":"Том хихикает.","uk":"Том гигоче."}},{"id":2238698,"text":"Tom started giggling.","tr":{"de":"Tom fing an zu kichern.","ru":"Том захихикал."}},{"id":3313061,"text":"We couldn't stop giggling.","tr":{"ru":"Мы не могли перестать хихикать."}}],"giving":[{"id":1891040,"text":"I'm not giving up.","tr":{"de":"Ich gebe nicht auf.","ru":"Я не сдаюсь!","uk":"Я не здаюся."}},{"id":2548731,"text":"I'm giving it back.","tr":{"de":"Ich gebe es zurück.","ru":"Я его возвращаю.","uk":"Я повертаю його."}},{"id":256952,"text":"I'm giving up smoking.","tr":{"de":"Ich höre mit dem Rauchen auf.","ru":"Я бросаю курить.","uk":"Я кидаю курити."}},{"id":953276,"text":"Giving up isn't the answer.","tr":{"de":"Aufgeben ist keine Lösung.","ru":"Признать себя побеждённым - это не решение.","uk":"Здатися — це не рішення."}},{"id":2543022,"text":"I'm giving my old books away.","tr":{"de":"Ich verschenke meine alten Bücher.","ru":"Я раздаю свои старые книги.","uk":"Я віддаю свої старі книжки."}}],"girlfriend":[{"id":1969242,"text":"I have a girlfriend.","tr":{"de":"Ich habe eine Freundin.","ru":"У меня есть по