{"my":[{"id":25536,"text":"It's my CD.","tr":{"de":"Das ist meine CD.","ru":"Это мой компакт-диск.","uk":"Це мій компакт-диск."}},{"id":1272300,"text":"It's my bus.","tr":{"de":"Es ist mein Bus.","ru":"Мой автобус.","uk":"Це мій автобус."}},{"id":433521,"text":"It's my job.","tr":{"de":"Es ist mein Job.","ru":"Это моя работа.","uk":"Це моя робота."}},{"id":2250055,"text":"Take my car.","tr":{"de":"Nimm meinen Wagen!","ru":"Возьми мою машину.","uk":"Візьми мою машину."}},{"id":1841169,"text":"Get my rifle.","tr":{"de":"Hol mein Gewehr.","ru":"Достань моё ружьё.","uk":"Принеси мою рушницю."}}],"myth":[{"id":3822140,"text":"It's a myth.","tr":{"de":"Das ist ein Mythos.","ru":"Это миф.","uk":"Це міф."}},{"id":1897778,"text":"That's a myth.","tr":{"de":"Das ist ein Mythos.","ru":"Это миф.","uk":"Це міф."}},{"id":2294036,"text":"I think it's a myth.","tr":{"ru":"Я думаю, что это миф.","uk":"Я думаю, що це міф."}},{"id":2294035,"text":"I believe it's a myth.","tr":{"de":"Das halte ich für ein Gerücht.","uk":"Я думаю, що це міф."}},{"id":7008104,"text":"Isn't that just a myth?","tr":{"de":"Ist das nicht nur eine Legende?","uk":"Хіба це не просто міф?"}}],"myself":[{"id":1553482,"text":"I cut myself.","tr":{"de":"Ich habe mich geschnitten.","ru":"Я порезался.","uk":"Я порізався."}},{"id":1779951,"text":"I hate myself.","tr":{"de":"Ich hasse mich selbst.","ru":"Я сам себя ненавижу.","uk":"Ненавиджу себе."}},{"id":1739677,"text":"I've cut myself.","tr":{"de":"Ich habe mich geschnitten.","ru":"Я порезался.","uk":"Я порізався."}},{"id":327655,"text":"I know it myself.","tr":{"de":"Ich weiß es selbst.","ru":"Я сам это знаю.","uk":"Я сам це знаю."}},{"id":42590,"text":"I made it myself.","tr":{"de":"Das habe ich selbst angefertigt.","ru":"Я сам это сделал.","uk":"Я сам його зробив."}}],"mysteries":[{"id":1820237,"text":"Life is full of mysteries.","tr":{"de":"Das Leben steckt voller Geheimnisse.","ru":"Жизнь полна тайн.","uk":"Життя повне секретів."}},{"id":2241152,"text":"We love mysteries.","tr":{"ru":"Мы любим тайны.","uk":"Ми любимо таємниці."}},{"id":270544,"text":"There are many mysteries in life.","tr":{"de":"Das Leben birgt viele Geheimnisse.","ru":"В жизни много таинственного."}},{"id":2322878,"text":"The universe is full of mysteries.","tr":{"de":"Das Universum ist voller Geheimnisse.","ru":"Вселенная полна тайн."}},{"id":2245936,"text":"I like mysteries.","tr":{"ru":"Я люблю тайны."}}],"mystery":[{"id":1216239,"text":"Nature is full of mystery.","tr":{"de":"Die Natur ist voller Geheimnisse.","ru":"Природа полна загадок.","uk":"Природа повна таємниць."}},{"id":1972574,"text":"I like reading mystery novels.","tr":{"de":"Ich lese gerne Kriminalromane.","ru":"Мне нравится читать детективные романы.","uk":"Я люблю читати детективи."}},{"id":3737509,"text":"Tom is a mystery.","tr":{"de":"Tom ist ein Rätsel.","uk":"Том — загадка."}},{"id":11966685,"text":"That's the mystery.","tr":{"de":"Das ist das Rätsel.","ru":"Это тайна."}},{"id":2406531,"text":"I solved the mystery.","tr":{"de":"Ich habe das Rätsel gelöst.","ru":"Я разгадал загадку."}}],"mysterious":[{"id":2105,"text":"This place has a mysterious atmosphere.","tr":{"de":"An diesem Ort herrscht eine geheimnisvolle Stimmung.","ru":"У этого места таинственная атмосфера.","uk":"В цьому місці панує таємнича атмосфера."}},{"id":1199390,"text":"You're so mysterious.","tr":{"de":"Du bist so geheimnisvoll.","ru":"Ты такой таинственный."}},{"id":1024567,"text":"Tom likes to be mysterious.","tr":{"de":"Tom gibt sich gerne geheimnisvoll.","uk":"Тому подобається бути таємничим."}},{"id":5740789,"text":"Tom's death was mysterious.","tr":{"ru":"Смерть Тома была загадочной.","uk":"Смерть Тома була загадковою."}},{"id":5670665,"text":"God works in mysterious ways.","tr":{"ru":"Пути Господни неисповедимы.","uk":"Шляхи Господні несповідимі."}}],"mysteriously":[{"id":6375190,"text":"Tom fell mysteriously ill.","tr":{"de":"Tom wurde auf rätselhafte Weise krank.","ru":"Тома постигла загадочная болезнь."}},{"id":6566252,"text":"Tom disappeared mysteriously.","tr":{"ru":"Том таинственным образом исчез."}},{"id":9934457,"text":"Tom mysteriously disappeared.","tr":{"ru":"Том таинственно исчез."}}],"myths":[{"id":36314,"text":"Do you know any Greek myths?","tr":{"de":"Kennen Sie irgendwelche griechischen Mythen?","ru":"Вы знаете какие-нибудь греческие мифы?"}},{"id":296138,"text":"He wrote a novel based on ancient myths.","tr":{"ru":"Он написал рассказ, основанный на древних мифах.","uk":"Він написав роман, що базується на стародавніх міфах."}},{"id":37454,"text":"Every nation has its own myths.","tr":{"uk":"У кожного народу є свої власні міфи."}}],"myanmar":[{"id":551384,"text":"Myanmar is ruled by a military dictatorship.","tr":{"de":"Myanmar wird von einer Militärdiktatur regiert.","ru":"Мьянмой управляет военная диктатура."}}],"mythology":[{"id":578849,"text":"The story of a great flood is very common in world mythology.","tr":{"de":"Die Geschichte einer großen Flut ist weit verbreitet in der Mythologie der Welt.","ru":"История о великом потопе очень распространена в мировой мифологии."}},{"id":4099321,"text":"I'm also interested in Greek mythology.","tr":{"de":"Ich interessiere mich auch für griechische Mythologie."}},{"id":8969909,"text":"Tom isn't really interested in Greek mythology.","tr":{"ru":"Тому не очень интересна греческая мифология."}}],"mystified":[{"id":6039878,"text":"Tom was mystified.","tr":{"de":"Tom war verblüfft."}}],"mystifying":[{"id":1516350,"text":"This is mystifying.","tr":{"ru":"Это озадачивает."}}],"myopia":[{"id":425587,"text":"One in ten people have myopia.","tr":{"ru":"Каждый десятый человек страдает близорукостью."}}],"myeloid":[{"id":4497253,"text":"Tom was diagnosed with acute myeloid leukemia in 2013.","tr":{"ru":"В 2013 году Тому поставили диагноз — острый миелолейкоз."}}]}