{"otherwise":[{"id":250447,"text":"I think otherwise.","tr":{"de":"Ich denke anders.","ru":"Я думаю иначе.","uk":"Я іншої думки."}},{"id":4405044,"text":"Tom thought otherwise.","tr":{"de":"Tom war anderer Meinung.","ru":"Том думал иначе.","uk":"Том вважав інакше."}},{"id":5958368,"text":"I thought otherwise.","tr":{"ru":"Я думал иначе.","uk":"Я інакше думав."}},{"id":5754575,"text":"Tom proved otherwise.","tr":{"ru":"Том доказал обратное.","uk":"Том довів протилежне."}},{"id":5740778,"text":"It could not be otherwise.","tr":{"ru":"По-другому и быть не могло.","uk":"Це не може бути інакше."}}],"other":[{"id":4950723,"text":"We help each other.","tr":{"de":"Wir helfen uns gegenseitig.","ru":"Мы помогаем друг другу.","uk":"Ми допомогаємо одне одному."}},{"id":247916,"text":"We love each other.","tr":{"de":"Wir lieben uns.","ru":"Мы любим друг друга.","uk":"Ми любимо одне одного."}},{"id":2011560,"text":"I want the other one.","tr":{"de":"Ich will den anderen.","ru":"Я хочу другой.","uk":"Я хочу інший."}},{"id":2647069,"text":"They hate each other.","tr":{"de":"Sie hassen sich.","ru":"Они ненавидят друг друга.","uk":"Вони ненавидять один одного."}},{"id":307721,"text":"They love each other.","tr":{"de":"Sie lieben einander.","ru":"Они любят друг друга.","uk":"Вони кохають одне одного."}}],"others":[{"id":2547805,"text":"I'll tell the others.","tr":{"de":"Ich werde es den anderen sagen.","ru":"Я скажу остальным.","uk":"Я розповім іншим."}},{"id":398875,"text":"He often helps others.","tr":{"de":"Er hilft anderen oft.","ru":"Он часто помогает другим.","uk":"Він часто допомагає іншим."}},{"id":274705,"text":"Don't worry about others.","tr":{"de":"Mach dir um Andere keine Sorgen.","ru":"Не волнуйся о других.","uk":"Не хвилюйся про інших."}},{"id":819202,"text":"Have you asked the others?","tr":{"de":"Hast du die anderen gefragt?","ru":"Ты других спросил?","uk":"Ти питав інших?"}},{"id":238532,"text":"Never speak ill of others.","tr":{"de":"Sprich nie schlecht von anderen!","ru":"Никогда не говори о людях плохо.","uk":"Ніколи не говори погано про інших."}}],"otter":[{"id":12732175,"text":"I saw an otter.","tr":{"de":"Ich habe einen Otter gesehen.","ru":"Я видел выдру."}}],"otaru":[{"id":311005,"text":"She has always lived in Otaru.","tr":{"de":"Sie lebte schon immer in Otaru.","ru":"Она всегда жила в Отару."}}],"ottawa":[{"id":64997,"text":"Ottawa is the capital of Canada.","tr":{"ru":"Оттава — столица Канады.","uk":"Оттава - столиця Канади."}}],"otters":[{"id":12051349,"text":"Otters are cute.","tr":{"ru":"Выдры милые."}},{"id":1036663,"text":"Sea otters love to eat clams while swimming on their backs.","tr":{"de":"Seeotter lieben es, auf dem Rücken schwimmend Muscheln zu futtern."}}],"ottoman":[{"id":8904682,"text":"North Yemen became independent from the Ottoman Empire in 1918.","tr":{"uk":"Північний Ємен став незалежним від Османської імперії у 1918 році."}}]}