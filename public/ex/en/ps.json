{"psyched":[{"id":2111698,"text":"I'm psyched.","tr":{"de":"Ich bin aufgeregt.","ru":"Я балдею.","uk":"Я на нервах."}},{"id":2203231,"text":"You're psyched.","tr":{"ru":"Ты взвинчен."}},{"id":2203232,"text":"Tom is psyched.","tr":{"uk":"Том на взводі."}},{"id":7114401,"text":"Tom was psyched.","tr":{"ru":"Том психанул."}},{"id":6531904,"text":"Tom is psyched about it.","tr":{"uk":"Том схвильований через це."}}],"psychic":[{"id":2272857,"text":"Tom is a psychic.","tr":{"de":"Tom ist Hellseher.","ru":"Том — экстрасенс.","uk":"Том екстрасенс."}},{"id":2203235,"text":"Tom is psychic.","tr":{"de":"Tom ist übersinnlich.","ru":"Том - экстрасенс."}},{"id":2301559,"text":"I'm not a psychic.","tr":{"de":"Ich kann nicht hellsehen.","ru":"Я не телепат."}},{"id":3467776,"text":"Do you have psychic powers?","tr":{"de":"Hast du übernatürliche Kräfte?","ru":"У тебя есть экстрасенсорные способности?"}},{"id":2203234,"text":"I'm psychic.","tr":{"uk":"Я екстрасенс."}}],"psychology":[{"id":1132368,"text":"I study psychology.","tr":{"de":"Ich studiere Psychologie.","ru":"Я изучаю психологию.","uk":"Я вивчаю психологію."}},{"id":1024475,"text":"Tom majored in psychology.","tr":{"de":"Tom hat einen Abschluss in Psychologie gemacht.","uk":"Спеціальністю Тома була психологія."}},{"id":1479124,"text":"Tom teaches sport psychology.","tr":{"de":"Tom unterrichtet Sportpsychologie.","ru":"Том преподаёт спортивную психологию."}},{"id":251847,"text":"My mother is a psychology teacher.","tr":{"de":"Meine Mutter unterrichtet Psychologie.","ru":"Моя мать — преподаватель психологии."}},{"id":778273,"text":"I majored in psychology.","tr":{"de":"Mein Hauptfach war Psychologie."}}],"psychopath":[{"id":1520739,"text":"Tom is a psychopath.","tr":{"de":"Tom ist ein Psychopath.","ru":"Том - психопат.","uk":"Том — психопат."}},{"id":8297828,"text":"I think Tom is a dangerous psychopath.","tr":{"de":"Ich halte Tom für einen gefährlichen Psychopathen.","uk":"Я думаю, що Том — небезпечний психопат."}},{"id":8297827,"text":"I think that Tom is a dangerous psychopath.","tr":{"de":"Ich halte Tom für einen gefährlichen Psychopathen.","uk":"Я думаю, що Том — небезпечний психопат."}},{"id":5858507,"text":"I'm not a psychopath.","tr":{"ru":"Я не психопат."}},{"id":8995043,"text":"Tom isn't a psychopath.","tr":{"de":"Tom ist kein Psychopath."}}],"psychologist":[{"id":2272859,"text":"Tom is a psychologist.","tr":{"de":"Tom ist Psychologe.","ru":"Том - психолог.","uk":"Том — психолог."}},{"id":5975646,"text":"I'm a psychologist.","tr":{"ru":"Я психолог.","uk":"Я психолог."}},{"id":6094458,"text":"Aren't you a psychologist?","tr":{"ru":"Ты не психолог?","uk":"Хіба ти не психолог?"}},{"id":6269287,"text":"Tom is a child psychologist.","tr":{"ru":"Том — детский психолог.","uk":"Том — дитячий психолог."}},{"id":1875724,"text":"The psychologist asked me a whole battery of questions.","tr":{"de":"Der Psychologe stellte mir eine ganze Reihe von Fragen.","ru":"Психолог задал мне уйму вопросов."}}],"psychological":[{"id":2663293,"text":"Tom has psychological problems.","tr":{"de":"Tom hat psychische Probleme.","ru":"У Тома психологические проблемы.","uk":"У Тома психологічні проблеми."}},{"id":6123297,"text":"Tom has some serious psychological problems.","tr":{"uk":"У Тома серйозні психологічні проблеми."}},{"id":3410865,"text":"The doctor thinks Tom's problem is psychological.","tr":{"ru":"Врач считает, что проблема Тома психологического характера."}}],"psycho":[{"id":2272858,"text":"Tom is a psycho.","tr":{"de":"Tom hat einen Dachschaden.","uk":"Том — психопат."}}],"pseudoscience":[{"id":1494847,"text":"That's pseudoscience.","tr":{"de":"Das ist Pseudowissenschaft.","ru":"Это псевдонаука."}},{"id":11891205,"text":"Astrology is a pseudoscience.","tr":{"de":"Astrologie ist eine Pseudowissenschaft.","ru":"Астрология — лженаука."}}],"psychiatrist":[{"id":2272856,"text":"Tom is a psychiatrist.","tr":{"de":"Tom ist Psychiater.","ru":"Том - психиатр."}},{"id":1864712,"text":"She phoned the psychiatrist.","tr":{"ru":"Она позвонила психиатру.","uk":"Вона зателефонувала психіатру."}},{"id":10077560,"text":"My psychiatrist is Dr. Jackson.","tr":{"de":"Mein Psychiater ist Dr. Hansen.","uk":"Мій психіатр — доктор Джексон."}},{"id":11281243,"text":"You need to consult a psychiatrist.","tr":{"de":"Du brauchst einen Besuch beim Psychiater.","ru":"Тебе надо к психиатру сходить."}},{"id":954322,"text":"That psychiatrist specialized in eating disorders.","tr":{"de":"Dieser Psychiater hat sich auf Essstörungen spezialisiert.","ru":"Этот психиатр специализировался на расстройствах приема пищи."}}],"psychotherapist":[{"id":2272860,"text":"Tom is a psychotherapist.","tr":{"de":"Tom ist Psychotherapeut.","uk":"Том — психотерапевт."}}],"pseudo":[{"id":1770,"text":"Creationism is a pseudo-science.","tr":{"de":"Der Kreationismus ist eine Pseudowissenschaft.","uk":"Креаціонізм — псевдонаука."}}],"psychiatrists":[{"id":1342137,"text":"Do psychiatrists need psychiatrists?","tr":{"de":"Brauchen Psychiater Psychiater?","uk":"Психіатри потребують психіатрів?"}},{"id":2288169,"text":"You hate psychiatrists, don't you?","tr":{"de":"Du kannst Psychiater nicht leiden. Stimmt's?"}}],"psychiatric":[{"id":9849520,"text":"Have you ever been hospitalized in a psychiatric hospital?","tr":{"de":"Wurden Sie jemals in eine psychiatrische Klinik eingewiesen?","ru":"Ты когда-нибудь лежал в психбольнице?"}}],"pseudonym":[{"id":11331583,"text":"It's a pseudonym.","tr":{"ru":"Это псевдоним."}},{"id":9461400,"text":"Tom writes under a pseudonym.","tr":{"ru":"Том пишет под псевдонимом."}}],"psychologists":[{"id":9441688,"text":"We're psychologists.","tr":{"ru":"Мы психологи."}}],"psychotherapy":[{"id":1502082,"text":"The show's about a New Jersey mob boss who's in psychotherapy.","tr":{"de":"Der Film handelt von einem Mafiaboss aus New Jersey, der sich in Psychotherapie befindet."}}]}