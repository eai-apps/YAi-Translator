{"yell":[{"id":2111894,"text":"Don't yell.","tr":{"de":"Schrei nicht!","ru":"Не ори.","uk":"Не кричіть."}},{"id":5592867,"text":"Tom didn't yell at Mary.","tr":{"de":"Tom hat Mary nicht angeschrien.","ru":"Том не орал на Мэри.","uk":"Том не кричав на Мері."}},{"id":6024898,"text":"Why did Tom yell at you?","tr":{"de":"Warum hat Tom dich angeschrien?","ru":"Почему Том на тебя кричал?","uk":"Чому Том на тебе кричав?"}},{"id":250169,"text":"Don't yell at me.","tr":{"ru":"Не ори на меня.","uk":"Не кричіть на мене."}},{"id":2271368,"text":"Don't yell at Tom.","tr":{"ru":"Не кричи на Тома.","uk":"Не кричи на Тома."}}],"yes":[{"id":2405921,"text":"I said yes.","tr":{"de":"Ich sagte ja.","ru":"Я сказал да.","uk":"Я погодилася."}},{"id":35504,"text":"Yes, I know.","tr":{"de":"Ja, ich weiß.","ru":"Да, я знаю.","uk":"Так, знаю."}},{"id":4394831,"text":"Tom said yes.","tr":{"de":"Tom sagte ja.","ru":"Том сказал да.","uk":"Том сказав, що так."}},{"id":433589,"text":"Yes, I know it.","tr":{"de":"Ja, ich weiß es.","ru":"Да, я знаю.","uk":"Так, я це знаю."}},{"id":30530,"text":"Yes, of course.","tr":{"de":"Ja, natürlich.","ru":"Да, конечно.","uk":"Так, звичайно."}}],"yelled":[{"id":2203901,"text":"Tom yelled.","tr":{"de":"Tom schrie.","ru":"Том кричал.","uk":"Том кричав."}},{"id":2203900,"text":"Who yelled?","tr":{"de":"Wer hat geschrien?","ru":"Кто кричал?","uk":"Хто кричав?"}},{"id":1867690,"text":"Tom yelled at Mary.","tr":{"de":"Tom brüllte Mary an.","ru":"Том накричал на Мэри.","uk":"Том кричав на Мері."}},{"id":2111351,"text":"They yelled.","tr":{"ru":"Они закричали.","uk":"Вони кричали."}},{"id":3378682,"text":"I yelled for help.","tr":{"de":"Ich schrie um Hilfe.","ru":"Я криком позвал на помощь."}}],"yen":[{"id":72556,"text":"It's 50 yen.","tr":{"de":"Das sind fünfzig Yen.","ru":"50 иен.","uk":"Це п'ятдесят ієн."}},{"id":260007,"text":"I owe him 100 yen.","tr":{"de":"Ich schulde ihm 100 Yen.","ru":"Я должен ему сто иен.","uk":"Я винен йому 100 єн."}},{"id":297462,"text":"He gave me 10,000 yen.","tr":{"de":"Er gab mir zehntausend Yen.","ru":"Он дал мне 10 000 иен.","uk":"Він дав мені десять тисяч єн."}},{"id":72568,"text":"I have about 5,000 yen.","tr":{"de":"Ich habe ungefähr 5000 Yen.","ru":"У меня приблизительно пять тысяч иен.","uk":"У мене є близько 5000 ієн."}},{"id":428050,"text":"Is a thousand yen enough?","tr":{"de":"Reichen tausend Yen?","ru":"Тысячи иен хватит?","uk":"Тисячі єн достатньо?"}}],"yelling":[{"id":1908512,"text":"Stop yelling!","tr":{"de":"Hör auf zu schreien!","ru":"Хватит орать!","uk":"Припини кричати!"}},{"id":1663819,"text":"Tom is yelling.","tr":{"de":"Tom schreit.","ru":"Том вопит.","uk":"Том кричить."}},{"id":2247567,"text":"I wasn't yelling.","tr":{"de":"Ich habe nicht geschrien.","ru":"Я не кричала.","uk":"Я не кричав."}},{"id":1845487,"text":"Stop yelling at me.","tr":{"de":"Höre auf, mich anzuschreien!","ru":"Прекрати на меня орать!","uk":"Припини на мене кричати."}},{"id":2238723,"text":"Tom started yelling.","tr":{"de":"Tom begann zu schreien.","ru":"Том заорал.","uk":"Том закричав."}}],"years":[{"id":282197,"text":"Years passed.","tr":{"de":"Jahre vergingen.","ru":"Годы прошли.","uk":"Роки проминули."}},{"id":699465,"text":"I'm 18 years old.","tr":{"de":"Ich bin 18 Jahre alt.","ru":"Мне 18 лет.","uk":"Мені вісімнадцять років."}},{"id":957242,"text":"I'm 25 years old.","tr":{"de":"Ich bin fünfundzwanzig Jahre alt.","ru":"Мне 25 лет.","uk":"Мені двадцять п'ять років."}},{"id":73252,"text":"I am 19 years old.","tr":{"de":"Ich bin 19 Jahre alt.","ru":"Мне девятнадцать лет.","uk":"Мені 19 років."}},{"id":72618,"text":"Forty years passed.","tr":{"de":"Vierzig Jahre sind vergangen.","ru":"Прошло сорок лет.","uk":"Минуло сорок років."}}],"yellow":[{"id":4650860,"text":"I like yellow.","tr":{"de":"Ich mag Gelb.","ru":"Мне нравится жёлтый.","uk":"Мені подобається жовтий колір."}},{"id":695220,"text":"Yolks are yellow.","tr":{"de":"Eigelbe sind gelb.","ru":"Яичные желтки жёлтого цвета.","uk":"Жовтки жовті."}},{"id":10106813,"text":"Lemons are yellow.","tr":{"de":"Zitronen sind gelb.","ru":"Лимоны жёлтые.","uk":"Лимони жовті."}},{"id":559000,"text":"Bananas are yellow.","tr":{"de":"Bananen sind gelb.","ru":"Бананы жёлтые.","uk":"Банани жовті."}},{"id":5927329,"text":"The grass is yellow.","tr":{"de":"Das Gras ist gelb.","ru":"Трава жёлтая.","uk":"Трава жовта."}}],"year":[{"id":361350,"text":"Happy New Year!","tr":{"de":"Frohes neues Jahr!","ru":"С Новым годом!","uk":"З Новим роком!"}},{"id":322472,"text":"I go every year.","tr":{"de":"Ich gehe jedes Jahr.","ru":"Я хожу каждый год.","uk":"Я кожного року ходжу."}},{"id":3361982,"text":"It was last year.","tr":{"de":"Das war letztes Jahr.","ru":"Это было в прошлом году.","uk":"Це було торік."}},{"id":3312593,"text":"We met last year.","tr":{"de":"Wir haben uns letztes Jahr kennengelernt.","ru":"Мы встретились в прошлом году.","uk":"Ми познайомилися торік."}},{"id":5374949,"text":"See you next year.","tr":{"de":"Man sieht sich nächstes Jahr!","ru":"Увидимся в следующем году.","uk":"Побачимося наступного року."}}],"yet":[{"id":293048,"text":"Has he come yet?","tr":{"de":"Ist er schon gekommen?","ru":"Он уже пришёл?","uk":"Він вже прийшов?"}},{"id":1886882,"text":"Is Tom dead yet?","tr":{"de":"Ist Tom schon tot?","ru":"Том уже мёртв?","uk":"Том вже помер?"}},{"id":1273883,"text":"Did you vote yet?","tr":{"de":"Haben Sie schon gewählt?","ru":"Ты уже голосовал?","uk":"Ти вже голосував?"}},{"id":5856432,"text":"I can't read yet.","tr":{"de":"Ich kann noch nicht lesen.","ru":"Я ещё не умею читать.","uk":"Я ще не вмію читати."}},{"id":5852857,"text":"I can't swim yet.","tr":{"de":"Ich kann noch nicht schwimmen.","ru":"Я ещё не умею плавать.","uk":"Я ще не вмію плавати."}}],"yesterday":[{"id":1493109,"text":"I came yesterday.","tr":{"de":"Ich bin gestern gekommen.","ru":"Я приехал вчера.","uk":"Я приїхав учора."}},{"id":296902,"text":"He died yesterday.","tr":{"de":"Er ist gestern verstorben.","ru":"Он умер вчера.","uk":"Він помер учора."}},{"id":853095,"text":"Yesterday was hot.","tr":{"de":"Gestern war es warm.","ru":"Вчерашний день был жарким.","uk":"Вчора було спекотно."}},{"id":2236145,"text":"Tom came yesterday.","tr":{"de":"Tom kam gestern.","ru":"Том пришёл вчера.","uk":"Том приїхав учора."}},{"id":1026236,"text":"Tom died yesterday.","tr":{"de":"Tom ist gestern gestorben.","ru":"Том вчера умер.","uk":"Том вчора помер."}}],"yeah":[{"id":65359,"text":"Yeah. I think so, too.","tr":{"de":"Ja, das denke ich auch.","ru":"Ага, я тоже так думаю.","uk":"Ага. Я теж так вважаю."}},{"id":3821060,"text":"Yeah, that's what I said.","tr":{"de":"Ja, das habe ich gesagt.","ru":"Ага, я так и сказал.","uk":"Так, саме це я й сказав."}},{"id":3825306,"text":"Yeah, that's what I'd do.","tr":{"de":"Ja, genau das würde ich tun.","ru":"Ага, я бы так и сделал.","uk":"Так, саме це я б і зробив."}},{"id":3822491,"text":"Yeah, that's what I meant.","tr":{"de":"Ja, das meinte ich.","ru":"Да-да, я это и имел в виду.","uk":"Так, саме це я й мав на увазі."}},{"id":3825299,"text":"Yeah, that's what I'll do.","tr":{"de":"Ja, das werde ich machen.","ru":"Да, это то, что я сделаю.","uk":"Так, саме це я й зроблю."}}],"yells":[{"id":6263194,"text":"Tom often yells at his children.","tr":{"de":"Tom schreit seine Kinder oft an.","ru":"Том часто кричит на своих детей.","uk":"Том часто кричить на своїх дітей."}},{"id":5388597,"text":"My mom yells at me all the time for no reason.","tr":{"de":"Meine Mutter schreit mich in einem fort grundlos an.","ru":"Мать всё время орёт на меня без причины."}},{"id":5009661,"text":"Tom never yells at us.","tr":{"ru":"Том никогда на нас не орёт."}},{"id":6262457,"text":"Tom always yells at his children.","tr":{"de":"Tom schreit seine Kinder immer an."}},{"id":301892,"text":"He always yells at me when he is angry.","tr":{"ru":"Он всегда кричит на меня, когда зол."}}],"yeast":[{"id":34925,"text":"Bread is made from flour, water and yeast.","tr":{"de":"Brot wird aus Mehl, Wasser und Hefe hergestellt.","ru":"Хлеб делают из муки, воды и дрожжей.","uk":"Хліб виготовляють із борошна, води й дріжджів."}},{"id":66758,"text":"Yeast makes dough rise.","tr":{"ru":"Дрожжи заставляют тесто подниматься.","uk":"Дріджі піднімають тісто."}},{"id":3205377,"text":"Yeast is used in making bread.","tr":{"de":"Hefe wird benutzt, um Brot zu machen.","ru":"Дрожжи используются при выпечке хлеба."}},{"id":66760,"text":"Yeast makes beer ferment.","tr":{"ru":"Дрожжи составляют закваску пива."}},{"id":3205378,"text":"Yeast is used in making beer.","tr":{"ru":"Дрожжи используют для создания пива."}}],"yellowjacket":[{"id":9795612,"text":"I was stung by a yellowjacket.","tr":{"de":"Mich stach eine Wespe.","ru":"Меня ужалила оса."}}],"yearned":[{"id":302592,"text":"He yearned for her to come home.","tr":{"de":"Sehnsüchtig wartete er auf ihre Heimkehr.","ru":"Он с тоской ожидал её возвращения домой."}}],"yerevan":[{"id":1972972,"text":"Yerevan is the capital of Armenia.","tr":{"ru":"Ереван - это столица Армении.","uk":"Єреван — столиця Вірменії."}}],"yellowstone":[{"id":3668506,"text":"Yellowstone National Park is located in Wyoming.","tr":{"de":"Der Yellowstone-Nationalpark liegt in Wyoming.","ru":"Йеллоустоунский национальный парк находится в Вайоминге."}}],"yelped":[{"id":8455902,"text":"The dog yelped in pain.","tr":{"de":"Der Hund kläffte schmerzvoll."}}],"yellowish":[{"id":6956299,"text":"The building is yellowish gray.","tr":{"ru":"Здание желтовато-серого цвета."}}],"yearly":[{"id":4664302,"text":"This has become a yearly tradition.","tr":{"ru":"Это стало ежегодной традицией."}},{"id":3859335,"text":"It's worth ten times my yearly salary.","tr":{"ru":"Это стоит в десять раз больше моей годовой зарплаты."}},{"id":8382593,"text":"My yearly salary has been the same for the past three years.","tr":{"de":"Mein Jahresgehalt ist seit drei Jahren das gleiche."}},{"id":6569194,"text":"Tom's yearly salary has been the same for the past three years.","tr":{"de":"Toms Jahresgehalt ist seit drei Jahren unverändert."}}],"yearbook":[{"id":1092548,"text":"Tom wanted Mary to sign his yearbook.","tr":{"de":"Tom wollte, dass Mary in sein Jahrbuch schreibt."}},{"id":57537,"text":"This yearbook is illustrated with a lot of beautiful photographs.","tr":{"de":"Dieses Jahrbuch ist mit vielen schönen Fotografien bebildert."}}],"yemen":[{"id":3362001,"text":"Yemen is a country in the Middle East.","tr":{"ru":"Йемен — это страна на Ближнем Востоке."}},{"id":8904682,"text":"North Yemen became independent from the Ottoman Empire in 1918.","tr":{"uk":"Північний Ємен став незалежним від Османської імперії у 1918 році."}}]}