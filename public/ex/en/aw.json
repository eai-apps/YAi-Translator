ize.","tr":{"de":"Die Schule sprach Mary einen Preis zu."}}],"awaken":[{"id":57111,"text":"This book will awaken your imagination.","tr":{"de":"Dieses Buch wird deine Fantasie anregen.","ru":"Эта книга разбудит ваше воображение."}}],"awning":[{"id":8238767,"text":"The awning provides shelter from the rain.","tr":{"de":"Das Vordach schützt vor dem Regen.","ru":"Навес укрывает от дождя."}},{"id":709111,"text":"An awning broke his fall and saved his life.","tr":{"de":"Eine Markise unterbrach seinen Sturz und rettete sein Leben."}}],"awry":[{"id":1068362,"text":"Today, everything went awry from the start.","tr":{"de":"Heute ging von Anfang an alles schief.","ru":"Сегодня всё с самого начала пошло наперекосяк."}},{"id":10107991,"text":"Our plans have gone awry.","tr":{"ru":"Наши планы пошли наперекосяк."}}],"awkwardly":[{"id":8174291,"text":"Tom danced awkwardly.","tr":{"de":"Tom tanzte unbeholfen."}},{"id":3729830,"text":"Tom smiled awkwardly.","tr":{"ru":"Том неловко улыбнулся."}},{"id":10164683,"text":"Tom laughed awkwardly.","tr":{"de":"Tom lachte verlegen."}}],"await":[{"id":679876,"text":"I await your arrival.","tr":{"ru":"Я жду твоего приезда."}}],"awhile":[{"id":12273323,"text":"Won't you stay awhile?","tr":{"de":"Willst du nicht eine Weile bleiben?"}}],"awards":[{"id":6049322,"text":"Tom has won many awards.","tr":{"uk":"Том отримав багато нагород."}},{"id":4495859,"text":"Tom has received many awards.","tr":{"de":"Tom hat viele Auszeichnungen erhalten."}},{"id":8966487,"text":"Tom has won a number of awards.","tr":{"ru":"Том завоевал ряд наград."}},{"id":6222544,"text":"Tom has won a lot of awards this year.","tr":{"ru":"Том выиграл много наград в этом году."}},{"id":12379414,"text":"Where will the awards ceremony be taking place?","tr":{"ru":"Где будет проходить церемония награждения?"}}],"awaits":[{"id":10948281,"text":"A long weekend awaits us.","tr":{"de":"Auf uns wartet ein langes Wochenende."}},{"id":3729203,"text":"You're not prepared for what awaits you