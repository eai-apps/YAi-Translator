{"us":[{"id":2187193,"text":"Help us.","tr":{"de":"Hilf uns!","ru":"Помогите нам!","uk":"Допоможіть нам!"}},{"id":1745546,"text":"Join us.","tr":{"de":"Komm mit.","ru":"Присоединяйся к нам.","uk":"Приєднуйтесь до нас."}},{"id":1954274,"text":"Leave us.","tr":{"de":"Geh weg!","ru":"Оставь нас!","uk":"Залиши нас."}},{"id":1972627,"text":"Follow us.","tr":{"de":"Folge uns!","ru":"Иди за нами.","uk":"Слідуйте за нами."}},{"id":3334008,"text":"Let us in.","tr":{"de":"Lassen Sie uns rein.","ru":"Впустите нас.","uk":"Впусти нас."}}],"use":[{"id":1954278,"text":"Use this.","tr":{"de":"Nimm das hier!","ru":"Воспользуйся этим.","uk":"Скористайся цим."}},{"id":1356774,"text":"I use this.","tr":{"de":"Ich verwende das.","ru":"Я использую это.","uk":"Я користуюся цим."}},{"id":3330412,"text":"I'll use it.","tr":{"de":"Ich werde es verwenden.","ru":"Я воспользуюсь этим.","uk":"Я скористаюся цим."}},{"id":2253838,"text":"Use them all.","tr":{"de":"Nutze sie alle.","ru":"Используй их все.","uk":"Використовуй їх усі."}},{"id":1279106,"text":"I use Twitter.","tr":{"de":"Ich nutze Twitter.","ru":"Я пользуюсь Твиттером.","uk":"Я користуюся Твіттером."}}],"useless":[{"id":1359504,"text":"It's useless.","tr":{"de":"Das kann man in der Pfeife rauchen.","ru":"Это бесполезно.","uk":"Це все марно."}},{"id":2203559,"text":"We're useless.","tr":{"de":"Wir sind nutzlos.","ru":"Мы бесполезны.","uk":"Ми непридатні."}},{"id":2203561,"text":"Tom is useless.","tr":{"de":"Tom ist nutzlos.","ru":"Том бесполезный.","uk":"Від Тома немає користі."}},{"id":2203560,"text":"You're useless.","tr":{"de":"Du bist ein Nichtsnutz.","ru":"Ты бесполезен.","uk":"Від тебе жодної користі."}},{"id":1898085,"text":"This is useless.","tr":{"de":"Das ist unnütz.","ru":"Это бесполезно.","uk":"Це ні до чого непридатне."}}],"usually":[{"id":41158,"text":"I usually walk.","tr":{"de":"Normalerweise gehe ich zu Fuß.","ru":"Обычно я иду пешком.","uk":"Зазвичай я йду пішки."}},{"id":252359,"text":"I usually eat out.","tr":{"de":"Ich esse gewöhnlich auswärts.","ru":"Я обычно ем вне дома.","uk":"Я, як правило, їм не вдома."}},{"id":5958277,"text":"I usually eat alone.","tr":{"de":"Ich esse normalerweise allein.","ru":"Я обычно ем в одиночестве.","uk":"Як правило, я їм сам."}},{"id":931508,"text":"I usually go on foot.","tr":{"de":"Normalerweise gehe ich zu Fuß.","ru":"Обычно я иду пешком.","uk":"Зазвичай я йду пішки."}},{"id":41160,"text":"I usually get up late.","tr":{"de":"Ich stehe gewöhnlich spät auf.","ru":"Обычно я встаю поздно.","uk":"Я зазвичай встаю пізно."}}],"used":[{"id":2247945,"text":"I'm being used.","tr":{"de":"Ich werde ausgenutzt.","ru":"Меня используют.","uk":"Мене використовують."}},{"id":2549297,"text":"I'm used to that.","tr":{"de":"Das bin ich gewohnt.","ru":"Я к этому привыкла.","uk":"Я звик до цього."}},{"id":5858594,"text":"I used to be lazy.","tr":{"de":"Früher war ich faul.","ru":"Я раньше был ленивым.","uk":"Я колись був лінивий."}},{"id":2548963,"text":"Tom used to smoke.","tr":{"de":"Tom hat früher geraucht.","ru":"Раньше Том курил.","uk":"Том раніше курив."}},{"id":2548857,"text":"I used to hate Tom.","tr":{"de":"Früher hasste ich Tom.","ru":"Я раньше ненавидел Тома.","uk":"Я колись ненавидів Тома."}}],"using":[{"id":3044158,"text":"They're using you.","tr":{"de":"Sie benutzen dich.","ru":"Они используют тебя.","uk":"Вони використовують тебе."}},{"id":3007688,"text":"I'm using the computer.","tr":{"de":"Ich benutze den Computer.","ru":"Я пользуюсь компьютером.","uk":"Я користуюся комп'ютером."}},{"id":2659659,"text":"What browser are you using?","tr":{"de":"Welchen Browser benutzt du?","ru":"Какой браузер ты используешь?","uk":"Який браузер ти використовуєш?"}},{"id":3281801,"text":"I feel like Tom is using me.","tr":{"de":"Ich glaube, Tom nutzt mich aus.","ru":"У меня такое чувство, что Том меня использует.","uk":"У мене таке відчуття, що Том мене використовує."}},{"id":1135020,"text":"Which browser are you using?","tr":{"de":"Was für einen Browser benutzt du?","ru":"Какой браузер ты используешь?","uk":"Який браузер ти використовуєш?"}}],"useful":[{"id":2647121,"text":"Make yourself useful.","tr":{"de":"Mach dich nützlich.","ru":"Займись чем-нибудь полезным.","uk":"Зроби щось корисне."}},{"id":282367,"text":"A horse is very useful.","tr":{"de":"Ein Pferd ist sehr nützlich.","ru":"Лошадь очень полезное животное.","uk":"Коні дуже корисні."}},{"id":282391,"text":"Horses are useful animals.","tr":{"de":"Pferde sind nützliche Tiere.","ru":"Кони — полезные животные.","uk":"Коні — корисні тварини."}},{"id":26187,"text":"Speaking English is useful.","tr":{"de":"Es ist nützlich, Englisch zu sprechen.","ru":"Владение английским полезно.","uk":"Говорити англійською - корисно."}},{"id":440110,"text":"This website is very useful.","tr":{"de":"Diese Website ist sehr nützlich.","ru":"Этот сайт очень полезный.","uk":"Цей сайт дуже корисний."}}],"usual":[{"id":289065,"text":"He came late as usual.","tr":{"de":"Er verspätete sich wie immer.","ru":"Он, как всегда, опоздал.","uk":"Він, як завжди, запізнився."}},{"id":5018164,"text":"Tom is wrong as usual.","tr":{"de":"Tom liegt wie immer falsch.","ru":"Том, как всегда, ошибается.","uk":"Том, як завжи, помиляється."}},{"id":66101,"text":"She came late as usual.","tr":{"de":"Sie verspätete sich wie immer.","ru":"Она, по обыкновению, опоздала.","uk":"Вона прийшла пізно, як завжди."}},{"id":4012139,"text":"Tom came late as usual.","tr":{"de":"Tom verspätete sich wie immer.","ru":"Том, как всегда, опоздал.","uk":"Том, як завжди, спізнився."}},{"id":2546232,"text":"You're wrong, as usual.","tr":{"de":"Ihr habt wie immer unrecht.","ru":"Ты, как всегда, не прав.","uk":"Ти, як завжди, помиляєшся."}}],"usb":[{"id":1324756,"text":"I need a new USB cable.","tr":{"de":"Ich brauche ein neues USB-Kabel.","ru":"Мне нужен новый USB-кабель.","uk":"Мені потрібний новий USB-кабель."}},{"id":954537,"text":"What does USB stand for?","tr":{"de":"Was bedeutet USB?","uk":"Що означає USB?"}},{"id":1093756,"text":"Tom has a drawer full of USB cables.","tr":{"ru":"У Тома есть ящик в комоде, полный USB-кабелей."}}],"uses":[{"id":1937701,"text":"No one uses that word anymore.","tr":{"de":"Das Wort benutzt keiner mehr.","ru":"Никто больше не использует это слово.","uk":"Ніхто більше не вживає цього слова."}},{"id":270260,"text":"Man is the only animal that uses fire.","tr":{"de":"Der Mensch ist das einzige Tier, das Feuer benutzt.","ru":"Человек — единственное животное, которое использует огонь.","uk":"Людина - єдина тварина, що використовує вогонь."}},{"id":4502753,"text":"Who else uses it?","tr":{"de":"Wer benutzt es sonst noch?","ru":"Кто ещё им пользуется?"}},{"id":2025425,"text":"It uses solar power.","tr":{"de":"Es läuft mit Sonnenenergie.","ru":"Он работает на солнечной энергии."}},{"id":250678,"text":"My brother uses this bike.","tr":{"ru":"Мой брат пользуется этим велосипедом.","uk":"Мій брат користується цим велосипедом."}}],"username":[{"id":6856845,"text":"Tom typed his username and password.","tr":{"de":"Tom gab Benutzernamen und Kennwort ein.","ru":"Том ввёл свой логин и пароль.","uk":"Том надрукував своє ім'я користувача та пароль."}},{"id":5432681,"text":"What's your username?","tr":{"de":"Wie lautet dein Benutzername?","ru":"Какой у тебя логин?"}},{"id":5767529,"text":"I forgot my username.","tr":{"ru":"Я забыл свой логин.","uk":"Я забув своє ім'я користувача."}},{"id":1994195,"text":"What's your Skype username?","tr":{"de":"Wie ist denn dein Skype-Name?","ru":"Какой у тебя логин в Skype?"}},{"id":2721268,"text":"I should've chosen a shorter username.","tr":{"de":"Ich hätte einen kürzeren Benutzernamen wählen sollen.","ru":"Надо было мне выбрать ник покороче."}}],"ushered":[{"id":258307,"text":"I was ushered to my seat.","tr":{"de":"Ich wurde an meinen Platz geführt.","ru":"Меня проводили до моего места."}},{"id":21658,"text":"The revolution ushered in a new era.","tr":{"ru":"Революция открыла новую эру."}}],"ussr":[{"id":72160,"text":"What does USSR stand for?","tr":{"ru":"Что означает \"СССР\"?","uk":"Що означає СРСР?"}},{"id":5269851,"text":"Before WWII, the border between Finland and the USSR was near Leningrad.","tr":{"de":"Vor dem Zweiten Weltkrieg lag die finnisch-sowjetische Grenze nahe Leningrad.","ru":"До Второй мировой войны граница между Финляндией и СССР проходила возле Ленинграда."}}],"usable":[{"id":68468,"text":"Is that machine still usable?","tr":{"de":"Ist diese Maschine noch zu gebrauchen?","uk":"Ця машина ще працює?"}},{"id":49673,"text":"His idea wasn't usable.","tr":{"ru":"Его идея была неприменимой."}}],"usa":[{"id":270494,"text":"They elected him President of the USA.","tr":{"de":"Er wurde zum Präsidenten der Vereinigten Staaten von Amerika gewählt.","ru":"Его выбрали президентом США."}},{"id":1463515,"text":"Japan does a lot of trade with the USA.","tr":{"de":"Japan treibt viel Handel mit den Vereinigten Staaten.","ru":"Япония активно торгует с США."}},{"id":262612,"text":"Our teacher is going to the USA next month.","tr":{"de":"Unser Lehrer fliegt nächsten Monat in die Vereinigten Staaten.","ru":"Наш учитель в следующем месяце едет в США."}},{"id":241321,"text":"The national flag of the USA is called the Stars and Stripes.","tr":{"de":"Die Nationalflagge der Vereinigten Staaten wird Sternenbanner genannt.","ru":"Государственный флаг США называют звёздно-полосатым."}},{"id":497117,"text":"Our teacher will go to the USA next month.","tr":{"de":"Unser Lehrer fliegt nächsten Monat in die Vereinigten Staaten."}}],"user":[{"id":8842318,"text":"I need the user manual.","tr":{"ru":"Мне нужно руководство по эксплуатации."}},{"id":4240388,"text":"I don't need the user manual.","tr":{"ru":"Мне не нужна инструкция."}}],"usernames":[{"id":4555087,"text":"Can usernames be changed?","tr":{"ru":"Могут ли ники меняться?"}}],"users":[{"id":1440840,"text":"Our web site attracts a lot of users.","tr":{"ru":"Наш веб-сайт привлекает много пользователей."}},{"id":30841,"text":"Refer to the Users' Guide if you have any problems.","tr":{"de":"Konsultieren Sie das Benutzerhandbuch, falls Sie Probleme haben."}}]}