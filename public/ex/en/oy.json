{"oysters":[{"id":15953,"text":"Can you eat raw oysters?","tr":{"de":"Kannst du rohe Austern essen?","ru":"Вы можете есть сырых устриц?","uk":"Можна їсти сирі устриці?"}},{"id":6670130,"text":"I like oysters.","tr":{"de":"Ich mag Austern.","ru":"Я люблю устрицы."}},{"id":1655349,"text":"Do you like oysters?","tr":{"de":"Magst du Austern?","ru":"Ты любишь устрицы?"}},{"id":4133482,"text":"I don't eat oysters.","tr":{"de":"Ich esse keine Austern.","ru":"Я не ем устриц."}},{"id":4133483,"text":"I don't like oysters.","tr":{"de":"Ich mag keine Austern.","ru":"Я не люблю устрицы."}}]}