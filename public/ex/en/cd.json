{"cd":[{"id":25536,"text":"It's my CD.","tr":{"de":"Das ist meine CD.","ru":"Это мой компакт-диск.","uk":"Це мій компакт-диск."}},{"id":1243622,"text":"That's my CD.","tr":{"de":"Das ist meine CD.","ru":"Это мой компакт-диск.","uk":"Це мій компакт-диск."}},{"id":1005358,"text":"This CD is my son's.","tr":{"de":"Diese CD gehört meinem Sohn.","ru":"Это диск моего сына.","uk":"Це компакт мого сина."}},{"id":1243624,"text":"That's my CD, isn't it?","tr":{"de":"Das ist meine CD, nicht wahr?","ru":"Это же мой сидюк, да?","uk":"Це ж мій диск?"}},{"id":61387,"text":"This CD belongs to her.","tr":{"de":"Das ist ihre CD.","ru":"Это её компакт-диск.","uk":"Цей компакт-диск належить їй."}}],"cds":[{"id":425894,"text":"These are my CDs.","tr":{"de":"Das sind meine CDs.","ru":"Это мои компакт-диски.","uk":"Це мої диски."}},{"id":67003,"text":"Those are my CDs.","tr":{"de":"Das sind meine CDs.","ru":"Это мои компакт-диски.","uk":"Це мої диски."}},{"id":252842,"text":"I have four times more CDs than you do.","tr":{"de":"Ich habe viermal so viele CDs wie du.","ru":"У меня в четыре раза больше CD, чем у тебя.","uk":"У мене в чотири рази більше компакт-дисків, ніж у тебе."}},{"id":247711,"text":"We buy CDs.","tr":{"de":"Wir kaufen CDs.","ru":"Мы покупаем компакт-диски."}},{"id":24438,"text":"Do you have any CDs?","tr":{"de":"Haben Sie Kompaktdisks?","uk":"У тебе є якісь диски?"}}]}