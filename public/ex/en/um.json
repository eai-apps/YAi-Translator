{"umbrella":[{"id":3360548,"text":"Grab an umbrella.","tr":{"de":"Nimm dir einen Schirm!","ru":"Захвати зонт.","uk":"Візьми парасольку."}},{"id":2293570,"text":"It's my umbrella.","tr":{"de":"Es ist mein Schirm.","ru":"Это мой зонт.","uk":"Це моя парасолька."}},{"id":10687211,"text":"Take an umbrella.","tr":{"de":"Nehmt einen Regenschirm mit.","ru":"Возьмите зонтик.","uk":"Візьми парасольку."}},{"id":2293571,"text":"This is my umbrella.","tr":{"de":"Das hier ist mein Schirm.","ru":"Это мой зонтик.","uk":"Це моя парасолька."}},{"id":4667089,"text":"Tom has my umbrella.","tr":{"de":"Tom hat meinen Regenschirm.","ru":"У Тома мой зонтик.","uk":"У Тома моя парасолька."}}],"umbrellas":[{"id":245014,"text":"Umbrellas sell well.","tr":{"de":"Regenschirme verkaufen sich gut.","ru":"Зонтики хорошо продаются.","uk":"Парасольки добре продаються."}},{"id":4493704,"text":"No one had umbrellas.","tr":{"de":"Niemand hat einen Regenschutz dabei.","ru":"Ни у кого не было зонта.","uk":"Ніхто не мав парасольки."}},{"id":2631135,"text":"Where are our umbrellas?","tr":{"de":"Wo sind unsere Regenschirme?","ru":"Где наши зонты?","uk":"Де наші парасольки?"}},{"id":1460033,"text":"Women like colorful umbrellas.","tr":{"de":"Frauen mögen farbenfrohe Schirme.","ru":"Женщинам нравятся разноцветные зонтики.","uk":"Жінкам подобаються барвисті парасольки."}},{"id":4609565,"text":"I sell umbrellas.","tr":{"ru":"Я продаю зонты.","uk":"Я продаю парасольки."}}],"umeshu":[{"id":10299357,"text":"Umeshu is Japanese plum wine.","tr":{"de":"Umeshu ist japanischer Pflaumenwein.","ru":"Умэсю - это японское сливовое вино."}}],"umpire":[{"id":6687566,"text":"It isn't easy to be an umpire.","tr":{"de":"Schiedsrichter haben es nicht leicht."}},{"id":7198976,"text":"It's not easy to be an umpire.","tr":{"de":"Schiedsrichter haben es nicht leicht."}},{"id":254396,"text":"I was asked to umpire the game.","tr":{"uk":"Мене попросили бути суддєю під час гри."}}],"umpteen":[{"id":8933138,"text":"It won't work. I've already tried it umpteen times.","tr":{"de":"Das geht nicht. Ich habe es schon x-mal versucht."}}]}