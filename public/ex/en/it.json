{"it":[{"id":6049386,"text":"Do it.","tr":{"de":"Mache es!","ru":"Сделай это.","uk":"Зроби це."}},{"id":4768107,"text":"Eat it.","tr":{"de":"Iss es.","ru":"Съешь это.","uk":"З'їж це."}},{"id":320484,"text":"Got it!","tr":{"de":"Verstanden!","ru":"Понял!","uk":"Я зрозуміла."}},{"id":455353,"text":"Got it?","tr":{"de":"Kapiert?","ru":"Понятно?","uk":"Зрозумів?"}},{"id":37902,"text":"Beat it.","tr":{"de":"Geh weg!","ru":"Иди отсюда.","uk":"Іди геть."}}],"itchy":[{"id":318193,"text":"My nose is itchy.","tr":{"de":"Mir juckt die Nase.","ru":"У меня нос зудит.","uk":"У мене чешеться ніс."}},{"id":323693,"text":"My eyes feel itchy.","tr":{"de":"Meine Augen krabbeln.","ru":"У меня чешутся глаза."}},{"id":280183,"text":"My scalp is very itchy.","tr":{"de":"Meine Kopfhaut juckt.","ru":"Кожа у меня на голове очень чешется."}},{"id":3710357,"text":"I feel itchy everywhere.","tr":{"de":"Es juckt mich überall.","ru":"У меня всё чешется."}},{"id":9264997,"text":"My scalp is itchy.","tr":{"de":"Mir juckt die Kopfhaut."}}],"italy":[{"id":29415,"text":"Rome is in Italy.","tr":{"de":"Rom ist in Italien.","ru":"Рим расположен в Италии.","uk":"Рим знаходиться в Італії."}},{"id":2113411,"text":"Italy isn't Greece.","tr":{"de":"Italien ist nicht Griechenland.","ru":"Италия не Греция.","uk":"Італія не Греція."}},{"id":34180,"text":"France borders Italy.","tr":{"de":"Frankreich grenzt an Italien.","ru":"Франция граничит с Италией.","uk":"Франція межує з Італією."}},{"id":690740,"text":"Italy is a peninsula.","tr":{"de":"Italien ist eine Halbinsel.","ru":"Италия - полуостров.","uk":"Італія — це півострів."}},{"id":66434,"text":"The capital of Italy is Rome.","tr":{"de":"Die Hauptstadt von Italien ist Rom.","ru":"Столица Италии - Рим.","uk":"Столиця Італії - Рим."}}],"italian":[{"id":287970,"text":"He likes Italian food.","tr":{"de":"Er mag italienisches Essen.","ru":"Ему нравится итальянская кухня.","uk":"Йому подобається італійська кухня."}},{"id":2734282,"text":"Tom likes Italian food.","t