{"ahead":[{"id":38590,"text":"Go ahead!","tr":{"de":"Nur zu!","ru":"Давай!","uk":"Гайда!"}},{"id":38546,"text":"Go ahead.","tr":{"de":"Mach weiter!","ru":"Давай!","uk":"Давай!"}},{"id":2111613,"text":"Look ahead.","tr":{"de":"Schau nach vorne.","ru":"Посмотри вперёд.","uk":"Подивись вперед."}},{"id":238679,"text":"OK. Go ahead.","tr":{"de":"Gut, mach weiter!","ru":"Хорошо, давай.","uk":"Добре, давайте."}},{"id":269559,"text":"Go straight ahead.","tr":{"de":"Geh geradeaus.","ru":"Иди прямо.","uk":"Іди прямо."}}],"ah":[{"id":1283282,"text":"Ah, that's much better.","tr":{"de":"Ah, das ist viel besser!","ru":"О, это намного лучше."}},{"id":73991,"text":"\"Ah\" is an interjection.","tr":{"de":"„Ah“ ist eine Interjektion.","ru":"\"Ах\" - это междометие."}},{"id":10904833,"text":"Ah, I understand.","tr":{"uk":"А, розумію."}},{"id":9008260,"text":"Ah, I see what you mean.","tr":{"ru":"А, я понял, что ты имеешь в виду."}},{"id":1296806,"text":"Ah! What a beautiful flower!","tr":{"ru":"Ах! Какой красивый цветок!"}}]}